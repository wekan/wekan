template(name="searchSidebar")
  form.js-search-term-form
    input(type="text" name="searchTerm" placeholder="{{_ 'search-example'}}" autofocus dir="auto")
  //- #2171: Enter again steps to the next card found (Shift+Enter or the
    arrow to the previous), and the board scrolls to it and highlights it -
    as a browser's find does, on the board itself.
  if matchCount
    p.quiet.search-step
      a.js-search-step(href="#" data-direction="-1" title="{{_ 'previous'}}" aria-label="{{_ 'previous'}}")
        i.fa.fa-chevron-left
      | &nbsp;{{_ 'search-step' stepNumber matchCount}}&nbsp;
      a.js-search-step(href="#" data-direction="1" title="{{_ 'next'}}" aria-label="{{_ 'next'}}")
        i.fa.fa-chevron-right
  .list-body
    .minilists.clearfix.js-minilists
      hr
      | {{_ 'lists' }}
      each (lists)
        a.minilist-wrapper.js-minilist(href=originRelativeUrl data-list-id="{{_id}}")
          +minilist(this)
    .minicards.clearfix.js-minicards
      hr
      | {{_ 'cards' }}
      each (cards)
        a.minicard-wrapper.js-minicard(href=originRelativeUrl data-card-id="{{_id}}")
          +minicard(this)
