template(name="sidebar")
  .board-sidebar.sidebar(class="{{#if isOpen}}is-open{{/if}} {{#unless isVerticalScrollbars}}no-scrollbars{{/unless}}")
    //- Drag the sidebar's LEFT edge to resize its width (desktop only; hidden on
      mobile where the sidebar is full width). Saved to the user profile (or
      localStorage for anonymous users on a public board).
    .sidebar-resize-handle.js-sidebar-resize-handle.nodragscroll(title="{{_ 'drag-to-resize-sidebar'}}")
    //a.sidebar-tongue.js-toggle-sidebar(
    //
      class="{{#if isTongueHidden}}is-hidden{{/if}}",
    //
      title="{{showTongueTitle}}")
    //
      i.fa.fa-navicon
    .sidebar-actions
      .sidebar-shortcuts
        a.sidebar-btn.js-shortcuts(title="{{_ 'keyboard-shortcuts' }}")
          i.fa.fa-keyboard-o
          span {{_ 'keyboard-shortcuts' }}
        a.sidebar-btn.js-keyboard-shortcuts-toggle(
          title="{{#if isKeyboardShortcuts}}{{_ 'keyboard-shortcuts-enabled'}}{{else}}{{_ 'keyboard-shortcuts-disabled'}}{{/if}}")
          i.fa(class="{{#if isKeyboardShortcuts}}fa-check{{else}}fa-ban{{/if}}")
      if isAccessibilityEnabled
        a.sidebar-accessibility
          i.fa.fa-universal-access
          span {{_ 'accessibility'}}
      a.sidebar-xmark.js-close-sidebar(aria-label="{{_ 'close'}}") &#10005;
    .sidebar-content.js-board-sidebar-content
      //a.hide-btn.js-hide-sidebar
      //
        i.fa.fa-navicon
      unless isDefaultView
        h2
          a.fa.fa-arrow-left.js-back-home(aria-label="{{_ 'go-back'}}")
          = getViewTitle
      if isOpen
        +Template.dynamic(template=getViewTemplate)

template(name='homeSidebar')
  +membersWidget
  hr
  +labelsWidget
  hr
  //- "Hide minicard label text" was here, under the People/Organizations tabs.
    It is a setting about the MINICARD, so it is in the minicard's own menu now:
    Minicard menu / Show on Minicard. See showOnMinicardPopup below.
  if currentUser
    ul#cards.vertical-scrollbars-toggle
      a.flex.js-vertical-scrollbars-toggle(title="{{_ 'enable-vertical-scrollbars'}}")
        i.fa(class="{{#if isVerticalScrollbars}}fa-check{{else}}fa-square-o{{/if}}")
        span {{_ 'enable-vertical-scrollbars'}}
  ul#cards.show-week-of-year-toggle
    a.flex.js-show-week-of-year-toggle(title="{{_ 'show-week-of-year'}}")
      i.fa(class="{{#if isShowWeekOfYear}}fa-check{{else}}fa-square-o{{/if}}")
      span {{_ 'show-week-of-year'}}
  hr
  if currentUser.isBoardAdmin
    //- A caret in front of the heading, like every collapsible section of an
      opened card: clicking the heading shows the activities under it, clicking
      it again hides them. The eye and the words "Show activities" beside it
      said the same thing a second time, which is one control too many for one
      setting. client/lib/sectionCaret.js
    h3.activity-title.js-toggle-show-activities(role="button" tabindex="0" title="{{_ 'activities'}}")
      i.fa(class="{{activitiesCaret}}")
      i.fa.fa-comment-o
      | {{_ 'activities'}}
    +activities(mode="board")

template(name="membersWidget")
  unless currentUser.isCommentOnly
    unless currentUser.isWorker
      h3
        a.board-header-btn.js-open-board-menu(title="{{_ 'boardMenuPopup-title'}}")
          i.fa.fa-cog
          | {{_ 'boardMenuPopup-title'}}
  hr
  //- The heading is the button, with a caret in front of it, like every
    collapsible section of an opened card: folding Members hides the People /
    Organizations / Teams / Domains tabs and the avatars in them.
    client/lib/foldState.js
  h3.js-toggle-fold(data-fold="members" role="button" tabindex="0")
    i.fa(class="{{foldCaret 'members'}}")
    i.fa.fa-users
    | {{_ 'members'}}
  if isFoldOpen 'members'
    +basicTabs(tabs=tabs)
      +tabContent(slug="people")
        unless currentUser.isWorker
          p.quiet
        .board-widget-content
          if currentBoard.isAnyTemplateBoard
            +userAvatar(userId=currentBoard.userId showStatus=true)
            .clearfix
          else
            each currentBoard.membersForSidebar
              +userAvatar(userId=this.userId showStatus=true)
            //- Sandstorm grains can contain multiple boards. Their users already
              exist in this grain after first visiting it, so use WeKan's normal,
              permission-checked board-member picker. The former Powerbox button
              depended on capnp.node (unavailable with the bundled Node 24) and its
              claimed identity was never attached to the selected board. #2405
            if currentUser.canInviteToBoard
              a.member.add-member.js-manage-board-members(title="{{_ 'add-members'}}")
                i.fa.fa-plus
            .clearfix
            if isInvited
              hr
              p
                i.fa.fa-exclamation-triangle
                | {{_ 'just-invited'}}
              button.js-member-invite-accept.primary {{_ 'accept'}}
              button.js-member-invite-decline {{_ 'decline'}}
      +tabContent(slug='organizations')
        unless currentUser.isWorker
          p.quiet
        .board-widget-content
          +boardOrgGeneral
          .clearfix
      +tabContent(slug="teams")
        unless currentUser.isWorker
          p.quiet
        .board-widget-content
          +boardTeamGeneral
          .clearfix
      +tabContent(slug="domains")
        unless currentUser.isWorker
          p.quiet
        .board-widget-content
          +boardDomainGeneral
          .clearfix

template(name="boardOrgGeneral")
  each org in currentBoard.activeOrgs
    +boardOrgRow(orgId=org.orgId)
  if currentUser.isBoardAdmin
    a.member.orgOrTeamMember.add-member.js-manage-board-addOrg(title="{{_ 'add-members'}}")
      i.fa.fa-plus

template(name="boardTeamGeneral")
  each currentBoard.activeTeams
    +boardTeamRow(teamId=this.teamId)
  if currentUser.isBoardAdmin
    a.member.orgOrTeamMember.add-member.js-manage-board-addTeam(title="{{_ 'add-members'}}")
      i.fa.fa-plus

template(name="boardDomainGeneral")
  each currentBoard.activeDomains
    +boardDomainRow(domain=this.domain)
  if currentUser.isBoardAdmin
    a.member.orgOrTeamMember.add-member.js-manage-board-addDomain(title="{{_ 'add-domain'}}")
      i.fa.fa-plus

template(name="boardDomainRow")
  a.member.orgOrTeamMember.js-manage-board-removeDomain(title="{{domain}}" data-domain="{{domain}}")
    svg.avatar.avatar-initials(viewBox="0 0 {{domainViewPortWidth}} 15")
      text(x="50%" y="11" text-anchor="middle" dominant-baseline="middle" font-size="16")= domain

template(name="boardChangeColorPopup")
  //- docs/Theme/Theme.md: category + theme dropdowns with custom color wheels for
    the flat/clear categories, shared with Member Settings / Change Color.
  +themeColorPicker(scope="board")

//- Uploading a background image. It is its own template because it belongs
  with the URL field rather than with the list of images already uploaded:
  both put a picture behind the board, one from the web and one from this
  machine, so they are the two halves of one question and are read together.
  The grid below is what you have; this is how you add to it.
template(name="boardBackgroundUpload")
  .board-background-upload
    input.js-bg-upload-input.hide(type="file" name="file" accept="image/*")
    a.primary.wide.js-bg-upload-button
      i.fa.fa-plus
      = ' '
      | {{_ 'upload-background'}}
    if uploading.get
      +spinner
    if error.get
      .warning {{_ error.get}}

//- The pictures uploaded to this board, with their NAMES: an upload that shows
  nothing afterwards is indistinguishable from one that failed, which is what
  uploading looked like while this list lived behind a menu entry of its own.
  It is drawn inside Change Background Image, under the upload that adds to it,
  and that entry - "Board backgrounds" - is gone with the popup it opened.
template(name="boardBackgroundList")
  .board-backgrounds-manage
    .board-backgrounds-grid.clearfix
      each backgrounds
        //- The PICTURE is the button: clicking a thumbnail, or its name, puts
          that one behind the board. It used to be a small check icon in the row
          below, which is a 14px target beside an 80px picture of the thing it
          applies - so the obvious click did nothing. The row keeps what the
          picture cannot say: download it, or delete it.
        .board-bg-item(class="{{#if isActiveBackground}}is-active{{/if}}")
          .board-bg-thumb.js-set-board-background(style="background-image: url('{{link}}');" title="{{_ 'set-as-active'}}")
            if isActiveBackground
              i.fa.fa-check.board-bg-active-check
          .board-bg-name.js-set-board-background(title="{{_ 'set-as-active'}}")= name
          .board-bg-actions
            a.js-download-board-background(href="{{link}}?download=true" download="{{name}}" title="{{_ 'download'}}")
              i.fa.fa-arrow-down
            a.js-delete-board-background(title="{{_ 'delete'}}")
              i.fa.fa-trash-o

template(name="deleteBoardBackgroundPopup")
  p {{_ 'board-background-delete-pop'}}
  button.js-confirm.negate.full(type="submit")
    i.fa.fa-trash-o
    | {{_ 'delete'}}

template(name="boardChangeBackgroundImagePopup")
  form
    label
      | {{_ 'board-background-image-url'}}
      input.js-board-background-image-url(type="text" value="{{backgroundImageURL}}" autofocus)
    //- Save and Unset side by side, in that order: they are the two things to
      do with the address above them, and Unset was five blank lines below the
      Save it belongs beside.
    .buttonsContainer.board-background-image-buttons
      input.primary(type="submit" value="{{_ 'save'}}")
      button.js-remove-background-image.negate.card-details-red(type="button") {{_ 'unset-color'}}
    hr
    //- ...and the same question answered from this machine instead of from a
      URL, with what has been uploaded to this board under it - so an upload is
      seen to have arrived, and can be applied, without going to another popup
      to find out.
    +boardBackgroundUpload
  +boardBackgroundList

template(name="boardInfoOnMyBoardsPopup")
  form.board-info-on-my-boards
    h3 {{_ 'show-at-all-boards-page'}}
    unless currentSetting.hideCardCounterList
      div.check-div
        a.flex.js-field-has-cardcounterlist(class="{{#if allowsCardCounterList}}is-checked{{/if}}")
          i.fa(class="{{#if allowsCardCounterList}}fa-check{{else}}fa-square-o{{/if}}")
          span
            i.fa.fa-sign-in
            | {{_ 'show-card-counter-per-list'}}
    div.check-div
      a.flex.js-field-has-cardaging(class="{{#if cardAging}}is-checked{{/if}}")
        i.fa(class="{{#if cardAging}}fa-check{{else}}fa-square-o{{/if}}")
        span
          i.fa.fa-clock-o
          | {{_ 'card-aging'}}
      if cardAging
        div.card-aging-days
          span {{_ 'card-aging-days'}}
          input.js-card-aging-days(type="number" min="1" value="{{cardAgingDays1}}" title="{{_ 'card-aging-tier1'}}")
          input.js-card-aging-days(type="number" min="1" value="{{cardAgingDays2}}" title="{{_ 'card-aging-tier2'}}")
          input.js-card-aging-days(type="number" min="1" value="{{cardAgingDays3}}" title="{{_ 'card-aging-tier3'}}")
    unless currentSetting.hideBoardMemberList
      div.check-div
        a.flex.js-field-has-boardmemberlist(class="{{#if allowsBoardMemberList}}is-checked{{/if}}")
          i.fa(class="{{#if allowsBoardMemberList}}fa-check{{else}}fa-square-o{{/if}}")
          span
            i.fa.fa-hourglass
            | {{_ 'show-board_members-avatar'}}
    div.check-div
      a.flex.js-field-has-personal-list-width(title="{{_ 'personal-list-width-description'}}" class="{{#if allowsPersonalListWidth}}is-checked{{/if}}")
        i.fa(class="{{#if allowsPersonalListWidth}}fa-check{{else}}fa-square-o{{/if}}")
        span
          i.fa.fa-arrows-h
          | {{_ 'personal-list-width'}}

//- The Card Settings, from the CARD's own menu: the same popup with the
  "Show on Minicard" column hidden, because the card menu is opened while
  looking at a card. One list of settings, one set of handlers, one place a new
  setting has to be added. client/components/cards/cardDetails.jade
template(name="showOnCardPopup")
  +boardCardSettingsPopup(side="card")

//- ...and from the MINICARD's menu, the other column.
//-
//- "Labels text" - the one PERSONAL setting in that column - is a row of the
//- same table, under Labels, so it is read where the rest of the minicard's
//- settings are. It is offered to everybody, because it is stored on the user's
//- profile (or in this browser when there is nobody logged in) and changes
//- nothing for anyone else; a user who is not a board admin sees that row
//- alone. client/lib/minicardLabelText.js
template(name="showOnMinicardPopup")
  if currentUser.isBoardAdmin
    +boardCardSettingsPopup(side="minicard" card=this)
  else
    +boardCardSettingsPopup(side="minicard" personalOnly=true card=this)

//- No heading row. It used to name the columns of a ROW - "Show on Card" over
  the checkbox and "Description" over the name - which is what they label, but
  not what they LOOK like: the rows flow into as many columns as the window
  fits, so two headings sat above the first of three or four columns and read as
  if they named those. The first of them also repeated the popup's own title,
  which is "Show on Card" or "Show on Minicard" already. A row is a checkbox and
  the name of a setting, and needs neither.
template(name="boardCardSettingsPopup")
  form.board-card-settings(class=settingsSideClass)
    //- "List title": the name of the LIST this card is in, on its minicard.
      A per-CARD setting, unchecked by default, and the first row of this
      column because it is about the card as a whole rather than one of its
      fields. It was a line in the card's menu reading "Show list on minicard";
      it is a checkbox among the other things a minicard can show, which is
      where somebody looking for it would look. Only for a user who may change
      the card - the same permission the menu entry had.
      The board-wide "Show lists" row further down turns it on for EVERY card;
      this one is for a single card that needs it, which is what it is for on a
      swimlane, in search results and in My Cards, where a card is read away
      from the column it lives in. client/components/cards/minicard.jade
    if canModifyCard
      .card-settings-row.card-settings-row-personal
        .card-settings-column
        .card-settings-column
          a.flex.js-toggle-show-list-on-minicard(title="{{_ 'list'}} {{_ 'title'}}" class="{{#if showsListOnMinicard}}is-checked{{/if}}")
            i.fa(class="{{#if showsListOnMinicard}}fa-check{{else}}fa-square-o{{/if}}")
        .card-settings-column
          span
            i.fa.fa-list
            | {{_ 'list'}}
            | {{_ 'title'}}
    .card-settings-row
      .card-settings-column
        a.flex.js-field-has-receiveddate(title="{{_ 'card-received'}}" class="{{#if allowsReceivedDate}}is-checked{{/if}}")
          i.fa(class="{{#if allowsReceivedDate}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        a.flex.js-field-has-receiveddate-on-minicard(title="{{_ 'card-received'}}" class="{{#if allowsReceivedDateOnMinicard}}is-checked{{/if}}")
          i.fa(class="{{#if allowsReceivedDateOnMinicard}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        span
          i.fa.fa-sign-in
          | {{_ 'card-received'}}
    .card-settings-row
      .card-settings-column
        a.flex.js-field-has-startdate(title="{{_ 'card-start'}}" class="{{#if allowsStartDate}}is-checked{{/if}}")
          i.fa(class="{{#if allowsStartDate}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        a.flex.js-field-has-startdate-on-minicard(title="{{_ 'card-start'}}" class="{{#if allowsStartDateOnMinicard}}is-checked{{/if}}")
          i.fa(class="{{#if allowsStartDateOnMinicard}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        span
          i.fa.fa-hourglass
          | {{_ 'card-start'}}
    .card-settings-row
      .card-settings-column
        a.flex.js-field-has-duedate(title="{{_ 'card-due'}}" class="{{#if allowsDueDate}}is-checked{{/if}}")
          i.fa(class="{{#if allowsDueDate}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        a.flex.js-field-has-duedate-on-minicard(title="{{_ 'card-due'}}" class="{{#if allowsDueDateOnMinicard}}is-checked{{/if}}")
          i.fa(class="{{#if allowsDueDateOnMinicard}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        span
          i.fa.fa-sign-in
          | {{_ 'card-due'}}
    .card-settings-row
      .card-settings-column
        a.flex.js-field-has-enddate(title="{{_ 'card-end'}}" class="{{#if allowsEndDate}}is-checked{{/if}}")
          i.fa(class="{{#if allowsEndDate}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        a.flex.js-field-has-enddate-on-minicard(title="{{_ 'card-end'}}" class="{{#if allowsEndDateOnMinicard}}is-checked{{/if}}")
          i.fa(class="{{#if allowsEndDateOnMinicard}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        span
          i.fa.fa-clock-o
          | {{_ 'card-end'}}
    .card-settings-row
      .card-settings-column
        a.flex.js-field-has-duecomplete(title="{{_ 'card-mark-complete'}}" class="{{#if allowsDueComplete}}is-checked{{/if}}")
          i.fa(class="{{#if allowsDueComplete}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        a.flex.js-field-has-duecomplete-on-minicard(title="{{_ 'card-mark-complete'}}" class="{{#if allowsDueCompleteOnMinicard}}is-checked{{/if}}")
          i.fa(class="{{#if allowsDueCompleteOnMinicard}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        span
          i.fa.fa-check-square-o
          | {{_ 'card-mark-complete'}}
    .card-settings-row
      .card-settings-column
        a.flex.js-field-has-members(title="{{_ 'members'}}" class="{{#if allowsMembers}}is-checked{{/if}}")
          i.fa(class="{{#if allowsMembers}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        a.flex.js-field-has-members-on-minicard(title="{{_ 'members'}}" class="{{#if allowsMembersOnMinicard}}is-checked{{/if}}")
          i.fa(class="{{#if allowsMembersOnMinicard}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        span
          i.fa.fa-users
          | {{_ 'members'}}
    .card-settings-row
      .card-settings-column
        a.flex.js-field-has-creator(title="{{_ 'creator'}}" class="{{#if allowsCreator}}is-checked{{/if}}")
          i.fa(class="{{#if allowsCreator}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        a.flex.js-field-has-creator-on-minicard(title="{{_ 'creator'}}" class="{{#if allowsCreatorOnMinicard}}is-checked{{/if}}")
          i.fa(class="{{#if allowsCreatorOnMinicard}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        span
          i.fa.fa-user
          | {{_ 'creator'}}
    .card-settings-row
      .card-settings-column
        a.flex.js-field-has-assignee(title="{{_ 'assignee'}}" class="{{#if allowsAssignee}}is-checked{{/if}}")
          i.fa(class="{{#if allowsAssignee}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        a.flex.js-field-has-assignee-on-minicard(title="{{_ 'assignee'}}" class="{{#if allowsAssigneeOnMinicard}}is-checked{{/if}}")
          i.fa(class="{{#if allowsAssigneeOnMinicard}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        span
          i.fa.fa-user
          | {{_ 'assignee'}}
    .card-settings-row
      .card-settings-column
        a.flex.js-field-has-assigned-by(title="{{_ 'assigned-by'}}" class="{{#if allowsAssignedBy}}is-checked{{/if}}")
          i.fa(class="{{#if allowsAssignedBy}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        a.flex.js-field-has-assigned-by-on-minicard(title="{{_ 'assigned-by'}}" class="{{#if allowsAssignedByOnMinicard}}is-checked{{/if}}")
          i.fa(class="{{#if allowsAssignedByOnMinicard}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        span
          i.fa.fa-shopping-cart
          | {{_ 'assigned-by'}}
    .card-settings-row
      .card-settings-column
        a.flex.js-field-has-requested-by(title="{{_ 'requested-by'}}" class="{{#if allowsRequestedBy}}is-checked{{/if}}")
          i.fa(class="{{#if allowsRequestedBy}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        a.flex.js-field-has-requested-by-on-minicard(title="{{_ 'requested-by'}}" class="{{#if allowsRequestedByOnMinicard}}is-checked{{/if}}")
          i.fa(class="{{#if allowsRequestedByOnMinicard}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        span
          i.fa.fa-user
          i.fa.fa-plus
          | {{_ 'requested-by'}}
    .card-settings-row
      .card-settings-column
        a.flex.js-field-has-card-sorting-by-number(title="{{_ 'card-sorting-by-number'}}" class="{{#if allowsCardSortingByNumber}}is-checked{{/if}}")
          i.fa(class="{{#if allowsCardSortingByNumber}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        a.flex.js-field-has-card-sorting-by-number-on-minicard(title="{{_ 'card-sorting-by-number'}}" class="{{#if allowsCardSortingByNumberOnMinicard}}is-checked{{/if}}")
          i.fa(class="{{#if allowsCardSortingByNumberOnMinicard}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        span
          i.fa.fa-sort-numeric-asc
          | {{_ 'card-sorting-by-number'}}
    .card-settings-row
      .card-settings-column
        a.flex.js-field-has-card-show-lists(title="{{_ 'card-show-lists'}}" class="{{#if allowsShowLists}}is-checked{{/if}}")
          i.fa(class="{{#if allowsShowLists}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        a.flex.js-field-has-card-show-lists-on-minicard(title="{{_ 'card-show-lists'}}" class="{{#if allowsShowListsOnMinicard}}is-checked{{/if}}")
          i.fa(class="{{#if allowsShowListsOnMinicard}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        span
          i.fa.fa-list
          | {{_ 'card-show-lists'}}
    .card-settings-row
      .card-settings-column
        a.flex.js-field-has-labels(title="{{_ 'labels'}}" class="{{#if allowsLabels}}is-checked{{/if}}")
          i.fa(class="{{#if allowsLabels}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        a.flex.js-field-has-labels-on-minicard(title="{{_ 'labels'}}" class="{{#if allowsLabelsOnMinicard}}is-checked{{/if}}")
          i.fa(class="{{#if allowsLabelsOnMinicard}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        span
          i.fa.fa-tag
          | {{_ 'labels'}}
    //- "Labels text": the labels on a minicard as coloured WORDS, or as
      coloured bars with the words left out. Directly under Labels, because it
      is about what those labels look like.
      It is the one PERSONAL row of this table - the user's own profile, or this
      browser when nobody is logged in - so it is shown only in the minicard's
      own view (Minicard menu / Show on Minicard) and not in the board-wide
      Card Settings, where every other row belongs to the board. Checked by
      default: the text is what a minicard shows unless somebody turns it off.
      client/lib/minicardLabelText.js
    .card-settings-row.card-settings-row-personal
      .card-settings-column
      .card-settings-column
        a.flex.js-toggle-minicard-label-text(title="{{_ 'labels'}} {{_ 'custom-field-text'}}" class="{{#if showsMinicardLabelText}}is-checked{{/if}}")
          i.fa(class="{{#if showsMinicardLabelText}}fa-check{{else}}fa-square-o{{/if}}")
      .card-settings-column
        span
          i.fa.fa-tag
          i.fa.fa-file-text-o
          | {{_ 'labels'}}
          | {{_ 'custom-field-text'}}
    .card-settings-row
