      client/components/cards/cardDetails.jade
    li
      a.js-open-archives
        i.fa.fa-archive
        | {{_ 'archived-items'}}
    if currentUser.isBoardAdmin
      li
        a.js-change-board-color
          i.fa.fa-paint-brush
          | {{_ 'board-change-color'}}
      li
        a.js-change-background-image
          i.fa.fa-picture-o
          | {{_ 'board-change-background-image'}}
      li
        a.js-open-notification-settings
          i.fa.fa-bell
          | {{_ 'notifications'}}
      //- "Board backgrounds" was here. It was the list of pictures uploaded to
        this board, and that list is drawn inside Change Background Image now -
        under the upload that adds to it - so a second entry to the same list
        was a second place to look for one thing.
    //Bug Board icons random dance https://github.com/wekan/wekan/issues/4214
    //if currentUser.isBoardAdmin
    //
      unless currentSetting.hideBoardMemberList
    //
        unless currentSetting.hideCardCounterList
    //
          li
    //
            a.js-board-info-on-my-boards(title="{{_ 'board-info-on-my-boards'}}")
    //
              i.fa.fa-id-card-o
    //
              | {{_ 'board-info-on-my-boards'}}
  hr
  ul.pop-over-list
    if withApi
      unless exportDisabled
        li
          a.js-export-board
            i.fa.fa-upload
            | {{_ 'export'}}
        if canImportIntoBoard
          li
            a.js-import-into-board
              i.fa.fa-download
              | {{_ 'import'}}
    if currentUser.isBoardAdmin
      li
        a.js-outgoing-webhooks
          i.fa.fa-globe
          | {{_ 'outgoing-webhooks'}}
      //- "Subtasks Settings" was here. What subtasks do on this board is behind
        the hamburger at the end of the Subtasks heading on an opened card,
        which is where somebody looking at subtasks already is.
        client/components/cards/cardDetails.jade
  if currentUser
    hr
    //- Swimlane, List and Card settings, together. Swimlane and List are
      board-admin settings (the resize locks), same restriction the server
      already enforces. Card is not admin-only: it used to be reached from
      the card's own menu and the minicard's own menu - "Show on Card" /
      "Show on Minicard" - which put the same board-wide list of toggles
      behind two different places depending on what you were looking at, and
      which also let anyone open it for the one PERSONAL row in it ("Labels
      text" - stored on the user's own profile, not the board). It is back
      here as one board setting, and keeps that same personal-only fallback
      for a non-admin. client/components/cards/cardDetails.jade
    ul.pop-over-list
      if currentUser.isBoardAdmin
        //- Board Settings / Board View: which Board View menu entries this
          board offers, and which one it opens in, for a public and for a
          private board. Above Swimlane, since it decides what the whole
          board looks like before any swimlane does.
          docs/Features/Board/Board-View-Settings.md
        li
          a.js-open-board-view-settings(title="{{_ 'board-view'}}")
            i.fa.fa-eye
            | {{_ 'board-view'}}
        li
          a.js-open-board-swimlane-settings(title="{{_ 'swimlane'}}")
            i.fa.fa-bars
            | {{_ 'swimlane'}}
        li
          a.js-open-board-list-settings(title="{{_ 'list'}}")
            i.fa.fa-list
            | {{_ 'list'}}
        li
          a.js-open-board-wip-limit-groups(title="{{_ 'wip-limit-groups'}}")
            i.fa.fa-tasks
            | {{_ 'wip-limit-groups'}}
      li
        a.js-open-board-card-settings(title="{{_ 'card-settings'}}")
          i.fa.fa-id-card
          | {{_ 'card'}}
    hr
  unless currentBoard.isTemplatesBoard
    if currentUser.isBoardAdmin
      ul.pop-over-list
        // li
        //
           a.js-delete-duplicate-lists
        //
             i.fa.fa-trash
        //
             | {{_ 'delete-duplicate-lists'}}
        li
          a.js-archive-board
            i.fa.fa-archive
            | {{_ 'archive-board'}}

//- Board Settings / Board View. Same table as Card Settings - one row per
  view of the Board View menu (models/lib/boardViewSettings.js BOARD_VIEWS,
  in the menu's order), a checkbox per column, the view's name last. The two
  "Default" columns are radio groups drawn as checkboxes: one tick each. The
  two public columns are not rendered when Admin Panel / Settings /
  Visibility hides public boards (tableVisibilityMode-allowPrivateOnly).
  docs/Features/Board/Board-View-Settings.md, client/components/sidebar/sidebar.js
template(name="boardViewSettingsPopup")
  form.board-view-settings(class="{{#if publicBoardsHidden}}hide-public-columns{{/if}}")
    .board-view-settings-row
      unless publicBoardsHidden
        .board-view-settings-column
          h4 {{_ 'default-on-public-board'}}
        .board-view-settings-column
          h4 {{_ 'show-on-public-board'}}
      .board-view-settings-column
        h4 {{_ 'default-on-private-board'}}
      .board-view-settings-column
        h4 {{_ 'show-on-private-board'}}
      .board-view-settings-column
        h4 {{_ 'description'}}
    each boardViewRows
      .board-view-settings-row(data-view="{{view}}")
        unless ../publicBoardsHidden
          .board-view-settings-column
            a.flex.js-board-view-default(data-visibility="public" title="{{_ 'default-on-public-board'}}" class="{{#if isDefaultPublic}}is-checked{{/if}}")
              i.fa(class="{{#if isDefaultPublic}}fa-check{{else}}fa-square-o{{/if}}")
          .board-view-settings-column
            a.flex.js-board-view-show(data-visibility="public" title="{{_ 'show-on-public-board'}}" class="{{#if showOnPublic}}is-checked{{/if}}")
              i.fa(class="{{#if showOnPublic}}fa-check{{else}}fa-square-o{{/if}}")
        .board-view-settings-column
          a.flex.js-board-view-default(data-visibility="private" title="{{_ 'default-on-private-board'}}" class="{{#if isDefaultPrivate}}is-checked{{/if}}")
            i.fa(class="{{#if isDefaultPrivate}}fa-check{{else}}fa-square-o{{/if}}")
        .board-view-settings-column
          a.flex.js-board-view-show(data-visibility="private" title="{{_ 'show-on-private-board'}}" class="{{#if showOnPrivate}}is-checked{{/if}}")
            i.fa(class="{{#if showOnPrivate}}fa-check{{else}}fa-square-o{{/if}}")
        .board-view-settings-column
          //- The row's place in the Board View menu: up/down, like Card
            Settings' card field order. Real links (href) so the keyboard
            reaches them and Enter presses them; the first row's up and the
            last row's down are no-ops (models/lib/boardViewSettings.js
            moveBoardView) and drawn disabled. The two existing "Move up" /
            "Move down" keys are reused rather than new ones.
          a.flex.js-board-view-order-up(href="#" role="button" class="{{#if isFirst}}is-disabled{{/if}}" title="{{_ 'card-field-order-move-up'}}" aria-label="{{_ 'card-field-order-move-up'}}")
            i.fa.fa-arrow-up
          a.flex.js-board-view-order-down(href="#" role="button" class="{{#if isLast}}is-disabled{{/if}}" title="{{_ 'card-field-order-move-down'}}" aria-label="{{_ 'card-field-order-move-down'}}")
            i.fa.fa-arrow-down
          span
            i.fa(class="{{icon}}")
            | {{_ labelKey}}

//- Board Settings / Swimlane. The board-wide swimlane-height resize lock
  used to be a header icon (#6680); it lives here now, with the rest of a
  board's settings. client/components/swimlanes/swimlanes.js
template(name="boardSwimlaneSettingsPopup")
  form.board-swimlane-settings
    div.check-div
      a.flex.js-toggle-swimlane-height-resize-lock(title="{{_ 'lock-swimlane-height-resize'}}" class="{{#if isSwimlaneHeightResizeLocked}}is-checked{{/if}}")
        i.fa(class="{{#if isSwimlaneHeightResizeLocked}}fa-check{{else}}fa-square-o{{/if}}")
        span
          i.fa.fa-arrows-v
          | {{_ 'lock-swimlane-height-resize'}}

//- Board Settings / List. The board-wide list-width resize lock and the
  "same width for all lists" setting used to be header icons (#6680); they
  live here now, with the rest of a board's settings. The per-list "Set
  width" popup keeps the personal/per-list width settings and the actual
  shared-width value - this is only the two board-wide switches.
  client/components/lists/list.js
template(name="boardListSettingsPopup")
  form.board-list-settings
    div.check-div
      a.flex.js-toggle-list-width-resize-lock(title="{{_ 'lock-list-width-resize'}}" class="{{#if isListWidthResizeLocked}}is-checked{{/if}}")
        i.fa(class="{{#if isListWidthResizeLocked}}fa-check{{else}}fa-square-o{{/if}}")
        span
          i.fa.fa-arrows-h
          | {{_ 'lock-list-width-resize'}}
    div.check-div
      a.flex.js-toggle-same-width-for-all-lists(title="{{_ 'same-width-for-all-lists'}}" class="{{#if isSameWidthForAllLists}}is-checked{{/if}}")
        i.fa(class="{{#if isSameWidthForAllLists}}fa-check{{else}}fa-square-o{{/if}}")
        span
          i.fa.fa-columns
          | {{_ 'same-width-for-all-lists'}}

//- #2489: Board Settings / WIP Limit Groups - a shared WIP limit across two or
  more of this board's lists together, on top of the existing per-list
  wipLimit (client/components/lists/listHeader.jade). Same panel pattern as
  Swimlane/List/Card settings above. client/components/sidebar/sidebar.js
template(name="wipLimitGroupsPopup")
  .wip-limit-groups
    each wipLimitGroups
      form.wip-limit-group(data-id="{{_id}}")
        .wip-limit-group-name
          input.js-wip-limit-group-name(type="text" value="{{name}}" placeholder="{{_ 'wip-limit-group-name-placeholder'}}")
        .wip-limit-group-lists
          each ../boardLists
            label.flex
              input.js-wip-limit-group-list-toggle(type="checkbox" data-list-id="{{_id}}" checked="{{isListInGroup _id ../listIds}}")
              | {{title}}
        .wip-limit-group-limit
          label {{_ 'set-wip-limit-value'}}
          input.js-wip-limit-group-limit-value(type="number" value="{{limit}}" min="1" max="999")
          input.js-wip-limit-group-save(type="submit" value="{{_ 'apply'}}")
        .wip-limit-group-actions
          a.flex.js-toggle-wip-limit-group-enabled(class="{{#if enabled}}is-checked{{/if}}")
            i.fa(class="{{#if enabled}}fa-check{{else}}fa-square-o{{/if}}")
            span {{_ 'enable-wip-limit'}}
          a.js-remove-wip-limit-group
            i.fa.fa-trash
            | {{_ 'delete'}}
      hr
    form.wip-limit-group-new
      p {{_ 'wip-limit-group-add'}}
      //- #2380: a WIP limit on a whole swimlane is a WIP limit group whose
        members are exactly that swimlane's own lists (models/lists.js
        swimlaneId). This quick-select checks those boxes below rather than
        adding a second, separate swimlane-limit mechanism.
      .wip-limit-group-swimlane-quick-select.flex
        select.js-wip-limit-group-swimlane
          option(value="") {{_ 'wip-limit-group-select-swimlane'}}
          each boardSwimlanes
            option(value="{{_id}}") {{title}}
        button.js-wip-limit-group-apply-swimlane(type="button") {{_ 'wip-limit-group-apply-swimlane'}}
      .wip-limit-group-lists
        each boardLists
          label.flex
            input.js-wip-limit-group-new-list(type="checkbox" data-list-id="{{_id}}")
            | {{title}}
      label {{_ 'set-wip-limit-value'}}
      input.js-wip-limit-group-new-limit(type="number" value="1" min="1" max="999")
      input.js-wip-limit-group-new-save(type="submit" value="{{_ 'wip-limit-group-add'}}")

template(name="exportBoardPopup")
  //- The same popup as Export swimlane / list / card, with the same panes and
    the same formats table - a board just happens to be the widest scope, so the
    entries marked `scopes: ['board']` (HTML, the dependency graph, CSV, and the
    exports written for another tool) appear here and nowhere else.
    client/components/boards/exportScope.js
  +exportScopeBody(title=boardTitle)

template(name="importBoardIntoPopup")
  //- Import INTO this board - the same body in its import mode. (All Boards has
    an "Import board" of its own, which makes a NEW board from a file; this one
    adds to the board you are looking at.)
  +exportScopeBody(title=boardTitle mode="import")

template(name="labelsWidget")
  .board-widget.board-widget-labels
    //- Same caret as Members above: folding Labels hides the labels under it.
    h3.js-toggle-fold(data-fold="labels" role="button" tabindex="0")
      i.fa(class="{{foldCaret 'labels'}}")
      i.fa.fa-tag
      | {{_ 'labels'}}
    if isFoldOpen 'labels'
      .board-widget-content
        each currentBoard.labels
            a.card-label(class="{{labelColorClass color}}" style="{{labelColorStyle color}}"
              class="{{#if currentUser.isNotCommentOnly}}{{#if currentUser.isNotWorker}}js-label{{/if}}{{/if}}")
              span.card-label-name
                +viewer
                  = name
        if currentUser.isBoardAdmin
          a.card-label.add-label.js-add-label(title="{{_ 'label-create'}}")
            i.fa.fa-plus

template(name="memberPopup")
  .board-member-menu
    .miniprofile-header
      +userAvatar(userId=user._id showEdit=true)
      .info
        h3
          .js-profile= user.profile.fullname
        p.quiet @#{user.username}
        if isInvited
          p
            i.fa.fa-exclamation-triangle
            | {{_ 'not-accepted-yet'}}

    ul.pop-over-list
      li
        a.js-filter-member {{_ 'filter-cards'}}
      if currentUser.isBoardAdmin
        li
          a.js-change-role
            | {{_ 'change-permissions'}}
            span.quiet (#{memberType})
        if isImportedMember
          li
            a.js-map-imported-member
              i.fa.fa-user-plus
              | {{_ 'map-to-existing-user'}}
      unless currentUser.isWorker
        li
          if $eq currentUser._id userId
            a.js-leave-member {{_ 'leave-board'}}
          else if currentUser.isBoardAdmin
            a.js-remove-member {{_ 'remove-from-board'}}

template(name="mapImportedMemberPopup")
  p.quiet {{_ 'map-to-existing-user-desc'}}
  .js-map-target-search
    input.js-map-target-search-input(type="text" placeholder="{{_ 'map-to-existing-user-search'}}" autocomplete="off")
  if searching
    .map-target-status.quiet {{_ 'loading'}}
  ul.pop-over-list
    each u in mapTargets
      li
        a.js-pick-map-target(data-id="{{u._id}}")
          +userAvatar(userId=u._id)
          span.full-name= u.profile.fullname
          |  (@#{u.username})
          unless u.isBoardMember
            span.quiet  — {{_ 'map-to-existing-user-not-member'}}
    unless hasMapTargets
      li
        p.quiet {{mapTargetsEmptyText}}

