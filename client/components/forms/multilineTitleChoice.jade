template(name="multilineTitleChoice")
  fieldset.multiline-title-choice
    legend {{_ 'add-many-lines-as'}}
    label
      input.js-multiline-title-mode(type="radio" name=groupName value="one" checked)
      | 1 {{_ singular}}
    label
      input.js-multiline-title-mode(type="radio" name=groupName value="separate")
      | {{_ 'many-items' items=(_ plural)}}
