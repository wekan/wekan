template(name="setting")
  .setting-content
    //- Multitenancy option D (docs/Design/Multitenancy/Multitenancy.md, D.9): an
    //- Organization's own admin opens this page for ONE pane - Visibility, and in it
    //- only "Change color", the site theme of their Organization. Everything else
    //- here is instance-wide and stays site-admin only, pane by pane and group by
    //- group.
    unless currentUser.isAdminOrOrgAdmin
      | {{_ 'error-notAuthorized'}}
    else
      //- No page-title bar here. The Admin Panel top bar already says which section
      //- you are in, and the left menu highlights which pane is open, so a third
      //- line repeating the pane name only cost vertical space. Admin Panel /
      //- Problems has never had one.
      .content-body
        +leftMenu(menuItems)
        .main-body
          //- Every Admin Panel pane opens with the same heading, and it is the
          //- open menu entry's own label (docs/Features/Page/Left-Menu.md).
          +paneTitle(paneTitleData)
          if isLoading
            +spinner
          else if isVersionSetting
            //- The version, database and system information. Its template lives in
            //- informationBody.jade, with the code that loads the statistics; Blaze
            //- templates are global, so the pane renders here.
            +statistics
          else if isTableVisibilityModeSetting
            +tableVisibilityModeSettings
          else if isAnnouncementSetting
            +announcementSettings
          else if isAccessibilitySetting
            +accessibilitySettings
          else if isTranslationSetting
            +translationSettings
          else if isLayoutSetting
            +pwaSettings
          else if isWebhookSetting
            +webhookSettings

template(name="webhookSettings")
  span
     +outgoingWebhooksPopup

//- The Login pane. Admin Panel / PEOPLE renders this now (peopleBody.jade); it is
//- defined here, with the other admin settings panes, because Blaze templates are
//- global and its handlers sit beside the other settings handlers in settingBody.js.
template(name="general")
  ul#registration-setting.setting-detail
    li
      h2.admin-pane-group-title {{_ 'login-allow'}}
    //- Every row in this group is a checkbox that is TICKED when the thing is
    //- allowed, under a title that says "Allow" once. Two of them are stored the
    //- other way round - `disableForgotPassword` and `disableRegistration` are
    //- "disable" flags - so the markup asks `unless`. Only the display is inverted;
    //- the stored fields and their handlers are unchanged.
    li
      a.flex.js-toggle-forgot-password
        .materialCheckBox(class="{{#unless currentSetting.disableForgotPassword}}is-checked{{/unless}}")

        span {{_ 'forgot-password'}}
    li
      a.flex.js-toggle-registration
        .materialCheckBox(class="{{#unless currentSetting.disableRegistration}}is-checked{{/unless}}")

        span {{_ 'self-registration'}}
    li
      a.flex.js-toggle-username-change
        .materialCheckBox(class="{{#if allowUserNameChange}}is-checked{{/if}}")

        span {{_ 'accounts-allowUserNameChange'}}
    li
      a.flex.js-toggle-user-delete
        .materialCheckBox(class="{{#if allowUserDelete}}is-checked{{/if}}")

        span {{_ 'accounts-allowUserDelete'}}
    li
      a.flex.js-toggle-display-authentication-method
        .materialCheckBox(class="{{#if currentSetting.displayAuthenticationMethod}}is-checked{{/if}}")

        span {{_ 'display-authentication-method'}}

    li.admin-pane-group-separator
      hr
    li
      .invite-people(class="{{#if currentSetting.disableRegistration}}{{else}}hide{{/if}}")
        ul
          li
            .title {{_ 'invite-people'}}
            textarea#email-to-invite.wekan-form-control(rows='5', placeholder="{{_ 'email-addresses'}}")
          li
            .title {{_ 'to-boards'}}
            .bg-white
              each boards
                a.option.flex.js-toggle-board-choose(id= _id)
                  .materialCheckBox(data-id= _id)

                  span= title

          li
            button.js-email-invite.primary {{_ 'invite'}}
    li.accounts-form
      .title {{_ 'default-authentication-method'}}
      +selectAuthenticationMethod(authenticationMethod=currentSetting.defaultAuthenticationMethod)
    li.accounts-form
      .title {{_ 'oidc-button-text'}}
      .form-group
        input.wekan-form-control#oidcBtnTextvalue(type="text", placeholder="" value="{{currentSetting.oidcBtnText}}")
      button.js-account-access-save.primary {{_ 'save'}}

