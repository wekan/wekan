//- Admin Panel / Settings / Visibility, in four named groups: what All Boards
//- shows, the URLs, the product name and the logos. The groups are what makes a
//- long single list readable - the settings themselves are unchanged, and so are
//- their ids, so the one Save button at the bottom still reads every field it did
//- before (it looks them up by id, not by position).
//-
//- A group title is smaller than the pane title above it (.admin-pane-group-title
//- vs .admin-pane-title, settingBody.css), so the page reads as one heading with
//- groups under it rather than as several pages.
template(name='tableVisibilityModeSettings')
  ul#tableVisibilityMode-setting.setting-detail
    //- Every group here writes the INSTANCE settings, so it is site-admin only.
    //- The one exception is "Change color" below, which an Organization's own
    //- admin sets for their Organization (models/lib/tenantAdmin.js themeTarget).
    if isSiteAdmin
      li
        h2.admin-pane-group-title {{_ 'all-boards-hide'}}
      //- One checkbox per setting instead of a Yes/No pair: each of these is on or
      //- off, and the group's own title already says what ticking one means (All
      //- Boards: Hide …). Same checkbox as everywhere else in the Admin Panel -
      //- Announcement's "Active System-Wide Announcement" - so it has the plain
      //- square when off, the green tick when on, and the animation between.
      //- The Save button below reads the ticks, as it read the radios.
      li.tableVisibilityMode-form
        //- "Public boards", under the "All Boards: Hide" title above: ticked hides
        //- them, which is what allowPrivateOnly does. The setting's own key keeps its
        //- sentence - boardBody.jade shows it as the message on a board you may not
        //- open, where a two-word label would say nothing.
        a.flex.js-toggle-all-boards-hide
          .materialCheckBox#accounts-allowPrivateOnly(class="{{#if allowPrivateOnly}}is-checked{{/if}}")
          span {{_ 'public-boards'}}
      li.hideBoardActivities-form
        a.flex.js-toggle-all-boards-hide
          .materialCheckBox#hide-board-activities(class="{{#if currentSetting.hideBoardActivitiesOnAllBoards}}is-checked{{/if}}")
          span {{_ 'board-activities'}}
      li.tableVisibilityMode-form
        a.flex.js-toggle-all-boards-hide
          .materialCheckBox#hide-card-counter-list(class="{{#if currentSetting.hideCardCounterList}}is-checked{{/if}}")
          span {{_ 'card-counter-list'}}
      li.tableVisibilityMode-form
        a.flex.js-toggle-all-boards-hide
          .materialCheckBox#hide-board-member-list(class="{{#if currentSetting.hideBoardMemberList}}is-checked{{/if}}")
          span {{_ 'board-member-list'}}
      li.tableVisibilityMode-form
        .title {{_ 'wait-spinner'}}
        +selectSpinnerName(spinnerName=currentSetting.spinnerName)
      li
        //- One Save per section, at its end, above the rule that closes it. It writes
        //- this section's fields and nothing else, so saving one group can never
        //- overwrite what you were editing in another.
        button.js-visibility-all-boards-save.primary {{_ 'save'}}

      li.admin-pane-group-separator
        hr
      li
        h2.admin-pane-group-title {{_ 'settings-group-url'}}
      li
        a(href="/support" style="text-decoration: underline; color: blue;") {{_ 'support'}}
      li
        a.flex.js-toggle-support
          .materialCheckBox(class="{{#if currentSetting.supportPageEnabled}}is-checked{{/if}}")

          span {{_ 'support-page-enabled'}}
      li
        .support-content(class="{{#if currentSetting.supportPageEnabled}}{{else}}hide{{/if}}")
          ul
            li
              a.flex.js-toggle-support-public
                .materialCheckBox(class="{{#if currentSetting.supportPagePublic}}is-checked{{/if}}")

                span {{_ 'public'}}
            li
              .title {{_ 'support-title'}}
              textarea#support-title.wekan-form-control= currentSetting.supportTitle
            li
              .title {{_ 'support-content'}}
              textarea#support-page-text.wekan-form-control= currentSetting.supportPageText
      li.tableVisibilityMode-form
        .title {{_ 'custom-help-link-url'}}
        .form-group
          input.wekan-form-control#custom-help-link-url(type="text", placeholder="" value="{{currentSetting.customHelpLinkUrl}}")
      li.tableVisibilityMode-form
        .title {{_ 'custom-legal-notice-link-url'}}
        .form-group
          input.wekan-form-control#legalNoticevalue(type="text", placeholder="" value="{{currentSetting.legalNotice}}")
      li.tableVisibilityMode-form
        .title {{_ 'automatic-linked-url-schemes'}}
        .form-group
          textarea#automatic-linked-url-schemes.wekan-form-control= currentSetting.automaticLinkedUrlSchemes
      li
        button.js-visibility-url-save.primary {{_ 'save'}}

      li.admin-pane-group-separator
        hr
      li
        //- The group title IS the field's label here: the group holds one field, so a
        //- title above a label that says the same thing said it twice. The group title
        //- keeps its size and takes the field's existing translation.
        h2.admin-pane-group-title {{_ 'custom-product-name'}}
      li.tableVisibilityMode-form
        .form-group
          input.wekan-form-control#product-name(type="text", placeholder="" value="{{currentSetting.productName}}")
      li
        button.js-visibility-product-name-save.primary {{_ 'save'}}

    //- The site theme. Same picker as the per-user "Change color", one layer
    //- below it: whoever has not chosen a theme of their own sees this one
    //- (docs/Theme/Theme.md). It applies immediately - the picker has no Save
    //- button, like the per-user one.
    if isSiteAdmin
      li.admin-pane-group-separator
        hr
    li
      h2.admin-pane-group-title {{_ 'change-color'}}
      //- The site admin's colour is the one every Organization that has not set
      //- its own inherits, so their pane says so; an Organization's own admin is
      //- setting only their own and needs no such line.
      if isSiteAdmin
        h3.admin-pane-subgroup-title {{_ 'theme-override-all-tenants'}}
    li.tableVisibilityMode-form
      +themeColorPicker(scope="admin")

    if isSiteAdmin
      li.admin-pane-group-separator
        hr
      li
        h2.admin-pane-group-title {{_ 'settings-group-logo'}}
      li.tableVisibilityMode-form
        //- One checkbox, like the All Boards group above and like Announcement's
        //- "Active System-Wide Announcement": ticked = the logo is hidden. The
        //- group's Save below writes it, as it wrote the Yes/No pair.
        a.flex.js-toggle-hide-logo
          .materialCheckBox#hide-logo(class="{{#if currentSetting.hideLogo}}is-checked{{/if}}")
          span {{_ 'hide-logo'}}
      li.tableVisibilityMode-form
        .title {{_ 'custom-login-logo-image-url'}}
        .form-group
          input.wekan-form-control#custom-login-logo-image-url(type="text", placeholder="" value="{{currentSetting.customLoginLogoImageUrl}}")
      li.tableVisibilityMode-form
        .title {{_ 'custom-login-logo-link-url'}}
        .form-group
          input.wekan-form-control#custom-login-logo-link-url(type="text", placeholder="" value="{{currentSetting.customLoginLogoLinkUrl}}")
      li.tableVisibilityMode-form
        .title {{_ 'text-below-custom-login-logo'}}
        .form-group
          textarea#text-below-custom-login-logo.wekan-form-control= currentSetting.textBelowCustomLoginLogo
      li.tableVisibilityMode-form
        .title {{_ 'custom-top-left-corner-logo-image-url'}}
        .form-group
          input.wekan-form-control#custom-top-left-corner-logo-image-url(type="text", placeholder="" value="{{currentSetting.customTopLeftCornerLogoImageUrl}}")
      li.tableVisibilityMode-form
        .title {{_ 'custom-top-left-corner-logo-link-url'}}
        .form-group
          input.wekan-form-control#custom-top-left-corner-logo-link-url(type="text", placeholder="" value="{{currentSetting.customTopLeftCornerLogoLinkUrl}}")
      li.tableVisibilityMode-form
        .title {{_ 'custom-top-left-corner-logo-height'}}
        .form-group
          input.wekan-form-control#custom-top-left-corner-logo-height(type="text", placeholder="" value="{{currentSetting.customTopLeftCornerLogoHeight}}")
      li
        button.js-visibility-logo-save.primary {{_ 'save'}}

