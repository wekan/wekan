template(name="problemsSummary")
  .global-search-results-list-wrapper
    h1 {{_ 'summary'}}

    //- Status overview: migrations / repairs in progress + detected problems.
    //- Same data as `snap run wekan.problems`.
    if statusOverview
      h2 {{_ 'problems-status-title'}}
      if statusOverview.anyInProgress
        p {{_ 'problems-in-progress-help'}}
        .admin-problem-banner
          each item in inProgress
            .admin-problem-item
              i.fa.fa-spinner.fa-spin
              span.admin-problem-path {{item.message}}
      else
        p {{_ 'problems-none-in-progress'}}
      if statusOverview.anyProblems
        .admin-problem-banner
          each problem in statusProblems
            .admin-problem-item
              i.fa.fa-exclamation-triangle
              span.admin-problem-path {{problem.title}}
              if problem.count
                span.admin-problem-count {{problem.count}}
              br
              span.quiet {{problem.detail}}
              //- Broken cards are one of the two detected problems the admin can
              //- fix from here: run the repair migration over every board.
              if isBrokenCards problem
                .admin-problem-actions
                  button.js-repair-broken-cards.primary(disabled="{{#if repairRunning}}disabled{{/if}}")
                    if repairRunning
                      i.fa.fa-spinner.fa-spin
                      | {{_ 'repairing'}}
                    else
                      i.fa.fa-wrench
                      | {{_ 'repair-broken-cards'}}
                  if repairResult
                    br
                    span.quiet {{repairResult}}
              //- #6670: lists un-bound from their swimlane by the pre-#6515
              //- automatic repair. The swimlane each list was created in is
              //- still recorded, so this puts back exactly that and nothing else.
              //- What it restores and what it leaves alone is in the problem's
              //- own detail line above, so this needs no description of its own.
              if isUnboundLists problem
                .admin-problem-actions
                  button.js-restore-list-swimlanes.primary(disabled="{{#if restoreRunning}}disabled{{/if}}")
                    if restoreRunning
                      i.fa.fa-spinner.fa-spin
                      | {{_ 'repairing'}}
                    else
                      i.fa.fa-wrench
                      | {{_ 'restore'}}
                  if restoreResult
                    br
                    span.quiet {{restoreResult}}

    h2 {{_ 'problems'}}
    if hasProblems
      p {{_ 'problems-summary-help'}}
      .admin-problem-banner
        each area in areas
          label.admin-problem-item
            input.js-problem-check(type="checkbox" data-stream="{{area.stream}}")
            i.fa.fa-exclamation-triangle
            span.admin-problem-path {{_ 'admin-panel'}} → {{_ 'problems'}} → {{areaLabel area.stream}}
            span.admin-problem-count {{area.count}} {{_ 'new-problems'}}
        .admin-problem-actions
          button.js-ack-checked.primary {{_ 'acknowledge'}}
    else
      p {{_ 'no-new-problems'}}
