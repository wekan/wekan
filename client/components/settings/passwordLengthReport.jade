//- Admin Panel / Problems / Password length (docs/Features/Admin-Panel/Problems/Password-length.md):
//- the minimum, whether it is enforced, and who signs in with a shorter
//- password - through the shared table page (docs/Features/General/Table.md).
template(name="passwordLengthReport")
  ul.setting-detail.password-length-settings
    li
      label(for="password-min-length-input") {{_ 'password-min-length'}}
      input#password-min-length-input.js-password-min-length(type="number" min="1" max="256" value="{{minLength}}")
      p.description {{_ 'password-min-length-description'}}
    li
      a.flex.js-toggle-password-min-length-enforce
        .materialCheckBox(class="{{#if enforce}}is-checked{{/if}}")
        span {{_ 'password-min-length-enforce'}}
      p.description {{_ 'password-min-length-enforce-description'}}
    li
      button.primary.js-save-password-length(type="button") {{_ 'save'}}
      if saved
        span.password-length-saved {{_ 'password-length-saved'}}
      if saveError
        p.error.password-length-error= saveError
      if fromEnvironment
        p.description {{_ 'password-length-from-environment'}}
  +tablePage(tablePageData)
