template(name="adminReports")
  .setting-content.admin-reports-content
    unless currentUser.isAdmin
      | {{_ 'error-notAuthorized'}}
    else
      .content-body
        .side-menu
          ul
            li
              a.js-report-summary(data-id="report-summary")
                i.fa.fa-list
                | {{_ 'summary'}}

            li
              a.js-report-security(data-id="report-security")
                i.fa.fa-shield
                | {{_ 'securityReportTitle'}}

            li
              a.js-report-speed(data-id="report-speed")
                i.fa.fa-tachometer
                | {{_ 'speedReportTitle'}}

            li
              a.js-report-tests(data-id="report-tests")
                i.fa.fa-flask
                | {{_ 'testsReportTitle'}}

            li
              a.js-report-cpu(data-id="report-cpu")
                i.fa.fa-tachometer
                | {{_ 'cpuReportTitle'}}

            li.admin-reports-separator
              hr

            li
              a.js-report-broken(data-id="report-broken")
                i.fa.fa-chain-broken
                | {{_ 'broken-cards'}}

            li
              a.js-report-files(data-id="report-files")
                i.fa.fa-paperclip
                | {{_ 'filesReportTitle'}}

            li
              a.js-report-rules(data-id="report-rules")
                i.fa.fa-magic
                | {{_ 'rulesReportTitle'}}

            li
              a.js-report-boards(data-id="report-boards")
                i.fa.fa-columns
                | {{_ 'boardsReportTitle'}}

            li
              a.js-report-cards(data-id="report-cards")
                i.fa.fa-id-card-o
                | {{_ 'cardsReportTitle'}}

            li
              a.js-report-impersonation(data-id="report-impersonation")
                i.fa.fa-user-secret
                | {{_ 'impersonationReportTitle'}}

            li
              a.js-report-recovery(data-id="report-recovery")
                i.fa.fa-medkit
                | {{_ 'recoveryReportTitle'}}

        .main-body
          if loading.get
            +spinner
          else if showSummary.get
            +problemsSummary
          else if showSecurity.get
            +eventStreamReport(stream="security")
          else if showSpeed.get
            +eventStreamReport(stream="speed")
          else if showTests.get
            +eventStreamReport(stream="tests")
          else if showCpu.get
            +eventStreamReport(stream="cpu")
          else if showBrokenCardsReport.get
            +brokenCardsReport
          else if tablePageData
            +tablePage(tablePageData)


template(name="brokenCardsReport")
  .global-search-results-list-wrapper
    h1 {{_ 'broken-cards'}}
    if resultsCount
      +resultsPaged(this)
    else
      div {{_ 'no-results' }}

template(name="eventStreamReport")
  //- Security / Speed / Tests / CPU usage all render through the shared table
  //- page (docs/Design/Table-Page.md). CPU usage additionally passes the live
  //- figure as the status row between the title and the controls.
  +tablePage(tablePageData)

template(name="cpuCurrentStatus")
  .admin-cpu-current(class="{{#if high}}admin-cpu-high{{/if}}")
    span.admin-cpu-label {{_ 'cpu-usage-current'}}
    span.admin-cpu-percent {{percent}}%
    span.quiet
      | {{cores}} {{_ 'cpu-cores-suffix'}} &middot; {{_ 'cpu-load-average'}} {{loadAverage}}
    if activity
      span.quiet  &middot; {{activity}}
