//- The reusable "Notification Settings" popup: one template, opened from the
//- three places the 3-tier Notification Settings system (see
//- models/lib/notificationSettings.js) can be configured -
//-   Member Settings   (client/components/users/userHeader.jade)  scope='member'
//-   Board Settings    (client/components/sidebar/sidebar.jade)   scope='board'
//-   Admin Panel/People (client/components/settings/peopleBody.jade) scope='admin'
//- Precedence: admin default -> board override -> member override, the same
//- shape the board/member theme override already uses elsewhere. At the board
//- and member scopes, "Use admin/board default" clears the override for that
//- level so it falls through to the level below.
template(name="notificationSettingsPopup")
  ul.pop-over-list.notification-settings-popup
    li
      p.quiet {{_ 'notification-settings-popup-description'}}
    each notifyServiceRows
      li
        .title
          i.fa(class="{{icon}}")
          | {{_ labelKey}}
        .notification-settings-popup-options
          if isAdminScope
            a.flex.js-notify-option(data-service="{{service}}" data-value="true")
              .materialCheckBox(class="{{#if onSelected}}is-checked{{/if}}")
              span {{_ 'yes'}}
            a.flex.js-notify-option(data-service="{{service}}" data-value="false")
              .materialCheckBox(class="{{#if offSelected}}is-checked{{/if}}")
              span {{_ 'no'}}
          else
            a.flex.js-notify-option(data-service="{{service}}" data-value="")
              .materialCheckBox(class="{{#if inheritSelected}}is-checked{{/if}}")
              span {{_ 'default'}}
            a.flex.js-notify-option(data-service="{{service}}" data-value="true")
              .materialCheckBox(class="{{#if onSelected}}is-checked{{/if}}")
              span {{_ 'yes'}}
            a.flex.js-notify-option(data-service="{{service}}" data-value="false")
              .materialCheckBox(class="{{#if offSelected}}is-checked{{/if}}")
              span {{_ 'no'}}
    if isBoardScope
      li.due-reminder-settings
        .title
          i.fa.fa-clock-o
          | {{_ 'due-reminder-heading'}}
        form.js-due-reminder-form
          label(for="due-reminder-days") {{_ 'due-reminder-days-label'}}
          input#due-reminder-days.js-due-reminder-days(type="text" value="{{dueReminderDaysText}}" disabled=dueRemindersOff)
          //- WeKan hides bare checkboxes app-wide; these follow the popup's
          //- materialCheckBox toggles above.
          a.flex.js-due-reminder-off(role="checkbox" aria-checked="{{#if dueRemindersOff}}true{{else}}false{{/if}}")
            .materialCheckBox(class="{{#if dueRemindersOff}}is-checked{{/if}}")
            span {{_ 'due-reminder-off'}}
          a.flex.js-due-reminder-webhook(role="checkbox" aria-checked="{{#if dueReminderWebhook}}true{{else}}false{{/if}}")
            .materialCheckBox(class="{{#if dueReminderWebhook}}is-checked{{/if}}")
            span {{_ 'due-reminder-webhook'}}
          if dueReminderMessage
            p.quiet.js-due-reminder-message {{dueReminderMessage}}
          button.primary.js-due-reminder-save(type="submit") {{_ 'save'}}
    //- #572: which kinds of card activity this member is told about.
    if isMemberScope
      li.notification-activity-settings
        .title
          i.fa.fa-filter
          | {{_ 'notification-activity-heading'}}
        p.quiet {{_ 'notification-activity-description'}}
        each activityGroupRows
          a.flex.js-notify-activity(data-group="{{key}}" role="checkbox" aria-checked="{{#if enabled}}true{{else}}false{{/if}}")
            .materialCheckBox(class="{{#if enabled}}is-checked{{/if}}")
            span {{_ labelKey}}
