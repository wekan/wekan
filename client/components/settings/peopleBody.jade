template(name="rolesGeneral")
  .roles-settings
    p.roles-description {{_ 'roles-info'}}

    h4 {{_ 'allow-invite-to-board'}}
    ul#roles-setting.setting-detail
      li
        a.flex.js-toggle-all-roles
          .materialCheckBox(class="{{#if allRolesAllowed}}is-checked{{/if}}")
          span {{_ 'all-board-members'}}
      each roleOptions
        li
          a.flex.js-toggle-role(data-role="{{key}}")
            .materialCheckBox(class="{{#if allowed}}is-checked{{/if}}")
            span {{_ label}}

    button.js-roles-save.primary {{_ 'save'}}

    //- Roles Status: what each board role may do, READ-ONLY, below the Save
    //- button. It is the shared table page (docs/Features/Page/Table.md), so it
    //- looks and behaves like every other Admin Panel table, and it follows the
    //- checkboxes ABOVE the Save button - the working copy, not the saved
    //- document - so an admin can see the effect of a change before saving it.
    +tablePage(rolesStatusTable)

template(name="templatesGeneral")
  .templates-settings
    p.templates-description {{_ 'shared-templates-info'}}

    ul#templates-setting.setting-detail
      li
        a.flex.js-toggle-template-scope(data-scope="organizations")
          .materialCheckBox(class="{{#if scopeChecked 'organizations'}}is-checked{{/if}}")
          span {{_ 'organizations'}}
      li
        a.flex.js-toggle-template-scope(data-scope="teams")
          .materialCheckBox(class="{{#if scopeChecked 'teams'}}is-checked{{/if}}")
          span {{_ 'teams'}}
      li
        a.flex.js-toggle-template-scope(data-scope="domains")
          .materialCheckBox(class="{{#if scopeChecked 'domains'}}is-checked{{/if}}")
          span {{_ 'domains'}}

    .shared-templates-results
      if loading.get
        +spinner
      else if hasAnyScope
        each scopeBlock in scopeBlocks
          h4 {{_ scopeBlock.scopeLabel}}
          if scopeBlock.groups.length
            each group in scopeBlock.groups
              .shared-templates-group
                h5 {{group.groupName}}
                ul.setting-detail
                  each member in group.members
                    li
                      span.shared-templates-user {{member.label}}
                      ul.shared-templates-boards
                        each board in member.templateBoards
                          li
                            if board.boardId
                              a.js-shared-template-link(href="{{board.url}}" data-board-id="{{board.boardId}}" data-slug="{{board.slug}}")
                                i.fa.fa-clone
                                | {{board.title}}
                            else
                              span
                                i.fa.fa-clone
                                | {{board.title}}
          else
            p.shared-templates-none {{_ 'no-shared-templates'}}
      else
        p.shared-templates-hint {{_ 'shared-templates-select-scope'}}
