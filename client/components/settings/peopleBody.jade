template(name="people")
  .setting-content
    //- Multitenancy option D (docs/Design/Multitenancy/Multitenancy.md, D.7): the
    //- Admin Panel opens for the site admin AND for a per-tenant Global Admin, who
    //- gets the same menu with only the panes about their own Organization. The
    //- server scopes what they can see and write; this only decides what to draw.
    unless currentUser.isAdminOrOrgAdmin
      | {{_ 'error-notAuthorized'}}
    else
      //- No page-title bar. The Admin Panel top bar already names the section and
      //- the left menu highlights the open pane, so a third line repeating the pane
      //- name only cost vertical space. Admin Panel / Problems never had one.
      .content-body
        if loginLocationReportOpen
          +leftMenu(loginLocationMenuItems)
          .main-body
            +paneTitle(loginLocationPaneTitle)
            +tablePage(loginLocationTablePageData)
        else
          +leftMenu(menuItems)
          .main-body
            //- Every Admin Panel pane opens with the same heading, and it is the
            //- open menu entry's own label (docs/Features/Page/Left-Menu.md).
            +paneTitle(paneTitleData)
            //- Login and E-mail moved here from Admin Panel / Settings. Their templates
            //- still live in settingBody.jade beside the other settings panes - Blaze
            //- templates are global - and their handlers moved onto those templates so
            //- they fire wherever the pane is rendered.
            //- The comment lives ABOVE the chain on purpose: a comment BETWEEN `if` and
            //- `else if` splits them, and the orphaned `else if` fails the build with
            //- "Can't use the built-in 'if' here".
            if loading.get
              +spinner
            else if registrationSetting.get
              +general
            else if emailSetting.get
              +email
            else if orgSetting.get
              +orgGeneral(orgTablePageData)
            else if teamSetting.get
              +teamGeneral(teamTablePageData)
            else if peopleSetting.get
              +peopleGeneral(peopleTablePageData)
            else if lockedUsersSetting.get
              +lockedUsersGeneral
            else if rolesSetting.get
              +rolesGeneral
            else if templatesSetting.get
              +templatesGeneral
            else if domainSetting.get
              +domainGeneral


template(name="orgGeneral")
  //- The Organization half of #6116, beside the Organizations it is about - it used
  //- to be one "same Organization OR Team" checkbox in the Login pane, which is
  //- where neither of the two things it restricts lives. Ticked = a user may only
  //- be added to a board when they share an Organization with whoever adds them.
  ul.setting-detail
    li
      a.flex.js-toggle-board-members-same-org
        .materialCheckBox(class="{{#if currentSetting.boardMembersFromSameOrgOnly}}is-checked{{/if}}")

        span {{_ 'board-members-same-org-only'}}
  +tablePage(this)

//- One header cell for an Organization feature column: the label plus its
//- select-all / unselect-all pair. Rendered by the shared table page through the
//- column spec (headerTemplate), so the <th> itself still belongs to that
//- template. `feature` and `labelKey` come from headerData.
template(name="orgFeatureHeader")
  | {{_ labelKey}}
  br
  a.js-org-feature-all(href="#", data-feature="{{feature}}", data-value="true", title="{{_ 'select-all'}}")
    i.fa.fa-check-square-o
  |  
  a.js-org-feature-all(href="#", data-feature="{{feature}}", data-value="false", title="{{_ 'unselect-all'}}")
    i.fa.fa-square-o

template(name="teamGeneral")
  //- The Team half of #6116 - see orgGeneral above. Ticked = a user may only be
  //- added to a board when they share a Team with whoever adds them. Both ticked is
  //- the old "Organization OR Team" rule, which is what an upgraded install gets.
  ul.setting-detail
    li
      a.flex.js-toggle-board-members-same-team
        .materialCheckBox(class="{{#if currentSetting.boardMembersFromSameTeamOnly}}is-checked{{/if}}")

        span {{_ 'board-members-same-team-only'}}
  +tablePage(this)

//- The Teams equivalent of orgFeatureHeader: label plus its select-all pair,
//- parameterised by feature. Rendered through the shared table page.
template(name="teamFeatureHeader")
  | {{_ labelKey}}
  br
  a.js-team-feature-all(href="#", data-feature="{{feature}}", data-value="true", title="{{_ 'select-all'}}")
    i.fa.fa-check-square-o
  |  
  a.js-team-feature-all(href="#", data-feature="{{feature}}", data-value="false", title="{{_ 'unselect-all'}}")
    i.fa.fa-square-o

template(name="peopleGeneral")
  //- Not part of the table: the Add/Remove Teams panel this pane opens.
  #divAddOrRemoveTeamContainer
    +modifyTeamsUsers
  +tablePage(this)

template(name="selectAllUser")
  //- #6465: label AND box in one <label>, so the box cannot land on top of the
  //- word. They were two loose inline nodes in a table heading: the heading
  //- centres its content, the checkbox is replaced-content with its own
  //- baseline, and at the width the column happens to have, the box overlapped
  //- the text. A label also makes the word itself click the box.
  label.select-all-user(for="chkSelectAll")
    span {{_ 'dueCardsViewChange-choice-all'}}
    input.allUserChkBox(type="checkbox", id="chkSelectAll")

