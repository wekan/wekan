template(name="peopleRow")
  tr
    td
      a.edit-user(data-user-id=userData._id)
        i.fa.fa-pencil-square-o
        | {{_ 'edit'}}
      a.more-settings-user(data-user-id=userData._id)
        | ⋯
    if userData.loginDisabled
      td.username
        a.js-edit-people-avatar(data-user-id=userData._id)
          if hasAvatarUrl
            .avatar
              img.avatar-image(src="{{userData.profile.avatarUrl}}", alt="{{userData.username}}", title="{{_ 'change-avatar'}}")
          else
            +userAvatarInitials(userId=userData._id)
        <s>{{ userData.username }}</s>
    else if isUserLocked
      td.username
        a.js-edit-people-avatar(data-user-id=userData._id)
          if hasAvatarUrl
            .avatar
              img.avatar-image(src="{{userData.profile.avatarUrl}}", alt="{{userData.username}}", title="{{_ 'change-avatar'}}")
          else
            +userAvatarInitials(userId=userData._id)
        | {{ userData.username }}
    else
      td.username
        a.js-edit-people-avatar(data-user-id=userData._id)
          if hasAvatarUrl
            .avatar
              img.avatar-image(src="{{userData.profile.avatarUrl}}", alt="{{userData.username}}", title="{{_ 'change-avatar'}}")
          else
            +userAvatarInitials(userId=userData._id)
        | {{ userData.username }}
    if userData.loginDisabled
      td <s>{{ userData.emails.[0].address }}</s>
    else
      td {{ userData.emails.[0].address }}
    if userData.loginDisabled
      td
        if userData.isAdmin
          | <s>{{_ 'yes'}}</s>
        else
          | <s>{{_ 'no'}}</s>
    else
      td
        if userData.isAdmin
          | {{_ 'yes'}}
        else
          | {{_ 'no'}}
    td.account-active-status
      if userData.loginDisabled
        span.text-red.js-toggle-active-status(data-user-id=userData._id, data-is-active="false", title="{{_ 'admin-people-user-inactive'}}")
          i.fa.fa-ban
      else
        span.text-green.js-toggle-active-status(data-user-id=userData._id, data-is-active="true", title="{{_ 'admin-people-user-active'}}")
          i.fa.fa-check
    td.people-login-locations
      each loginCountries
        button.js-open-login-country(type="button", data-user-id="{{userId}}", data-country="{{country}}", title="{{country}}")
          span(aria-hidden="true") {{flag}}
          span {{count}}
    td.account-status
      if isUserLocked
        span.text-red.js-toggle-lock-status.emoji-icon(data-user-id=userData._id, data-is-locked="true", title="{{_ 'accounts-lockout-click-to-unlock'}}")
          i.fa.fa-lock
      else
        span.text-green.js-toggle-lock-status.emoji-icon(data-user-id=userData._id, data-is-locked="false", title="{{_ 'accounts-lockout-user-unlocked'}}")
          i.fa.fa-unlock
    if userData.loginDisabled
      td <s>{{ displayDate userData.createdAt 'LLL' }}</s>
    else
      td {{ displayDate userData.createdAt 'LLL' }}
    if userData.loginDisabled
      td
        input.selectUserChkBox(type="checkbox", disabled="disabled", id="{{userData._id}}")
    else
      td
        input.selectUserChkBox(type="checkbox", id="{{userData._id}}")

template(name="editOrgPopup")
  form
    label.hide.orgId(type="text" value=org._id)
    label
      | {{_ 'displayName'}}
      input.js-orgDisplayName(type="text" value=org.orgDisplayName required)
      span.error.hide.orgname-taken
        | {{_ 'error-orgname-taken'}}
    label
      | {{_ 'description'}}
      input.js-orgDesc(type="text" value=org.orgDesc required)
    label
      | {{_ 'shortName'}}
      input.js-orgShortName(type="text" value=org.orgShortName required)
    label
      | {{_ 'autoAddUsersWithDomainName'}}
      input.js-orgAutoAddUsersWithDomainName(type="text" value=org.orgAutoAddUsersWithDomainName)
    label
      | {{_ 'website'}}
      input.js-orgWebsite(type="text" value=org.orgWebsite)
    label
      | {{_ 'active-org'}}
      select.select-active.js-org-isactive
        option(value="false") {{_ 'no'}}
        option(value="true" selected="{{org.orgIsActive}}") {{_ 'yes'}}
    hr
    //- Multitenancy option D (D.2 and D.9): the hostnames this Organization is
    //- served on, and the branding that replaces the instance branding on them.
    //- Only in effect when the deployment sets MULTITENANCY=true; empty means this
    //- Organization is not a tenant and nothing changes.
    h2.admin-pane-group-title {{_ 'org-tenant'}}
    label
      | {{_ 'org-domains'}}
      input.js-orgDomains(type="text" value=org.orgDomains placeholder="a.example.com, kanban.example.org")
      span.error.hide.orgdomain-taken
        | {{_ 'error-org-domain-taken'}}
    span.form-text.text-muted {{_ 'org-domains-description'}}
    label
      | {{_ 'custom-product-name'}}
      input.js-orgProductName(type="text" value=org.orgProductName)
    label
      | {{_ 'custom-login-logo-image-url'}}
      input.js-orgCustomLoginLogoImageUrl(type="text" value=org.orgCustomLoginLogoImageUrl)
    label
      | {{_ 'custom-login-logo-link-url'}}
      input.js-orgCustomLoginLogoLinkUrl(type="text" value=org.orgCustomLoginLogoLinkUrl)
    label
      | {{_ 'text-below-custom-login-logo'}}
      input.js-orgTextBelowCustomLoginLogo(type="text" value=org.orgTextBelowCustomLoginLogo)
    label
      | {{_ 'custom-top-left-corner-logo-image-url'}}
      input.js-orgCustomTopLeftCornerLogoImageUrl(type="text" value=org.orgCustomTopLeftCornerLogoImageUrl)
    label
      | {{_ 'custom-top-left-corner-logo-link-url'}}
      input.js-orgCustomTopLeftCornerLogoLinkUrl(type="text" value=org.orgCustomTopLeftCornerLogoLinkUrl)
    label
      | {{_ 'custom-help-link-url'}}
      input.js-orgCustomHelpLinkUrl(type="text" value=org.orgCustomHelpLinkUrl)
    label
      | {{_ 'custom-legal-notice-link-url'}}
      input.js-orgLegalNotice(type="text" value=org.orgLegalNotice)
    hr
    div.buttonsContainer
      input.primary.wide(type="submit" value="{{_ 'save'}}")

//- Multitenancy option D (D.7): the per-tenant Global Admins of one Organization.
//- Reached from the Organizations table's ⋯ menu, and it is the ONE place a tenant
//- is given an administrator - the site-wide Admin flag is edited where it always
//- was, in the user's own popup, and is never touched from here.
template(name="orgAdminsPopup")
  ul.pop-over-list
    li
      span.form-text.text-muted {{_ 'org-admins-description'}}
    if loading.get
      li
        | {{_ 'loading'}}
    else
      each member in members
        li
          a.js-toggle-org-admin(data-user-id="{{member._id}}")
            .materialCheckBox(class="{{#if member.isOrgAdmin}}is-checked{{/if}}")
            span  {{member.username}}
            if member.fullname
              span.quiet  ({{member.fullname}})
            if member.isSiteAdmin
              span.quiet  — {{_ 'admin'}}
      unless members.length
        li
          | {{_ 'no-items-message'}}
    if error.get
      li
        span.error {{error.get}}

