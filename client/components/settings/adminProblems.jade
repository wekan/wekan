template(name="adminProblems")
  .setting-content.admin-reports-content
    unless currentUser.isAdmin
      | {{_ 'error-notAuthorized'}}
    else
      .content-body
        +leftMenu(menuItems)

        .main-body
          //- Every Admin Panel pane opens with the same heading, and it is the
          //- open menu entry's own label (docs/Features/Page/Left-Menu.md).
          +paneTitle(paneTitleData)
          if showFileStatusAudit
            +fileStatusAudit
          if isPane 'report-recovery'
            +emailRecoveryReports
            +activityNotificationRecoveryReports
            +syncRuleEmailRecoveryReports
            +syncRecoveryReports
          if loading.get
            +spinner
          else if isPane 'report-summary'
            +problemsSummary
          else if isPane 'features-performance'
            +featuresPerformance
          else if isPane 'features-security'
            +featuresSecurity
          else if isPane 'features-delete'
            +featuresDelete
          else if isPane 'features-notifications'
            +featuresNotifications
          else if isPane 'report-security'
            +eventStreamReport(stream="security")
          else if isPane 'report-speed'
            +eventStreamReport(stream="speed")
          else if isPane 'report-tests'
            +eventStreamReport(stream="tests")
          else if isPane 'report-cpu'
            +eventStreamReport(stream="cpu")
          else if isPane 'report-instrumentation'
            +instrumentationReport
          else if isPane 'report-database'
            +eventStreamReport(stream="database")
          else if isPane 'report-integrity'
            +eventStreamReport(stream="integrity")
          else if isPane 'report-api'
            +eventStreamReport(stream="api")
          else if isPane 'report-office'
            +officeReport
          else if tablePageData
            +tablePage(tablePageData)

template(name="officeReport")
  //- Where people log in from, grouped. Through the shared table page like every
  //- other report here (docs/Features/Page/Table.md).
  +tablePage(tablePageData)

template(name="eventStreamReport")
  //- Security / Speed / Tests / CPU usage all render through the shared table
  //- page (docs/Features/Page/Table.md). CPU usage additionally passes the live
  //- figure as the status row between the title and the controls.
  +tablePage(tablePageData)

template(name="instrumentationReport")
  p.description Live measurements for this WeKan server process since startup. Refreshes every 5 seconds. Arguments, results, addresses and user identifiers are not stored. Values reset when the server restarts.
  if error
    p.error {{error}}
  else
    +tablePage(tablePageData)

template(name="instrumentationStatus")
  .admin-cpu-current
    span DDP connections: {{active}} active, {{opened}} opened, {{closed}} closed
    span.quiet  &middot; Started {{startedAt}}

template(name="cpuCurrentStatus")
  .admin-cpu-current(class="{{#if high}}admin-cpu-high{{/if}}")
    span.admin-cpu-label {{_ 'cpu-usage-current'}}
    span.admin-cpu-percent {{percent}}%
    span.quiet
      | {{cores}} {{_ 'cpu-cores-suffix'}} &middot; {{_ 'cpu-load-average'}} {{loadAverage}}
    if statistics
      span.quiet
        |  &middot; min/avg/max {{statistics.minimum}}%/{{statistics.average}}%/{{statistics.maximum}}%
        |  ({{statistics.samples}} samples, lowest {{statistics.lowestAt}})
    if activity
      span.quiet  &middot; {{activity}}

//- Performance, Security and Notifications. They were the whole of Admin Panel /
//- Features, which is gone; they are Problems panes now and live with the page that
//- renders them. Each is its own template so its helpers and handlers can live ON it -
//- Blaze resolves both against the template an element is IN, never an enclosing one.

