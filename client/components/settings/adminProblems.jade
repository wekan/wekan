//- Read-only storage diagnostics are shared by Files, Integrity and Recovery.
template(name="fileStatusAudit")
  section.file-status-audit(aria-label="File status checks")
    p Check file contents, database metadata and recovery evidence. No files or records are changed.
    .file-status-audit-actions
      button.js-file-audit-all(type="button" disabled=running) Check files and history
      button.js-file-audit-types(type="button" disabled=running) Check file types and extensions
      button.js-file-audit-inventory(type="button" disabled=running) Check missing and untracked files
      if running
        button.js-file-audit-cancel(type="button") Cancel check
      if result
        button.js-file-audit-download(type="button") Download status summary
    if error
      p(role="alert") {{error}}
    if result
      .file-status-audit-result(role="status" aria-live="polite")
        p {{statusText}}
        p {{countText}}
        if coverageText
          p {{coverageText}}
      if result.limitations
        details
          summary Coverage and limitations
          ul
            each result.limitations
              li {{this}}
      if totals
        ul
          each totals
            li {{kind}}: {{count}}
      details
        summary Storage directories
        ul
          each result.roots
            li {{path}} — {{status}} {{resolved}}
      if result.findings
        details
          summary Findings (bounded sample; full counts above)
          each findings
            pre {{this}}
      if result.omittedFindings
        p Additional findings not displayed: {{result.omittedFindings}}

template(name="syncRecoveryReports")
  section.sync-recovery-reports
    h2 {{_ 'sync-recovery-heading'}}
    p.quiet {{_ 'sync-recovery-description'}}
    if error
      p.error {{error}}
    +tablePage(tablePageData)

template(name="syncRecoveryReportRow")
  tr
    td {{started}}
    td
      p {{_ 'board'}}: {{boardId}}
      p {{_ 'list'}}: {{listId}}
    td {{_ statusLabel}}
    td
      details
        summary {{_ 'details'}}
        p.quiet {{_ 'sync-report-partial'}}
        if hasCounts
          p {{_ 'sync-preview-create'}}: {{created}}
          p {{_ 'sync-preview-update'}}: {{updated}}
          p {{_ 'sync-preview-archive'}}: {{archived}}
        each sourceRows
          p {{path}}: {{count}} — {{_ reasonLabel}}
        each normalizedRows
          p {{field}}: {{count}} — {{_ reasonLabel}}
        if coverage.source.truncated
          p {{_ 'sync-source-truncated'}}
          p {{_ 'sync-source-omitted'}}: {{coverage.source.omittedOccurrences}}
        p {{_ 'sync-preview-parser-warnings'}}: {{coverage.parserWarnings}}
        p {{_ 'sync-preview-parser-unsupported'}}: {{coverage.parserUnsupported}}

template(name="emailRecoveryReports")
  section.email-recovery-reports
    h2 {{_ 'email-recovery-heading'}}
    p.quiet {{_ 'email-recovery-description'}}
    if error
      p.error(role="alert") {{error}}
    if busy
      p.quiet {{_ 'email-recovery-saving'}}
    +tablePage(tablePageData)

template(name="emailRecoveryReportRow")
  tr(data-recipient=userId)
    td
      p {{username}}
      p.quiet {{userId}}
    td {{_ statusLabel}}
    td
      p {{_ 'email-recovery-queued'}}: {{queued}}
      p {{_ 'email-recovery-retrying'}}: {{retrying}}
      p {{_ 'email-recovery-stopped'}}: {{failed}}
      each failureRows
        p.quiet {{_ labelKey}}: {{count}}
      p {{_ 'email-recovery-attempts'}}: {{attempts}}
    td
      p {{_ 'email-recovery-oldest'}}: {{oldestText}}
      p {{_ 'email-recovery-next'}}: {{nextText}}
      if changedText
        p {{_ 'email-recovery-changed'}}: {{changedText}}
        p.quiet {{changedBy}}
    td
      if paused
        button.js-email-queue-action(type="button" data-action="resume" disabled=busy) {{_ 'email-recovery-resume'}}
      else
        button.js-email-queue-action(type="button" data-action="pause" disabled=busy) {{_ 'email-recovery-pause'}}
      if failed
        button.js-email-queue-action(type="button" data-action="retry" disabled=busy) {{_ 'email-recovery-retry'}}
      if queued
        button.js-email-queue-action(type="button" data-action="cancel" disabled=busy) {{_ 'email-recovery-cancel'}}


template(name="activityNotificationRecoveryReports")
  section.activity-notification-recovery-reports
    h2 {{_ 'activity-recovery-heading'}}
    p.quiet {{_ 'activity-recovery-description'}}
    if error
      p.error(role="alert") {{error}}
    if busy
      p.quiet {{_ 'activity-recovery-retrying'}}
    +tablePage(tablePageData)

template(name="activityNotificationRecoveryRow")
  tr(data-intent=intentId)
    td
      p {{activityId}}
      if cardId
        p.quiet {{_ 'card'}}: {{cardId}}
    td {{boardId}}
    td
      p {{_ statusLabel}}
      if showPaused
        p {{_ 'activity-recovery-paused'}}
    td {{createdText}}
    td
      button.js-cancel-activity-notification(type="button" disabled=controlDisabled) {{_ 'activity-recovery-cancel'}}
      button.js-control-activity-notification(type="button" disabled=controlDisabled) {{_ controlLabel}}
      button.js-retry-activity-notification(type="button" disabled=retryDisabled) {{_ 'activity-recovery-retry'}}


template(name="syncRuleEmailRecoveryReports")
  section.sync-rule-email-recovery-reports
    h2 {{_ 'rule-email-recovery-heading'}}
    p.quiet {{_ 'rule-email-recovery-description'}}
    label
      | {{_ 'status'}}
      select.js-rule-email-status
        option(value="all") {{_ 'rule-email-recovery-all'}}
        option(value="unconfirmed") {{_ 'rule-email-recovery-unconfirmed'}}
        option(value="sent") {{_ 'rule-email-recovery-sent'}}
    if error
      p.error(role="alert") {{error}}
    +tablePage(tablePageData)

template(name="syncRuleEmailRecoveryRow")
  tr(data-command=commandId)
    td.rule-email-recovery-identifiers
      p {{commandId}}
      p.quiet {{invocationId}}
      p.quiet {{attemptId}}
    td {{_ statusLabel}}
    td {{startedText}}
    td {{finishedText}}
