template(name='notification')
  li.notification(class="{{#if read}}read{{/if}}")
    .read-status
      .materialCheckBox(class="{{#if read}}is-checked{{/if}}")
      +notificationIcon(activityData)
    .details
      //- #5171: the clearly arranged layout (escaped by
        models/lib/notificationDelivery.js renderNotificationItem), or the
        classic activity line.
      if clearItem
        .notification-clear-item {{{clearItem}}}
      else
        +activity(activity=activityData mode='none')
      .notification-date
        small.quiet {{activityDate}}
    if read
      .remove
        a(title="{{_ 'delete'}}")
      i.fa.fa-trash
