template(name="activities")
  if showActivities
    .activities.js-sidebar-activities
      //- We should use Template.dynamic here but there is a bug with
      //- blaze-components: https://github.com/peerlibrary/meteor-blaze-components/issues/30
      if $eq mode "board"
        +boardActivities
      else
        +cardActivities

template(name="boardActivities")
  each activityData in boardActivitiesList
    +activity(activity=activityData card=card mode=mode)

template(name="cardActivities")
  each activityData in cardActivitiesList
    +activity(activity=activityData card=card mode=mode)

template(name="activity")
  .activity(id=activityDomId data-id=activity._id)
    +userAvatar(userId=activity.user._id)
    div.activity-desc
      span.activity-member
        +memberName(user=activity.user)

      //- attachment activity -------------------------------------------------
      if($eq activity.activityType 'deleteAttachment')
        | {{{activityMessage 'activity-delete-attach' cardLink}}}.

      if($eq activity.activityType 'addAttachment')
        | {{{activityMessage 'activity-attached' attachmentLink cardLink}}}.
        if($neq mode 'board')
          if activity.attachment.isImage
            img.attachment-image-preview(src=activity.attachment.url alt="")

      //- board activity ------------------------------------------------------
      if($eq activity.activityType 'createBoard')
        | {{{activityMessage 'activity-created' boardLabelLink}}}.

      if($eq activity.activityType 'importBoard')
        | {{{activityMessage 'activity-imported-board' boardLabelLink sourceLink}}}.

      if($eq activity.activityType 'addBoardMember')
        | {{{activityMessage 'activity-added' memberLink boardLabelLink}}}.

      if($eq activity.activityType 'removeBoardMember')
        | {{{activityMessage 'activity-excluded' memberLink boardLabelLink}}}.

      //- card activity -------------------------------------------------------
      if($eq activity.activityType 'createCard')
        if($eq mode 'card')
          | {{{activityMessage 'activity-added' cardLabelLink (activityValue activity.listName)}}}.
        else
          | {{{activityMessage 'activity-added' cardLabelLink boardLabelLink}}}.

      if($eq activity.activityType 'importCard')
        | {{{activityMessage 'activity-imported' cardLink boardLabelLink sourceLink}}}.

      if($eq activity.activityType 'moveCard')
        | {{{activityMessage 'activity-moved' cardLabelLink (activityValue activity.oldList.title) (activityValue activity.list.title)}}}.

      if($eq activity.activityType 'moveCardBoard')
        | {{{activityMessage 'activity-moved' cardLink (activityValue activity.oldBoardName) (activityValue activity.boardName)}}}.

      if($eq activity.activityType 'archivedCard')
        | {{{activityMessage 'activity-archived' cardLink}}}.

      if($eq activity.activityType 'restoredCard')
        | {{{activityMessage 'activity-sent' cardLink boardLabelLink}}}.

      //- checklist activity --------------------------------------------------
      if($eq activity.activityType 'addChecklist')
        | {{{activityMessage 'activity-checklist-added' cardLink}}}.
        if($eq mode 'card')
          .activity-checklist
            +viewer
              = activity.checklist.title
        else
          a.activity-checklist(href="{{ activity.card.originRelativeUrl }}")
            +viewer
              = activity.checklist.title

      if($eq activity.activityType 'removedChecklist')
        | {{{activityMessage 'activity-checklist-removed' cardLink}}}.

      if($eq activity.activityType 'completeChecklist')
        | {{{activityMessage 'activity-checklist-completed' (activityValue activity.checklist.title) cardLink}}}.

      if($eq activity.activityType 'uncompleteChecklist')
        | {{{activityMessage 'activity-checklist-uncompleted' (activityValue activity.checklist.title) cardLink}}}.

      if($eq activity.activityType 'checkedItem')
        | {{{activityMessage 'activity-checked-item' (activityValue checkItem) (activityValue activity.checklist.title) cardLink}}}.

      if($eq activity.activityType 'uncheckedItem')
        | {{{activityMessage 'activity-unchecked-item' (activityValue checkItem) (activityValue activity.checklist.title) cardLink}}}.

      if($eq activity.activityType 'addChecklistItem')
        | {{{activityMessage 'activity-checklist-item-added' (activityValue activity.checklist.title) cardLink}}}.
        .activity-checklist(href="{{ activity.card.originRelativeUrl }}")
          +viewer
            = activity.checklistItem.title

      if($eq activity.activityType 'removedChecklistItem')
        | {{{activityMessage 'activity-checklist-item-removed' (activityValue activity.checklist.title) cardLink}}}.

      //- comment activity ----------------------------------------------------
      if($eq activity.activityType 'deleteComment')
        | {{{activityMessage 'activity-deleteComment' (activityValue activity.commentDisplayText)}}}.

      if($eq activity.activityType 'editComment')
        | {{{activityMessage 'activity-editComment' (activityValue activity.commentDisplayText)}}}.

      if($eq activity.activityType 'addComment')
        | {{{activityMessage 'activity-on' cardLink}}}
        a.activity-comment(href="{{ activity.card.originRelativeUrl }}")
          +viewer
            = activity.comment.text

      //- date activity ------------------------------------------------
      if($eq activity.activityType 'a-receivedAt')
        | {{{activityMessage 'activity-receivedDate' (activityValue receivedDate) cardLink}}}.

      if($eq activity.activityType 'a-startAt')
        | {{{activityMessage 'activity-startDate' (activityValue startDate) cardLink}}}.

      if($eq activity.activityType 'a-dueAt')
        | {{{activityMessage 'activity-dueDate' (activityValue dueDate) cardLink}}}.

      if($eq activity.activityType 'a-endAt')
        | {{{activityMessage 'activity-endDate' (activityValue endDate) cardLink}}}.

      if($eq activity.activityType 'a-changedTitle')
        | {{{activityMessage 'activity-changedTitle' (activityValue activity.value) cardLink}}}.

      if($eq activity.activityType 'a-changedDescription')
        | {{{activityMessage 'activity-changedDescription' cardLink}}}.

      //- customField activity ------------------------------------------------
      if($eq activity.activityType 'createCustomField')
        | {{{activityMessage 'activity-customfield-created' (activityValue customField)}}}.

      if($eq activity.activityType 'setCustomField')
        | {{{activityMessage 'activity-set-customfield' (activityValue lastCustomField) (activityValue lastCustomFieldValue) cardLink}}}.

      if($eq activity.activityType 'unsetCustomField')
        | {{{activityMessage 'activity-unset-customfield' (activityValue lastCustomField) cardLink}}}.

      //- label activity ------------------------------------------------------
      if($eq activity.activityType 'addedLabel')
        | {{{labelActivityMessage 'activity-added-label' cardLink}}}.

      if($eq activity.activityType 'removedLabel')
        | {{{labelActivityMessage 'activity-removed-label' cardLink}}}.

      //- list activity -------------------------------------------------------
      if($neq mode 'card')
        if($eq activity.activityType 'createList')
          | {{{activityMessage 'activity-added' (activityValue listLabel) boardLabelLink}}}.

        if($eq activity.activityType 'importList')
          | {{{activityMessage 'activity-imported' (activityValue listLabel) boardLabelLink sourceLink}}}.

        if($eq activity.activityType 'removeList')
          | {{{activityMessage 'activity-removed' (activityValue activity.title) boardLabelLink}}}.

        if($eq activity.activityType 'archivedList')
          | {{{activityMessage 'activity-archived' (activityValue listLabel)}}}.

        if($eq activity.activityType 'changedListTitle')
          | {{{activityMessage 'activity-changedListTitle' (activityValue listLabel) boardLabelLink}}}

      //- member activity ----------------------------------------------------
      if($eq activity.activityType 'joinMember')
        if($eq user._id activity.member._id)
          | {{{activityMessage 'activity-joined' cardLink}}}.
        else
          | {{{activityMessage 'activity-added' memberLink cardLink}}}.

      if($eq activity.activityType 'unjoinMember')
        if($eq user._id activity.member._id)
          | {{{activityMessage 'activity-unjoined' cardLink}}}.
        else
          | {{{activityMessage 'activity-removed' memberLink cardLink}}}.

      //- swimlane activity --------------------------------------------------
      if($eq activity.activityType 'createSwimlane')
        | {{{activityMessage 'activity-added' (activityValue activity.swimlane.title) boardLabelLink}}}.

      if($eq activity.activityType 'archivedSwimlane')
        | {{{activityMessage 'activity-archived' (activityValue activity.swimlane.title)}}}.


      //- I don't understand this part ----------------------------------------
      if(currentData.timeKey)
        | {{_ activity.activityType }}
        = ' '
        i(title=currentData.timeValue).activity-meta {{ displayDate currentData.timeValue 'LLL' }}
        if (currentData.timeOldValue)
          = ' '
            | {{{activityMessage "previous_as" }}}
            = ' '
            i(title=currentData.timeOldValue).activity-meta {{ displayDate currentData.timeOldValue 'LLL' }}
        = ' @'
      else if(currentData.timeValue)
        | {{_ activity.activityType currentData.timeValue}}

      if($neq mode 'none')
        div(title=activity.createdAt).activity-meta
          //- Issue #4757: same permalink pattern as the comment timestamp in
          //- comments.jade - card URL + #activity-<id>, plus an explicit
          //- copy-to-clipboard icon.
          a.js-activity-permalink(href="{{ activityPermalink }}") {{ displayDate activity.createdAt }}
          a.js-copy-activity-link(title="{{_ 'copy-link-to-clipboard'}}")
            i.fa.fa-link
          span.copied-tooltip {{_ 'copied'}}
