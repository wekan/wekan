template(name="frappeGanttView")
  .gantt-view
    h2 {{_ 'board-view-gantt-frappe'}}
    .chart-export-buttons
      a.chart-export-button.js-export-chart(href="#" data-chart-key="gantt")
        i.fa.fa-share-square-o
        | {{_ 'export'}}
    if hasNoTasks
      p.frappe-gantt-empty {{_ 'no-cards-found'}}
    .js-frappe-gantt-container.frappe-gantt-container
