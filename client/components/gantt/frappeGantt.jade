template(name="frappeGanttView")
  .gantt-view
    h2 {{_ 'board-view-gantt-frappe'}}
    .chart-export-buttons
      a.chart-export-button(href="{{ frappeGanttExportUrl 'PDF' }}" target="_blank" rel="noopener")
        i.fa.fa-file-pdf-o
        | Export to PDF
      a.chart-export-button(href="{{ frappeGanttExportUrl 'Excel' }}" target="_blank" rel="noopener")
        i.fa.fa-file-excel-o
        | Export to Excel
    if hasNoTasks
      p.frappe-gantt-empty {{_ 'no-cards-found'}}
    .js-frappe-gantt-container.frappe-gantt-container
