//- Gantt Chart View Template
//- gantt.css/ganttCard.css/boardCharts.css are already loaded through the
//- normal bundler import (client/features/gantt.js, client/features/boards.js)
//- - a runtime <link> to their raw source path here served text/html (a 404
//- fallback, not real CSS) and was pure console noise on every Gantt page
//- load.
template(name="ganttView")
  .gantt-view
    h2 {{_ 'board-view-gantt'}}
    .chart-export-buttons
      a.chart-export-button.js-export-chart(href="#" data-chart-key="gantt")
        i.fa.fa-share-square-o
        | {{_ 'export'}}
    if hasSelectedCard
      +ganttCard(selectedCard)
    each weeks
      table.gantt-table
        thead
          tr
            th {{_ 'task'}} {{_ 'predicate-week'}} {{week}}
            each weekDays this
              th
                | {{formattedDate .}} {{weekdayLabel .}}
        tbody
          each cardsInWeek this
            tr(data-card-id="{{cardId .}}")
              td.js-gantt-task-cell
                a.js-gantt-card-title(href="#")
                  +viewer
                    | {{cardTitle .}}
              each weekDays ..
                td(class="{{cellClasses .. .}}" data-card-id="{{cardId ..}}" data-date-type="{{cellContentClass .. .}}")
                  i.fa(class="{{cellContent .. .}}")
