//- There is no pencil beside the board's name any more: the NAME renames the
//- board. It is one target instead of a word and an icon that did the same
//- thing, and the icon was the smaller of the two. client/components/main/header.jade
//-
//- Everything else the board's second header bar held, as icons in the FIRST
//- bar, to the left of the notification bell.
//-
//- ICON ONLY, each named by a tooltip. The bar is a single row shared with the
//- logo, the starred boards, the view menu, the bell and the user menu, and
//- these are ten more controls - labelled, they would not fit at any width.
//-
//- There is no desktop/mobile split any more either. The second bar wrote the
//- whole set out TWICE, once for each, because a labelled row does not fit on a
//- phone; icons do, so one set serves both. docs/Features/Page/Header.md
template(name="boardHeaderButtons")
  if currentBoard
    if currentUser
      .board-header-btns.board-header-controls
        //- The board's controls fold into one caret at the leading edge of the
          group - left of the lock in a left-to-right page, right of it in Arabic,
          because the caret's direction comes from the same rule as every other
          one. Folded, the seven controls after it are gone; open, they are back.
          The buttons a board's own Rules put in this bar are NOT folded away with
          them: somebody added those to this board on purpose.
          client/lib/foldState.js
        a.board-header-btn.js-toggle-fold(data-fold="board-controls"
          title="{{#if isFoldOpen 'board-controls'}}{{_ 'collapse'}}{{else}}{{_ 'uncollapse'}}{{/if}}" role="button" tabindex="0")
          i.fa(class="{{foldCaret 'board-controls'}}")
        if isFoldOpen 'board-controls'
          with currentBoard
            a.board-header-btn(
              class="{{#if currentUser.isBoardAdmin}}js-change-visibility{{else}}is-disabled{{/if}}"
              title="{{_ currentBoard.permission}}")
              i.fa(class="{{#if currentBoard.isPublic}}fa-globe{{else}}fa-lock{{/if}}")
              //- The SAME expression the tooltip uses, so the two cannot say
                different things - and both follow the board from Private to
                Public without a second list of words to keep in step.
              span.board-header-btn-label {{_ currentBoard.permission}}

            unless watchDisabled
              a.board-header-btn.js-watch-board(title="{{_ watchLevel }}")
                if $eq watchLevel "watching"
                  i.fa.fa-eye
                if $eq watchLevel "tracking"
                  i.fa.fa-bell
                if $eq watchLevel "muted"
                  i.fa.fa-bell-slash
                span.board-header-btn-label {{_ watchLevel }}

            //- The name beside the icon where the bar has room for it, dropped
              when it does not - one rule in header.css hides every label of this
              bar below the width they stop fitting at.
              docs/Features/Page/Header.md
            a.board-header-btn(title="{{#if isSortActive}}{{_ 'sort-is-on'}}{{else}}{{_ 'sort-cards'}}{{/if}}" class="js-sort-cards {{#if isSortActive }}emphasis{{/if}}")
              i.fa.fa-sort
              span.board-header-btn-label {{#if isSortActive}}{{_ 'sort-is-on'}}{{else}}{{_ 'sort-cards'}}{{/if}}
            if isSortActive
              a.board-header-btn-close.js-sort-reset(title="{{_ 'remove-sort'}}")
                i.fa.fa-times-thin

        +boardButtons

        if isFoldOpen 'board-controls'
          a.board-header-btn.js-open-filter-view(
              title="{{#if Filter.isActive}}{{_ 'filter-on-desc'}}{{else}}{{_ 'filter'}}{{/if}}"
              class="{{#if Filter.isActive}}js-filter-active{{/if}}")
            i.fa.fa-filter
            span.board-header-btn-label {{#if Filter.isActive}}{{_ 'filter-on-desc'}}{{else}}{{_ 'filter'}}{{/if}}
          if Filter.isActive
            a.board-header-btn-close.js-filter-reset(title="{{_ 'filter-clear'}}")
              i.fa.fa-times-thin

          a.board-header-btn.js-open-search-view(title="{{_ 'search'}}")
            i.fa.fa-search
            span.board-header-btn-label {{_ 'search'}}

          a.board-header-btn.js-toggle-dependencies(
              title="{{#if currentBoard.showDependencies}}{{_ 'hide-dependencies'}}{{else}}{{_ 'show-dependencies'}}{{/if}}"
              class="{{#if currentBoard.showDependencies}}emphasis{{/if}}")
            i.fa.fa-link
            span.board-header-btn-label {{#if currentBoard.showDependencies}}{{_ 'hide-dependencies'}}{{else}}{{_ 'show-dependencies'}}{{/if}}

          if canModifyBoard
            a.board-header-btn.js-multiselection-activate(
                title="{{#if MultiSelection.isActive}}{{_ 'multi-selection-on'}}{{else}}{{_ 'multi-selection'}}{{/if}}"
                class="{{#if MultiSelection.isActive}}emphasis{{/if}}")
              i.fa.fa-check-square-o
              //- Named, like the board's Multi-Selection on All Boards: a
                check-box outline says nothing about what the button does.
              span.board-header-btn-label {{_ 'multi-selection'}}
            if MultiSelection.isActive
              a.board-header-btn-close.js-multiselection-reset(title="{{_ 'multi-selection-off'}}")
                i.fa.fa-times-thin
    else
      a.board-header-btn.js-log-in(title="{{_ 'log-in'}}")
        i.fa.fa-sign-in

//- `described-list`: every row is icon + name + description, and the three are laid
//- out as three left-aligned columns (popup.css), so the descriptions of all the
//- rows start at the same x whether or not a row carries the check mark.
template(name="boardVisibilityList")
  ul.pop-over-list.described-list
    li
      with "private"
        a.js-select-visibility
          i.fa.fa-lock
          | {{_ 'private'}}
          if visibilityCheck
            i.fa.fa-check
          span.sub-name {{privateDesc}}
    if notAllowPrivateVisibilityOnly
      li
        with "public"
          a.js-select-visibility
            i.fa.fa-globe
            | {{_ 'public'}}
            if visibilityCheck
              i.fa.fa-check
            span.sub-name {{publicDesc}}

