//- The All Boards right sidebar.
//-
//- The board sidebar (client/components/sidebar/) is built around a board - its
//- members, labels, activities and settings - and All Boards has no board, so
//- this is its own. What it borrows is the SHELL: the same
//- `.board-sidebar.sidebar` classes, the same `.sidebar-actions` row with the ✕,
//- the same `.sidebar-content` with a title and a back arrow above the view. So
//- it looks and behaves like the one on a board without pretending to be it.
//-
//- docs/Features/Page/Search.md, docs/Features/Page/Multi-Selection.md

template(name="allBoardsSidebar")
  //- The theme class goes on an ANCESTOR of `.sidebar`, never on it: every
    themed sidebar rule is a DESCENDANT selector -
    `.board-color-belize .sidebar .sidebar-content .sidebar-btn` - so a class on
    the sidebar element itself matches nothing at all, which is how the first
    attempt at this left the buttons white on light grey anyway. On a board the
    class sits on a container around the sidebar; this is that container.

    It wraps ONLY the sidebar, so the theme cannot bleed into the board icons
    behind it. It is out of flow (the sidebar inside is fixed), so it costs no
    layout.
  .all-boards-sidebar-theme(class="{{themeClass}}")
    .board-sidebar.sidebar.all-boards-sidebar(class="{{#if isSidebarOpen}}is-open{{/if}}")
      .sidebar-actions
        a.sidebar-xmark.js-close-all-boards-sidebar(aria-label="{{_ 'close'}}") &#10005;
      .sidebar-content.js-all-boards-sidebar-content
        //- A title and a back arrow on every view EXCEPT home, which is where
          back would go - exactly as the board sidebar does it.
        if sidebarViewTitle
          h2
            a.fa.fa-arrow-left.js-all-boards-sidebar-home(aria-label="{{_ 'go-back'}}")
            = sidebarViewTitle
        if isSidebarOpen
          +Template.dynamic(template=sidebarViewTemplate)

//- What the hamburger opens: the page's own menu, the counterpart of
//- `homeSidebar` on a board.
template(name="allBoardsHomeSidebar")
  //- Sort, which was a button in this page's second header bar. The VIEW menu
    was too, and it is in the first top header bar instead - a view menu says
    what you are looking at, which belongs beside the page's name rather than
    behind a panel you have to open. Search and Multi-Selection were in that bar
    as well and are NOT repeated here: this view has offered both as rows since
    it was written. docs/Features/Page/All-Boards.md
  a.sidebar-btn.js-open-boards-sort(class="{{#unless isBoardsSort 'custom'}}emphasis{{/unless}}")
    i.fa.fa-sort
    span {{_ 'sort-boards'}}
  hr
  ul.sidebar-list
    li
      a.js-all-boards-sidebar-search
        i.fa.fa-search
        span.sidebar-list-item-description {{_ 'search-boards'}}
    if canMultiSelectBoards
      li
        a.js-all-boards-sidebar-multiselection
          i.fa.fa-check-square-o
          span.sidebar-list-item-description {{_ 'multi-selection'}}
  hr
  //- "Export all boards" (server/routes/exportAllBoards.js): every board you
    can export, in one format, in one download.
  a.sidebar-btn.js-export-all-boards
    i.fa.fa-download
    span {{_ 'export-all-boards'}}
  //- Archived boards had a handler in the header bar and no button to reach it.
  a.sidebar-btn.js-open-archived-board
    i.fa.fa-archive
    span {{_ 'archived-boards'}}

template(name="allBoardsSearchSidebar")
  //- The SAME term the page filters by, so the board list behind the sidebar
    narrows as you type - which is what the search field in the header bar did
    before this became a sidebar view.
  input.js-board-search-input(
    type="text"
    aria-label="{{_ 'search-boards'}}"
    value="{{boardSearch}}"
    autofocus
    autocomplete="off"
    dir="auto")
  if boardSearch
    a.sidebar-btn.js-board-search-clear
      i.fa.fa-times
      span {{_ 'filter-clear'}}

//- The actions on a selection, as sidebar rows - the same place a board puts
//- them. They were four icons crowded into the header bar; here each one has
//- its name beside it.
template(name="allBoardsMultiSelectionSidebar")
  if isArchiveSelection
    if canPermanentlyDeleteArchivedBoards
      p.sidebar-multiselection-hint {{_ 'multi-selection-active'}}
      button.sidebar-btn.negate.wide.js-delete-selected-boards(type="button")
        i.fa.fa-trash
        span {{_ 'delete'}}
    else
      p.sidebar-multiselection-hint {{_ 'archive-permanent-delete-disabled-hint'}}
  else
    p.sidebar-multiselection-hint {{_ 'multi-selection-active'}}
    a.sidebar-btn.js-star-selected
      i.fa.fa-star
      span {{selectedStarTitle}}
    a.sidebar-btn.js-home-selected
      i.fa.fa-home
      if isHomeSelection
        span {{_ 'unset-selected-home'}}
      else
        span {{_ 'set-selected-home'}}
    unless isHomeSelection
      hr
      a.sidebar-btn.js-archive-selected-boards
        i.fa.fa-archive
        span {{_ 'archive-board'}}
      a.sidebar-btn.js-duplicate-selected-boards
        i.fa.fa-clipboard
        span {{_ 'duplicate-board'}}
      a.sidebar-btn.js-export-selected-boards
        i.fa.fa-download
        span {{_ 'export-selected-boards'}}
  hr
  a.sidebar-btn.js-multiselection-reset
    i.fa.fa-times-thin
    span {{_ 'multi-selection-off'}}

template(name="duplicateSelectedBoardsPopup")
  form.js-duplicate-boards-form
    .duplicate-board-selection-actions
      button.primary.js-copy-select-all(type="button" disabled=copyBusy) {{_ 'select-all'}}
      button.primary.js-copy-select-none(type="button" disabled=copyBusy) {{_ 'select-none'}}
    ul.pop-over-list.export-scope-select
      each copyFields
        li
          a.flex.js-copy-field-toggle(href="#" data-field=key role="checkbox" aria-checked="{{checked}}" aria-disabled="{{copyBusy}}")
            .materialCheckBox(class="{{#if checked}}is-checked{{/if}}")
            span {{_ label}}
    if copyError
      p.warning(role="alert") {{copyError}}
    button.primary(type="submit" disabled=copyBusy) {{_ 'duplicate-board'}}
    button.js-copy-cancel(type="button" disabled=copyBusy) {{_ 'cancel'}}

//- The formats "Export all boards" offers, each a download of every board (or
//- of the selected ones): Excel as one workbook with a sheet per board, every
//- other format as a .zip with a file per board.
template(name="exportAllBoardsPopup")
  p.quiet {{_ 'export-all-boards-hint'}}
  ul.pop-over-list
    each formats
      li
        a.export-all-boards-format(href="{{url}}" download="{{filename}}" rel="noopener")
          i.fa.fa-download
          |  {{label}}
