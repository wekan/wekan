//- The All Boards right sidebar.
//-
//- The board sidebar (client/components/sidebar/) is built around a board - its
//- members, labels, activities and settings - and All Boards has no board, so
//- this is its own. What it borrows is the SHELL: the same
//- `.board-sidebar.sidebar` classes, the same `.sidebar-actions` row with the ✕,
//- the same `.sidebar-content` with a title and a back arrow above the view. So
//- it looks and behaves like the one on a board without pretending to be it.
//-
//- docs/Design/Page/Search.md, docs/Design/Page/Multi-Selection.md

template(name="allBoardsSidebar")
  .board-sidebar.sidebar.all-boards-sidebar(class="{{#if isSidebarOpen}}is-open{{/if}}")
    .sidebar-actions
      a.sidebar-xmark.js-close-all-boards-sidebar(aria-label="{{_ 'close'}}") &#10005;
    .sidebar-content.js-all-boards-sidebar-content
      //- A title and a back arrow on every view EXCEPT home, which is where
        back would go - exactly as the board sidebar does it.
      if sidebarViewTitle
        h2
          a.fa.fa-arrow-left.js-all-boards-sidebar-home(aria-label="{{_ 'go-back'}}")
          = sidebarViewTitle
      if isSidebarOpen
        +Template.dynamic(template=sidebarViewTemplate)

//- What the hamburger opens: the page's own menu, the counterpart of
//- `homeSidebar` on a board.
template(name="allBoardsHomeSidebar")
  ul.sidebar-list
    li
      a.js-all-boards-sidebar-search
        i.fa.fa-search
        span.sidebar-list-item-description {{_ 'search-boards'}}
    if canModifyBoards
      li
        a.js-all-boards-sidebar-multiselection
          i.fa.fa-check-square-o
          span.sidebar-list-item-description {{_ 'multi-selection'}}
  hr
  //- Archived boards had a handler in the header bar and no button to reach it.
  a.sidebar-btn.js-open-archived-board
    i.fa.fa-archive
    span {{_ 'archived-boards'}}

template(name="allBoardsSearchSidebar")
  //- The SAME term the page filters by, so the board list behind the sidebar
    narrows as you type - which is what the search field in the header bar did
    before this became a sidebar view.
  input.js-board-search-input(
    type="text"
    aria-label="{{_ 'search-boards'}}"
    value="{{boardSearch}}"
    autofocus
    autocomplete="off"
    dir="auto")
  if boardSearch
    a.sidebar-btn.js-board-search-clear
      i.fa.fa-times
      span {{_ 'filter-clear'}}

//- The actions on a selection, as sidebar rows - the same place a board puts
//- them. They were four icons crowded into the header bar; here each one has
//- its name beside it.
template(name="allBoardsMultiSelectionSidebar")
  if hasBoardsSelected
    a.sidebar-btn.js-star-selected
      i.fa.fa-star
      span {{selectedStarTitle}}
    a.sidebar-btn.js-home-selected
      i.fa.fa-home
      span {{_ 'set-selected-home'}}
    hr
    a.sidebar-btn.js-archive-selected-boards
      i.fa.fa-archive
      span {{_ 'archive-board'}}
    a.sidebar-btn.js-duplicate-selected-boards
      i.fa.fa-clipboard
      span {{_ 'duplicate-board'}}
    hr
    a.sidebar-btn.js-multiselection-reset
      i.fa.fa-times-thin
      span {{_ 'multi-selection-off'}}
  else
    p.sidebar-multiselection-hint {{_ 'multi-selection-active'}}
