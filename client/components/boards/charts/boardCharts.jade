template(name="boardChartView")
  .stats-view
    .stats-view-content.chart-view-content
      h1.stats-view-title {{ chartTitle }}
      .chart-export-buttons
        a.chart-export-button(href="{{ exportUrl 'PDF' }}" target="_blank" rel="noopener")
          i.fa.fa-file-pdf-o
          | Export to PDF
        a.chart-export-button(href="{{ exportUrl 'Excel' }}" target="_blank" rel="noopener")
          i.fa.fa-file-excel-o
          | Export to Excel

      if isLoading
        p.stats-view-placeholder-note {{_ 'loading'}}
      else if hasNoData
        p.stats-view-placeholder-note {{_ 'no-results'}}
      else
        .chart-canvas-wrapper
          canvas.js-chart-canvas

        table.stats-view-table.chart-data-table
          thead
            tr
              each header in tableHeaders
                th {{ header }}
          tbody
            each row in tableRows
              tr
                each cell in row
                  td {{ cell }}
