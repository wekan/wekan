template(name="roadmapView")
  .gantt-view.roadmap-view
    h2 {{_ 'board-view-roadmap'}}
    if hasCustomFields
      .roadmap-field-picker
        label.roadmap-field-picker-label(for="roadmapFieldSelect") {{_ 'roadmap-group-by'}}
        select#roadmapFieldSelect.js-roadmap-field-select
          each customFieldOptions
            option(value="{{_id}}" selected="{{isSelected _id}}") {{name}}
      if hasGroups
        each groups
          .roadmap-row
            h3.roadmap-row-heading {{label}} ({{cards.length}})
            .js-roadmap-gantt-container.roadmap-gantt-container(data-group-key="{{key}}")
      else
        p.roadmap-empty {{_ 'roadmap-no-cards'}}
    else
      p.roadmap-empty {{_ 'roadmap-empty-no-custom-fields'}}
