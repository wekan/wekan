//- The body of an export popup: what to include, then the two downloads that
  include it. Used by the board, swimlane and list export popups with a
  different scope each (#1173) - see exportScope.js.
template(name="exportScopeBody")
  p.quiet {{_ 'export-select-what-to-include'}}
  ul.pop-over-list
    li(class="{{#if cardDetailsChecked}}active{{/if}}")
      a.js-export-card-details-toggle(href="#")
        i.fa.fa-check
        | {{_ 'export-card-details'}}
    each exportFields
      li(class="{{#if checked}}active{{/if}}")
        a.js-export-field-toggle(data-field="{{field}}" href="#")
          i.fa.fa-check
          | {{_ label}}
  hr
  ul.pop-over-list
    li
      a(href="{{exportUrlPDF}}", download="{{exportFilenamePDF}}")
        i.fa.fa-file-pdf-o
        | {{_ 'export'}} / PDF
    li
      a(href="{{exportUrlExcel}}", download="{{exportFilenameExcel}}")
        i.fa.fa-file-excel-o
        | {{_ 'export'}} / Excel
    li
      a(href="{{exportUrlJson}}", download="{{exportFilenameJson}}")
        i.fa.fa-file-code-o
        | {{_ 'export'}} / JSON
    li
      a(href="{{exportUrlJsonNoAttachments}}", download="{{exportFilenameJson}}")
        i.fa.fa-file-code-o
        | {{_ 'export'}} / JSON ({{_ 'export-board-without-attachments'}})
    li
      a(href="{{exportUrlZip}}", download="{{exportFilenameZip}}")
        i.fa.fa-file-archive-o
        | {{_ 'export'}} / .zip ({{_ 'attachments'}})
  //- #1173: the same popup, the other direction. The checkboxes above say what
    goes OUT of an export and what comes IN from an import - one selection, so
    "no comments" means the same thing whichever way the file is moving.
  if canImport
    hr
    p.quiet {{_ 'import-here-instruction'}}
    ul.pop-over-list
      li
        label.js-import-file-label
          i.fa.fa-download
          | {{_ 'import'}} / JSON, .zip
          input.js-import-file(type="file" accept=".json,application/json,.zip,application/zip" hidden)
    if importBusy
      p.quiet {{_ 'importing'}}
    if importError
      .warning {{_ importError}}
    if importDone
      p.quiet {{_ 'import-done'}} {{importDone}}

template(name="exportSwimlanePopup")
  +exportScopeBody(swimlaneId=_id title=title)

template(name="exportListPopup")
  +exportScopeBody(listId=_id title=title)

template(name="exportChecklistPopup")
  +exportScopeBody(checklistId=_id title=title)
