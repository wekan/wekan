template(name="scrumView")
  .scrum-view(class=boardColor)
    header.scrum-toolbar
      h2 {{viewTitle}}
      button.js-scrum-refresh {{_ 'refresh'}}
      button.js-scrum-history {{_ 'history'}}
      if isReport
        a.button.js-export-chart(data-chart-key=chartKey data-report-options=reportOptions) {{_ 'export'}}
    if error
      p.warning(role="alert") {{error}}
    if loading
      p(role="status") {{_ 'loading'}}
    else
      if data
        if data.importPending
          p.warning.scrum-import-pending(role="alert") {{_ 'scrum-import-pending'}}
          if data.canRecoverImport
            p {{_ 'scrum-import-recovery-hint'}}
            button.js-scrum-resume-import(type="button" disabled=busy) {{_ 'scrum-import-resume'}}
            button.js-scrum-discard-import(type="button" disabled=busy) {{_ 'scrum-import-discard'}}
        if data.importLosses.length
          details.scrum-import-report
            summary {{_ 'import'}}
            each data.importLosses
              p {{lossText}}
        if data.partial
          p(role="status" class="scrum-partial-report") {{_ 'scrum-partial-report'}}
        if historyJob
          .scrum-background-job.js-scrum-history-job(aria-live="polite")
            if historyJob.failed
              p.warning {{_ 'scrum-history-job-failed'}} {{historyJob.error}}
            else
              p {{_ 'scrum-history-job-running' done=historyJob.done total=historyJob.total}}
              .scrum-progress
                .scrum-progress-bar(style=historyJob.style)
        if canAdmin
          details.scrum-settings(open=settingsOpen)
            summary {{_ 'scrum-settings'}}
            form.js-scrum-settings
              label
                input(type="checkbox" name="enabled" checked=settings.enabled)
                | {{_ 'scrum-enabled'}}
              label {{_ 'scrum-product-goal'}}
                textarea(name="productGoal") {{settings.productGoal}}
              label {{_ 'scrum-definition-of-done'}}
                textarea(name="definitionOfDone") {{settings.definitionOfDone}}
              each accountabilityFields
                label {{label}}
                  select(name=field multiple=multiple)
                    unless multiple
                      option(value="") —
                    each options
                      option(value=value selected=selected) {{label}}
              label {{_ 'scrum-working-days'}}
                select(name="workingDays" multiple required)
                  each workingDayOptions
                    option(value=value selected=selected) {{label}}
              label {{_ 'scrum-estimate-source'}}
                select(name="estimateSource")
                  each estimateSources
                    option(value=value selected=selected) {{label}}
              label {{_ 'custom-field'}}
                select(name="estimateCustomFieldId")
                  option(value="") —
                  each estimateFields
                    option(value=_id selected=selected) {{name}}
              label {{_ 'scrum-estimate-unit'}}
                textarea(name="estimateUnit" rows="1" maxlength="80") {{settings.estimateUnit}}
              label {{_ 'scrum-completion-policy'}}
                select(name="completionPolicy")
                  each completionPolicies
                    option(value=value selected=selected) {{label}}
              button.primary(type="submit" disabled=busy) {{_ 'save'}}
          details.scrum-transfer-import
            summary {{_ 'scrum-import-into-board'}}
            p {{_ 'scrum-import-into-board-hint'}}
            input.js-scrum-transfer-file(type="file" accept=".json,application/json")
            button.js-scrum-transfer-preview(type="button" disabled=busy) {{_ 'scrum-import-preview'}}
            with transferPreview
              .scrum-transfer-preview(role="status")
                if changed
                  p.js-scrum-transfer-done {{_ 'scrum-import-into-board-done'}}
                p {{_ 'scrum-import-preview-sprints' created=sprints.created.length matched=sprints.matched.length skipped=sprints.skipped.length}}
                p {{_ 'scrum-import-preview-releases' created=releases.created.length matched=releases.matched.length skipped=releases.skipped.length}}
                p {{_ 'scrum-import-preview-cards' updated=cards.updated unchanged=cards.unchanged unmatched=cards.unmatched}}
                if nothingToDo
                  p.js-scrum-transfer-nothing {{_ 'scrum-import-preview-nothing'}}
                each losses
                  p.scrum-transfer-loss {{lossText}}
                if canApply
                  button.primary.js-scrum-transfer-apply(type="button" disabled=busy) {{_ 'import'}}
        if isVelocity
          +scrumReportTable(rows=velocity velocity=true)
        else
          if isSprints
            .scrum-planning
              section
                h3 {{_ 'scrum-sprints'}}
                label {{_ 'scrum-sprint'}}
                  select.js-scrum-sprint
                    option(value="") —
                    each sprintOptions
                      option(value=_id selected=selected) {{name}} ({{stateLabel}})
                if selectedSprint
                  p {{selectedSprint.goal}}
                  p {{selectedSprint.stateLabel}}
                  if rolloverProgress
                    .scrum-background-job.js-scrum-rollover-progress(aria-live="polite")
                      p {{_ 'scrum-rollover-progress' done=rolloverProgress.done total=rolloverProgress.total}}
                      .scrum-progress
                        .scrum-progress-bar(style=rolloverProgress.style)
                  if canAdmin
                    .scrum-toolbar
                      if sprintPlanned
                        button.primary.js-scrum-start(disabled=busy) {{_ 'scrum-start-sprint'}}
                      if sprintNeedsCloseRecovery
                        if rolloverError
                          p.warning.js-scrum-rollover-error {{rolloverError}}
                        button.primary.js-scrum-resume-close(disabled=busy) {{_ 'scrum-resume-close'}}
                      if sprintActive
                        label {{_ 'scrum-rollover-sprint'}}
                          select.js-scrum-rollover
                            option(value="") {{_ 'scrum-product-backlog'}}
                            each rolloverOptions
                              option(value=_id) {{name}}
                        button.primary.js-scrum-close(disabled=busy) {{_ 'scrum-close-sprint'}}
                      if sprintOpen
                        label {{_ 'scrum-cancel-reason'}}
                          textarea.js-scrum-cancel-reason(rows="1")
                        button.js-scrum-cancel(disabled=busy) {{_ 'scrum-cancel-sprint'}}
                if canAdmin
                  details
                    summary {{_ 'scrum-edit-sprint'}}
                    form.js-scrum-sprint-form
                      label {{_ 'name'}}
                        textarea(name="name" required maxlength="200" rows="1") {{selectedSprint.name}}
                      label {{_ 'scrum-sprint-goal'}}
                        textarea(name="goal") {{selectedSprint.goal}}
                      label {{_ 'start'}}
                        input(type="date" name="plannedStart" value=sprintStart)
                      label {{_ 'end'}}
                        input(type="date" name="plannedEnd" value=sprintEnd)
                      label {{_ 'scrum-capacity'}}
                        input(type="number" name="capacity" min="0" step="any" value=selectedSprint.capacity)
                      label {{_ 'scrum-estimate-unit'}}
                        textarea(name="capacityUnit" rows="1") {{selectedSprint.capacityUnit}}
                      button.primary(type="submit" disabled=busy) {{_ 'save'}}
                      button.js-scrum-new(type="button") {{_ 'scrum-new-sprint'}}
              section
                h3 {{_ 'scrum-releases'}}
                each releases
                  article
                    h4 {{name}} — {{stateLabel}}
                    p.scrum-release-scope(data-release-id=_id) {{_ 'scrum-release-scope'}}: {{scopeLabel}}
                    p.scrum-release-done(data-release-id=_id) {{_ 'scrum-completed'}}: {{doneLabel}}
                    p {{goal}}
                    p {{startLabel}} — {{endLabel}}
                    if releasedAt
                      p {{_ 'scrum-released-at'}}: {{releasedLabel}}
                    pre {{notes}}
                if canAdmin
                  label {{_ 'scrum-release'}}
                    select.js-scrum-release-select
                      option(value="") {{_ 'add'}}
                      each releaseOptions
                        option(value=_id selected=selected) {{name}}
                  form.js-scrum-release
                    label {{_ 'name'}}
                      textarea(name="name" required maxlength="200" rows="1") {{selectedRelease.name}}
                    label {{_ 'scrum-product-goal'}}
                      textarea(name="goal") {{selectedRelease.goal}}
                    label {{_ 'start'}}
                      input(type="date" name="plannedStart" value=releaseStart)
                    label {{_ 'end'}}
                      input(type="date" name="plannedEnd" value=releaseEnd)
                    label {{_ 'status'}}
                      select(name="state")
                        each releaseStates
                          option(value=value selected=selected) {{label}}
                    label {{_ 'scrum-released-at'}}
                      input(type="datetime-local" name="releasedAt" step="any" value=releaseDate)
                    label {{_ 'scrum-notes'}}
                      textarea(name="notes") {{selectedRelease.notes}}
                    button.primary(type="submit" disabled=busy) {{_ 'save'}}
          if isSprintReport
            label {{_ 'scrum-sprint'}}
              select.js-scrum-sprint
                option(value="") —
                each sprintOptions
                  option(value=_id selected=selected) {{name}}
            if selectedSprint
              +scrumReportTable(rows=sprintReportRows)
              +scrumDailyHistory(sprintId=selectedSprint._id)
              +scrumScopeHistory(sprintId=selectedSprint._id)
            else
              p {{_ 'scrum-select-sprint'}}
          else
            h3 {{_ 'scrum-backlog'}}
            p {{_ 'scrum-backlog-help'}}
            .scrum-table-scroll
              table.scrum-table
                thead
                  tr
                    th {{_ 'card'}}
                    th {{_ 'scrum-estimate'}}
                    th {{_ 'scrum-sprint'}}
                    th {{_ 'scrum-backlog-rank'}}
                    th {{_ 'scrum-release'}}
                    th {{_ 'actions'}}
                tbody
                  each cards
                    tr(data-card-id=_id)
                      td
                        a(href=cardUrl) {{title}}
                      td {{estimateLabel}}
                      td {{sprintName}}
                      td {{rankLabel}}
                      td.scrum-card-release {{releaseName}}
                      td
                        if canWrite
                          form.js-scrum-card(data-card-id=_id)
                            label {{_ 'scrum-sprint'}}
                              select(name="sprintId")
                                option(value="") {{_ 'scrum-product-backlog'}}
                                each assignmentOptions
                                  option(value=_id selected=selected) {{name}}
                            label {{_ 'scrum-backlog-rank'}}
                              input(type="number" name="backlogRank" min="0" step="any" value=rankValue)
                            label {{_ 'scrum-release'}}
                              select(name="releaseIds" multiple)
                                each cardReleaseOptions
                                  option(value=_id selected=selected) {{name}}
                              small.scrum-multiple-help {{_ 'scrum-releases-select-help'}}
                            label {{_ 'scrum-issue-type'}}
                              textarea(name="issueType" rows="1") {{scrum.issueType}}
                            label {{_ 'scrum-acceptance-criteria'}}
                              textarea(name="acceptanceCriteria") {{scrum.acceptanceCriteria}}
                            button.primary(type="submit" disabled=busy) {{_ 'save'}}
                  else
                    tr
                      td(colspan="6") {{_ 'no-cards'}}
            if hiddenCards
              button.js-scrum-show-more(type="button") {{showMoreLabel}}
            if isSprints
              if selectedSprint
                h3 {{_ 'scrum-events'}}
                each events
                  article
                    h4 {{name}}
                    p {{kindLabel}} — {{dateLabel}}
                    p {{_ 'scrum-timebox'}}: {{timeboxMinutes}}
                    pre {{notes}}
                    each followUps
                      p
                        a(href=url) {{title}}
                if canAdmin
                  label {{_ 'scrum-events'}}
                    select.js-scrum-event-select
                      option(value="") {{_ 'add'}}
                      each eventOptions
                        option(value=_id selected=selected) {{label}}
                  form.js-scrum-event
                    label {{_ 'scrum-event-kind'}}
                      select(name="kind")
                        each eventKinds
                          option(value=value selected=selected) {{label}}
                    label {{_ 'name'}}
                      textarea(name="name" required maxlength="200" rows="1") {{selectedEvent.name}}
                    label {{_ 'date'}}
                      input(type="datetime-local" name="startsAt" step="any" required value=eventStart)
                    label {{_ 'scrum-timebox'}}
                      input(type="number" name="timeboxMinutes" min="0" max="10080" value=eventTimebox)
                    label {{_ 'scrum-notes'}}
                      textarea(name="notes") {{selectedEvent.notes}}
                    label {{_ 'scrum-follow-up-cards'}}
                      select(name="followUpCardIds" multiple)
                        each followUpCards
                          option(value=_id selected=selected) {{title}}
                    button.primary(type="submit" disabled=busy) {{_ 'save'}}

template(name="scrumReportTable")
  if rows.length
    label
      | {{_ 'cards'}} / {{_ 'scrum-estimate'}}
      select.js-scrum-chart-metric
        option(value="count") {{_ 'cards'}}
        option(value="estimate") {{_ 'scrum-estimate'}}
    each chartGroups
      section.scrum-chart
        p {{unit}} — {{sourceLabel}} — {{policyLabel}}
        each rows
          figure.scrum-chart-row
            figcaption
              strong {{name}}
              if partial
                p {{_ 'scrum-partial-snapshot'}}
            each series
              .scrum-chart-series
                span.scrum-chart-label {{label}}: {{value}}
                .scrum-chart-track(aria-hidden="true")
                  .scrum-chart-bar(class=key style="width: {{width}}%")
                small {{formatTotal total}}
  .scrum-table-scroll
    table.scrum-table
      thead
        tr
          th {{_ 'scrum-sprint'}}
          th {{_ 'scrum-estimate-unit'}}
          th {{_ 'scrum-committed'}}
          th {{_ 'scrum-completed'}}
          th {{_ 'scrum-added'}}
          th {{_ 'scrum-removed'}}
          th {{_ 'scrum-incomplete'}}
          th {{_ 'scrum-working-days'}}
      tbody
        each rows
          tr
            td
              | {{name}}
              if partial
                p {{_ 'scrum-partial-snapshot'}}
            td {{unit}}
            td {{formatTotal committed}}
            td {{formatTotal completed}}
            td {{formatTotal added}}
            td {{formatTotal removed}}
            td {{formatTotal incomplete}}
            td.scrum-working-days {{workingDaysLabel}}
        else
          tr
            td(colspan="8") {{_ 'scrum-no-closed-sprints'}}
  p {{_ 'scrum-report-help'}}
