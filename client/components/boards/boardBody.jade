template(name="board")

  if isConverting
    +boardConversionProgress
  else if isBoardReady
    if currentBoard
      if onlyShowCurrentCard
        +cardDetails(currentCard)
      else
        +boardBody
    else
      //-- XXX We need a better error message in case the board has been archived
      +message(label="board-not-found")
      //-- | {{goHome}}
  else
    +spinner

template(name="boardBody")
  if notDisplayThisBoard
   | {{_ 'tableVisibilityMode-allowPrivateOnly'}}
  else
    // Debug information (remove in production)
    if debugBoardState
      .debug-info(style="position: fixed; top: 0; inset-inline-start: 0; background: rgba(0,0,0,0.8); color: white; padding: 10px; z-index: 9999; font-size: 12px;")
        | {{_ 'board'}}: {{currentBoard.title}} | {{_ 'view'}}: {{boardView}} | {{_ 'has-swimlanes'}}: {{hasSwimlanes}} | {{_ 'swimlanes'}}: {{currentBoard.swimlanes.length}}
    .board-wrapper(class="{{themeColorClass}}" class="{{#if isMiniScreen}}mobile-view{{/if}}")
      .board-canvas.js-swimlanes.dragscroll(
        class="{{#if Sidebar.isOpen}}is-sibling-sidebar-open{{/if}}"
        class="{{#if MultiSelection.isActive}}is-multiselection-active{{/if}}"
        class="{{#if draggingActive}}is-dragging-active{{/if}}"
        class="{{#unless isVerticalScrollbars}}no-scrollbars{{/unless}}"
        class="{{#if isMiniScreen}}mobile-view{{/if}}")
        if currentBoard.showDependencies
          +dependencyOverlay
        if showOverlay
          .board-overlay
        if currentBoard.isTemplatesBoard
          each currentBoard.swimlanes
            +swimlane(this)
        else if isViewSwimlanes
          if hasSwimlanes
            each currentBoard.swimlanes
              +swimlane(this)
          else
            // Fallback: If no swimlanes exist, show lists instead of empty message
            +listsGroup(currentBoard)
        else if isViewLists
          +listsGroup(currentBoard)
        else if isViewCalendar
          +calendarView
        else if isViewMultiboardCalendar
          +multiboardCalendarView
        else if isViewGantt
          +ganttView
        else if isViewGanttFrappe
          +frappeGanttView
        else if isViewGanttDhtmlx
          +dhtmlxGanttView
        else if isViewTable
          +tableView
        else if isViewStats
          +statsView
        else if isViewTime
          +timeView
        else if isViewGroupByAssignee
          +groupByAssigneeView
        else if isViewRoadmap
          +roadmapView
        else if isViewDashboard
          +dashboardView
        else if isViewBigboard
          +bigboardView
        else if isViewBurndown
          +burndownView
        else if isViewBurnup
          +burnupView
        else if isViewCumulativeFlow
          +cumulativeFlowView
        else if isViewControlChart
          +controlChartView
        else if isViewCycleTime
          +cycleTimeView
        else if isViewFlowEfficiency
          +flowEfficiencyView
        else if isViewLeadTime
          +leadTimeView
        else if isViewThroughputHistogram
          +throughputHistogramView
        else if isViewWipRun
          +wipRunView
        else if isViewPulse
          +pulseView
        else
          // Default view - show swimlanes if they exist, otherwise show lists
          if hasSwimlanes
            each currentBoard.swimlanes
              +swimlane(this)
          else
            +listsGroup(currentBoard)
      //- Render multiple open cards in desktop mode
      unless isMiniScreen
        each openCards
          +cardDetails(this cardIndex=@index)
      +sidebar

template(name="calendarView")
  if isViewCalendar
    .calendar-view.swimlane.dragscroll
      if currentCard
        +cardDetails(currentCard)
      +fullcalendar(calendarOptions)