//- The Rules page had its own sidebar, holding only Back and its views. It uses
  the board's own right sidebar now, like the board itself: its views are in
  Board Settings under Rules (client/components/sidebar/sidebar.jade), and a
  board view picked in the Board View menu goes back to the board.
  models/lib/pageSidebar.js
template(name="rulesMain")
  .wrapper
    .rules-page(class=currentBoard.colorClass)
      //- #2217: who may edit sees every view; a member a board shows its Rules
        to reads the rules list and rule details, with no control that
        changes a rule; anybody else sees nothing (client/lib/rulesAccess.js).
      if($eq rulesAccess 'edit')
        if($eq rulesCurrentTab.get 'rulesList')
          if isWorkflowView
            +rulesWorkflow
          else if isBotsView
            +rulesBots
          else if isBlocksView
            +rulesBlocks
          else if isRulesHistoryView
            +historyTable(scope="board" scopeId=rulesBoardId group="rules")
          else
            +ruleSuggestions
            +rulesList
        if($eq rulesCurrentTab.get 'trigger')
          +rulesTriggers(ruleName=ruleName triggerVar=triggerVar ruleId=editingRuleId)
        if($eq rulesCurrentTab.get 'action')
          +rulesActions(ruleName=ruleName triggerVar=triggerVar ruleId=editingRuleId)
        if($eq rulesCurrentTab.get 'ruleDetails')
          +ruleDetails(ruleId=ruleId)
      else if($eq rulesAccess 'read')
        if($eq rulesCurrentTab.get 'ruleDetails')
          +ruleDetails(ruleId=ruleId)
        else
          +rulesList
      else
        p.quiet {{_ 'r-rules-not-shown'}}
    +sidebar
