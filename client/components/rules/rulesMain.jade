template(name="rulesControls")
  //- The controls of this page. They were a group in its second header bar,
    beside a title the first bar now carries; they are a view of the shared
    page sidebar. models/lib/pageSidebar.js, docs/Features/Page/Header.md
  a.board-header-btn.js-rules-back-to-board(title="{{_ 'back'}}")
    i.fa.fa-arrow-left
    | {{_ 'board'}}
  a.board-header-btn.js-rules-list-view(title="{{_ 'r-list-view'}}")
    i.fa.fa-list
    | {{_ 'r-list-view'}}
  a.board-header-btn.js-rules-toggle-view(title="{{_ 'r-workflow-view'}}")
    i.fa.fa-sitemap
    | {{_ 'r-workflow-view'}}
  a.board-header-btn.js-rules-blocks-view(title="{{_ 'r-blocks-view'}}")
    i.fa.fa-puzzle-piece
    | {{_ 'r-blocks-view'}}
  a.board-header-btn.js-rules-history(title="{{_ 'history'}}")
    i.fa.fa-history
    | {{_ 'history'}}
  a.board-header-btn.js-rules-import-export(title="{{_ 'r-import-export'}}")
    i.fa.fa-exchange
    | {{_ 'r-import-export'}}

template(name="rulesMain")
  .wrapper
    .rules-page(class=currentBoard.colorClass)
      if($eq rulesCurrentTab.get 'rulesList')
        if isWorkflowView
          +rulesWorkflow
        else if isBlocksView
          +rulesBlocks
        else if isRulesHistoryView
          +historyTable(scope="board" scopeId=rulesBoardId group="rules")
        else
          +rulesList
      if($eq rulesCurrentTab.get 'trigger')
        +rulesTriggers(ruleName=ruleName triggerVar=triggerVar ruleId=editingRuleId)
      if($eq rulesCurrentTab.get 'action')
        +rulesActions(ruleName=ruleName triggerVar=triggerVar ruleId=editingRuleId)
      if($eq rulesCurrentTab.get 'ruleDetails')
        +ruleDetails(ruleId=ruleId)
