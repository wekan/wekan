template(name="rulesList")
  .rules(class=currentBoard.colorClass)
    h2
      i.fa.fa-magic
      | {{_ 'r-board-rules' }}

    if rules.length
      .rules-toolbar
        button.primary.js-rules-select-all(type="button")
          i.fa.fa-check-square-o
          | {{_ 'r-select-all'}}
        button.primary.js-rules-select-none(type="button")
          i.fa.fa-square-o
          | {{_ 'r-unselect-all'}}
        if canAdmin
          button.primary.js-rules-delete-selected(type="button")
            i.fa.fa-trash
            | {{_ 'r-delete-selected'}}
        button.primary.js-rules-export-selected(type="button")
          i.fa.fa-download
          | {{_ 'r-export-selected'}}

    ul.rules-list
      each rules
        li.rules-lists-item
          input.js-rule-select(type="checkbox" data-rule-id="{{_id}}" checked=isSelected)
          p
            if isEditing
              input.js-edit-rule-input(type=text value="{{title}}" autofocus)
            else
              = title
          div.rules-btns-group
            button.primary.wide.js-goto-details(type="submit" data-rule-id="{{_id}}")
              i.fa.fa-eye
              | {{_ 'r-view-rule'}}
            if canAdmin
              button.primary.wide.js-toggle-rule-enabled(type="submit" data-rule-id="{{_id}}" title="{{_ 'r-toggle-rule-enabled'}}")
                if isEnabled
                  i.fa.fa-toggle-on
                  | {{_ 'r-rule-enabled'}}
                else
                  i.fa.fa-toggle-off
                  | {{_ 'r-rule-disabled'}}
              button.primary.wide.js-edit-rule(type="submit" data-rule-id="{{_id}}")
                i.fa.fa-pencil
                | {{_ 'r-edit-rule'}}
              button.primary.wide.js-edit-rule-full(type="submit" data-rule-id="{{_id}}")
                i.fa.fa-sliders
                | {{_ 'r-edit-rule-trigger-action'}}
              button.primary.wide.js-delete-rule(type="submit" data-rule-id="{{_id}}")
                i.fa.fa-trash
                | {{_ 'r-delete-rule'}}
      else
        li.no-items-message {{_ 'r-no-rules' }}
    if canAdmin
      div.rules-add
        button.primary.wide.rules-add-trigger.js-goto-trigger(type="submit")
          i.fa.fa-plus
          | {{_ 'r-add-rule'}}
        input(type=text,placeholder="{{_ 'r-new-rule-name' }}",id="ruleTitle")
        p.rules-field-error-message.js-rule-title-error.hide-element {{_ 'r-rule-title-required'}}
