template(name="boardActions")
  div.trigger-item
    div.trigger-content
      div.trigger-text
        | {{_'r-move-card-to'}}
      div.trigger-dropdown
        select(id="move-gen-action")
          option(value="top") {{_'r-top-of'}}
          option(value="bottom") {{_'r-bottom-of'}}
      div.trigger-text
        | {{_'r-its-list'}}
    button.trigger-button.js-add-gen-move-action.js-goto-rules(type="button" aria-label="{{_ 'r-add-action'}}")
      i.fa.fa-plus(aria-hidden="true")

  div.trigger-item(data-editor-scope)
    div.trigger-content
      div.trigger-text
        | {{_'r-move-card-to'}}
      div.trigger-dropdown
        select(id="move-spec-action")
          option(value="top") {{_'r-top-of'}}
          option(value="bottom") {{_'r-bottom-of'}}
      div.trigger-text
        | {{_'r-the-board'}}
      div.trigger-dropdown
        select(id="board-id")
          option(value="" disabled selected if=not boards.length) {{loadingBoardsLabel}}
          each boards
            if $eq _id currentBoard._id
              option(value="{{_id}}" selected) {{_ 'current'}}
            else
              option(value="{{_id}}") {{title}}
      div.trigger-text
        | {{_'r-in-list'}}
      div.trigger-dropdown
        textarea(rows="2" data-editor-submit=".js-goto-action, .js-goto-rules" id="listName",placeholder="{{_'r-name'}}")
      div.trigger-text
        | {{_'r-in-swimlane'}}
      div.trigger-dropdown
        textarea(rows="2" data-editor-submit=".js-goto-action, .js-goto-rules" id="swimlaneName",placeholder="{{_'r-name'}}")
    button.trigger-button.js-add-spec-move-action.js-goto-rules(type="button" aria-label="{{_ 'r-add-action'}}")
      i.fa.fa-plus(aria-hidden="true")

  div.trigger-item
    div.trigger-content
      div.trigger-dropdown
        select(id="arch-action")
          option(value="archive") {{_'r-archive'}}
          option(value="unarchive") {{_'r-unarchive'}}
      div.trigger-text
        | {{_'r-card'}}
    button.trigger-button.js-add-arch-action.js-goto-rules(type="button" aria-label="{{_ 'r-add-action'}}")
      i.fa.fa-plus(aria-hidden="true")

  div.trigger-item(data-editor-scope)
    div.trigger-content
      div.trigger-text
        | {{_'r-add-swimlane'}}
      div.trigger-dropdown
        textarea(rows="2" data-editor-submit=".js-goto-action, .js-goto-rules" id="swimlane-name",placeholder="{{_'r-name'}}")
    button.trigger-button.js-add-swimlane-action.js-goto-rules(type="button" aria-label="{{_ 'r-add-action'}}")
      i.fa.fa-plus(aria-hidden="true")

  div.trigger-item(data-editor-scope)
    div.trigger-content
      div.trigger-text
        | {{_'r-create-card'}}
      div.trigger-dropdown
        textarea(rows="2" data-editor-submit=".js-goto-action, .js-goto-rules" id="card-name",placeholder="{{_'r-name'}}")
      div.trigger-text
        | {{_'r-in-list'}}
      div.trigger-dropdown
        textarea(rows="2" data-editor-submit=".js-goto-action, .js-goto-rules" id="list-name",placeholder="{{_'r-name'}}")
      div.trigger-text
        | {{_'r-in-swimlane'}}
      div.trigger-dropdown
        textarea(rows="2" data-editor-submit=".js-goto-action, .js-goto-rules" id="swimlane-name2",placeholder="{{_'r-name'}}")
    button.trigger-button.js-create-card-action.js-goto-rules(type="button" aria-label="{{_ 'r-add-action'}}")
      i.fa.fa-plus(aria-hidden="true")

  div.trigger-item(data-editor-scope)
    div.trigger-content
      div.trigger-text
        | {{_'r-link-card'}}
      div.trigger-text
        | {{_'r-the-board'}}
      div.trigger-dropdown
        select(id="board-id-link")
          option(value="" disabled selected if=not boards.length) {{loadingBoardsLabel}}
          each boards
            if $eq _id currentBoard._id
              option(value="{{_id}}" selected) {{_ 'current'}}
            else
              option(value="{{_id}}") {{title}}
      div.trigger-text
        | {{_'r-in-list'}}
      div.trigger-dropdown
        textarea(rows="2" data-editor-submit=".js-goto-action, .js-goto-rules" id="listName-link",placeholder="{{_'r-name'}}")
      div.trigger-text
        | {{_'r-in-swimlane'}}
      div.trigger-dropdown
        textarea(rows="2" data-editor-submit=".js-goto-action, .js-goto-rules" id="swimlaneName-link",placeholder="{{_'r-name'}}")
    button.trigger-button.js-link-card-action.js-goto-rules(type="button" aria-label="{{_ 'r-add-action'}}")
      i.fa.fa-plus(aria-hidden="true")

  div.trigger-item(data-editor-scope)
    div.trigger-content
      div.trigger-text
        | {{_'r-sort-list'}}
      div.trigger-dropdown
        textarea(rows="2" data-editor-submit=".js-goto-action, .js-goto-rules" id="sort-list-name",placeholder="{{_'r-list-name'}}")
      div.trigger-text
        | {{_'r-sort-by'}}
      div.trigger-dropdown
        select(id="sort-field")
          option(value="due") {{_'r-sort-due'}}
          option(value="name") {{_'r-sort-name'}}
            option(value="created") {{_'createdAt'}}
            option(value="modified") {{_'modifiedAt'}}
    button.trigger-button.js-sort-list-action.js-goto-rules(type="button" aria-label="{{_ 'r-add-action'}}")
      i.fa.fa-plus(aria-hidden="true")

  div.trigger-item(data-editor-scope)
    div.trigger-content
      div.trigger-text
        | {{_'r-move-all-cards'}}
      div.trigger-dropdown
        textarea(rows="2" data-editor-submit=".js-goto-action, .js-goto-rules" id="moveall-from-list",placeholder="{{_'r-list-name'}}")
      div.trigger-text
        | {{_'r-in-list'}}
      div.trigger-dropdown
        textarea(rows="2" data-editor-submit=".js-goto-action, .js-goto-rules" id="moveall-to-list",placeholder="{{_'r-list-name'}}")
    button.trigger-button.js-move-all-cards-action.js-goto-rules(type="button" aria-label="{{_ 'r-add-action'}}")
      i.fa.fa-plus(aria-hidden="true")






