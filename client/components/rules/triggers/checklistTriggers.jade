    button.trigger-button.js-add-gen-comp-trigger.js-goto-action(type="button" aria-label="{{_ 'r-add-trigger'}}")
      i.fa.fa-plus(aria-hidden="true")

  div.trigger-item(data-editor-scope)
    div.trigger-content
      unless ruleNameBeforeSubject
