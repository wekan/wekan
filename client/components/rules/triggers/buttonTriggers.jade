template(name="buttonTriggers")
  div.trigger-item#trigger-button(data-editor-scope)
    div.trigger-content
      div.trigger-text
        | {{_'r-button-label'}}
      div.trigger-dropdown
        textarea#button-label(rows="2" data-editor-submit=".js-goto-action, .js-goto-rules" placeholder="{{_'r-button-label'}}")
      div.trigger-dropdown
        select#button-type.js-button-type
          option(value="card" selected="selected") {{_'r-card-button'}}
          option(value="board") {{_'r-board-button'}}
    button.trigger-button.js-add-button-trigger.js-goto-action(type="button" aria-label="{{_ 'r-add-trigger'}}")
      i.fa.fa-plus(aria-hidden="true")
