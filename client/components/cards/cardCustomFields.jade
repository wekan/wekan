//- The card's custom fields, from the hamburger at the end of the Custom Fields
  heading: every field the BOARD has, with a tick when it is on this card, a
  pencil to edit the field itself, and - under a rule - the one that makes a new
  one. Everything about custom fields, in the place they are shown.
//-
//- Edit and Add open in this same pop-over, on top of this list, so the back
  arrow returns to it. They are the board's own forms
  (client/components/sidebar/sidebarCustomFields.jade), not second copies.
template(name="cardCustomFieldsPopup")
    ul.pop-over-list
        each customFields
            li.item
                a.name.js-select-field(href="#" title="{{_ 'show-field-on-card'}}")
                    //- The same animated checkbox used by Admin Panel /
                      Settings / Announcement: the square itself morphs into
                      the green tick through forms.css.
                    .materialCheckBox(class="{{#if hasCustomField}}is-checked{{/if}}")
                    span.full-name
                      = name
                a.js-edit-custom-field(title="{{_ 'edit'}}" aria-label="{{_ 'edit'}}")
                    i.fa.fa-pencil-square-o(aria-hidden="true")
    //- The rule separates the list above from "Add custom field" below - with
      no custom field yet, there is nothing above it to separate from.
    if customFields.length
        hr
    a.quiet-button.full.js-open-create-custom-field
        i.fa.fa-plus
        span {{_ 'createCustomField'}}
    //- #5681: this card's fields linked, by name, to another card's.
    a.quiet-button.full.js-open-custom-field-links
        i.fa.fa-link
        span {{_ 'custom-field-links'}}

//- #5681: the cards this card's custom fields are linked to, and the form that
  links one more - a pasted card link (Copy card link gives one) or one of this
  board's cards found by its title - with the direction the values go.
  server/models/customFieldLinks.js decides who may link and what is carried.
template(name="cardCustomFieldLinksPopup")
    .custom-field-links
        p.quiet {{_ 'custom-field-links-hint'}}
        if fieldLinksLoading
            p.quiet {{_ 'loading'}}
        else
            unless fieldLinks.length
                p.quiet.js-custom-field-links-empty {{_ 'custom-field-links-none'}}
        ul.pop-over-list.js-custom-field-links
            each fieldLinks
                li.custom-field-link(data-card-id="{{cardId}}")
                    if unavailable
                        span.quiet {{_ 'custom-field-link-unavailable'}}
                    else
                        a.custom-field-link-card(href="{{url}}") {{title}}
                        span.quiet  {{boardTitle}} / {{listTitle}}
                        div.custom-field-link-mode {{_ modeLabel}}
                        if fields.length
                            div.custom-field-link-fields {{_ 'custom-field-link-fields'}} {{fieldNames}}
                        else
                            div.quiet.custom-field-link-fields {{_ 'custom-field-link-no-fields'}}
                        unless active
                            div.warning.custom-field-link-inactive {{_ 'custom-field-link-inactive'}}
                    if canLinkFields
                        a.js-unlink-custom-fields(data-card-id="{{cardId}}" title="{{_ 'custom-field-unlink'}}" aria-label="{{_ 'custom-field-unlink'}}")
                            i.fa.fa-chain-broken(aria-hidden="true")
                            span  {{_ 'custom-field-unlink'}}
        if canLinkFields
            hr
            form.js-link-custom-fields-form
                label(for="custom-field-link-input") {{_ 'custom-field-link-target'}}
                input.js-custom-field-link-input#custom-field-link-input(type="text" autocomplete="off")
                ul.pop-over-list.custom-field-link-matches
                    each fieldLinkMatches
                        li
                            a.js-custom-field-link-match(data-card-id="{{_id}}") {{title}}
                label(for="custom-field-link-mode") {{_ 'custom-field-link-direction'}}
                select.js-custom-field-link-mode#custom-field-link-mode
                    option(value="both") {{_ 'custom-field-link-both'}}
                    option(value="send") {{_ 'custom-field-link-send'}}
                if fieldLinkError
                    p.warning.js-custom-field-link-error {{_ fieldLinkError}}
                button.primary.js-link-custom-fields-submit(type="submit") {{_ 'custom-field-link-add'}}

template(name="cardCustomField")
    h3.card-details-item-title.js-edit-card-custom-field-value(
      class="{{#if canModifyCard}}is-editable{{/if}}"
      title="{{#if canModifyCard}}{{_ 'edit'}}{{/if}}"
      role="{{#if canModifyCard}}button{{/if}}"
      tabindex="{{#if canModifyCard}}0{{else}}-1{{/if}}")
        i.fa.fa-list
        = definition.name
    +Template.dynamic(template=getTemplate)

template(name="customFieldCopyButton")
    span.custom-field-copy-control
        a.fa.fa-copy.js-copy-custom-field(title="{{_ 'copy-text-to-clipboard'}}")
        span.copied-tooltip {{_ 'copied'}}

template(name="cardCustomField-text")
    if canModifyCard
        +inlinedForm(classNames="js-card-customfield-text")
            +customFieldCopyButton(value=editValue)
            +editor(autofocus=true hideCopy=true)
                = editValue
            .edit-controls.clearfix
                button.primary(type="submit") {{_ 'save'}}
                a.fa.fa-times-thin.js-close-inlined-form(title="{{_ 'close'}}")
        else
            button.js-open-inlined-form.js-custom-field-edit-trigger(type="button" hidden)
            a.js-edit-card-custom-field-value(title="{{_ 'edit'}}" aria-label="{{_ 'edit'}}")
                if value
                    +viewer
                        = value
                else
                    i.fa.fa-pencil-square-o(aria-hidden="true")
    else
      +viewer
        = value


template(name="cardCustomField-number")
    if canModifyCard
        +inlinedForm(classNames="js-card-customfield-number")
            +customFieldCopyButton(value=editValue)
            input(type="number" value=editValue)
            .edit-controls.clearfix
                button.primary(type="submit") {{_ 'save'}}
                a.fa.fa-times-thin.js-close-inlined-form(title="{{_ 'close'}}")
        else
            button.js-open-inlined-form.js-custom-field-edit-trigger(type="button" hidden)
            a.js-edit-card-custom-field-value(title="{{_ 'edit'}}" aria-label="{{_ 'edit'}}")
                if formattedValue
                    = formattedValue
                else
                    i.fa.fa-pencil-square-o(aria-hidden="true")
    else
        if formattedValue
            = formattedValue

template(name="cardCustomField-checkbox")
  //- This is a persisted card value, not a checklist item and not the
    Custom Fields menu's visibility toggle. Keep its own event hook so no
    generic checklist handler can interpret the click.
  if canModifyCard
    +inlinedForm(classNames="js-card-customfield-checkbox-editor")
      +customFieldCopyButton(value=editValue)
      label.check-box-container
        input.js-card-customfield-checkbox-input(type="checkbox" checked=editValue)
        .check-box.materialCheckBox(class="{{#if editValue}}is-checked{{/if}}")
      .edit-controls.clearfix
        button.primary(type="submit") {{_ 'save'}}
        a.fa.fa-times-thin.js-close-inlined-form(title="{{_ 'close'}}")
    else
      button.js-open-inlined-form.js-custom-field-edit-trigger(type="button" hidden)
      .js-card-custom-field-checkbox.js-edit-card-custom-field-value.checklist-item(
        class="{{#if value}}is-checked{{/if}}" title="{{_ 'edit'}}"
        aria-label="{{_ 'edit'}}" role="button" tabindex="0")
        .check-box-container
          .check-box.materialCheckBox(class="{{#if value}}is-checked{{/if}}")
  else
    .materialCheckBox(class="{{#if value}}is-checked{{/if}}")

template(name="cardCustomField-currency")
    if canModifyCard
        +inlinedForm(classNames="js-card-customfield-currency")
            +customFieldCopyButton(value=editValue)
            input(type="text" value=editValue autofocus)
            .edit-controls.clearfix
                button.primary(type="submit") {{_ 'save'}}
                a.fa.fa-times-thin.js-close-inlined-form(title="{{_ 'close'}}")
        else
            button.js-open-inlined-form.js-custom-field-edit-trigger(type="button" hidden)
            a.js-edit-card-custom-field-value(title="{{_ 'edit'}}" aria-label="{{_ 'edit'}}")
                if value
                    = formattedValue
                else
                    i.fa.fa-pencil-square-o(aria-hidden="true")
    else
        if value
            = formattedValue

template(name="cardCustomField-date")
    if canModifyCard
      a.js-edit-date.js-custom-field-edit-trigger(title="{{#if value}}{{showTitle}} {{_ 'predicate-week'}} {{#if showWeekOfYear}}{{showWeek}}{{/if}}{{else}}{{_ 'edit'}}{{/if}}" aria-label="{{_ 'edit'}}" class="{{classes}}")
        if value
          div.card-date
            time(datetime="{{showISODate}}")
              | {{showDate}}
              if showWeekOfYear
                b
                  | {{showWeek}}
        else
          i.fa.fa-pencil-square-o(aria-hidden="true")
    else
      if value
        div.card-date
          time(datetime="{{showISODate}}")
            | {{showDate}}
            if showWeekOfYear
                b
                | {{showWeek}}

template(name="cardCustomField-datePopup")
  +editDateForm(showDate=showDate showTime=showTime error=error datePicker=datePicker customFieldCopyValue=value customFieldControls=true)

template(name="cardCustomField-dropdown")
    if canModifyCard
        +inlinedForm(classNames="js-card-customfield-dropdown")
            +customFieldCopyButton(value=selectedItem)
            select.inline
                each items
                    if isSelectedItem _id
                        option(value=_id selected="selected")
                          +viewer
                            = name
                    else
                        option(value=_id)
                          +viewer
                            = name
            .edit-controls.clearfix
                button.primary(type="submit") {{_ 'save'}}
                a.fa.fa-times-thin.js-close-inlined-form(title="{{_ 'close'}}")
        else
            button.js-open-inlined-form.js-custom-field-edit-trigger(type="button" hidden)
            a.js-edit-card-custom-field-value(title="{{_ 'edit'}}" aria-label="{{_ 'edit'}}")
                if value
                    +viewer
                        = selectedItem
                else
                    i.fa.fa-pencil-square-o(aria-hidden="true")
    else
        if value
            +viewer
                = selectedItem

template(name="cardCustomField-dropdownMultiSelect")
    if canModifyCard
        +inlinedForm(classNames="js-card-customfield-dropdown-multi-select")
            +customFieldCopyButton(value=selectedNames)
            each items
                a.flex.js-card-customfield-dropdown-multi-item(data-id=_id class="{{#if isChecked _id}}is-checked{{/if}}")
                    .materialCheckBox(class="{{#if isChecked _id}}is-checked{{/if}}")
                    +viewer
                        = name
            .edit-controls.clearfix
                button.primary(type="submit") {{_ 'save'}}
                a.fa.fa-times-thin.js-close-inlined-form(title="{{_ 'close'}}")
        else
            button.js-open-inlined-form.js-custom-field-edit-trigger(type="button" hidden)
            a.js-edit-card-custom-field-value(title="{{_ 'edit'}}" aria-label="{{_ 'edit'}}")
                if value.length
                    +viewer
                        = selectedNames
                else
                    i.fa.fa-pencil-square-o(aria-hidden="true")
    else
        if value.length
            +viewer
                = selectedNames

template(name="cardCustomField-stringtemplate")
    if canModifyCard
        +inlinedForm(classNames="js-card-customfield-stringtemplate")
            +customFieldCopyButton(value=formattedValue)
            each item in stringtemplateItems.get
                input.js-card-customfield-stringtemplate-item(type="text" value=item placeholder="")
            input.js-card-customfield-stringtemplate-item.last(type="text" value="" placeholder="{{_ 'custom-field-stringtemplate-item-placeholder'}}" autofocus)
            .edit-controls.clearfix
                button.primary(type="submit") {{_ 'save'}}
                a.fa.fa-times-thin.js-close-inlined-form(title="{{_ 'close'}}")
        else
            button.js-open-inlined-form.js-custom-field-edit-trigger(type="button" hidden)
            a.js-edit-card-custom-field-value(title="{{_ 'edit'}}" aria-label="{{_ 'edit'}}")
                if value
                    +viewer
                        = formattedValue
                else
                    i.fa.fa-pencil-square-o(aria-hidden="true")
    else
        if value
            +viewer
                = formattedValue
