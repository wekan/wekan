template(name="cardDetailsPopup")
  +cardDetails(popupCard)

template(name="cardDetails")

  +attachmentViewer

  //- `card-details-with-handle` when drag handles are on, the same class the
    minicard carries for the same reason: with a handle, the title is all edit
    target; without one, half of it is what the window is dragged by.
    client/components/cards/cardDetails.css
  section.card-details.js-card-details.nodragscroll(
    class='{{#if cardMaximized}}card-details-maximized{{/if}}'
    class='{{#if isPopup}}card-details-popup{{/if}}'
    class='{{#unless isVerticalScrollbars}}no-scrollbars{{/unless}}'
    class='{{#if cardCollapsed}}card-details-collapsed{{/if}}'
    class='{{#if isTouchScreenOrShowDesktopDragHandles}}card-details-with-handle{{/if}}'
    role="region" tabindex="0" aria-label="{{_ 'card'}}: {{title}}"): .card-details-canvas
    //- The whole header row is what the window is dragged by - not the heading
      inside it. A heading is only as wide as its own text, so with a short title
      "the right half of the title" was a few pixels, and the empty space beside
      it - which is what anybody would grab - belonged to the row and did nothing.
      The handler steps aside for the buttons (they are links), for the drag
      handle when there is one, and for the half of the title that edits.
      client/components/cards/cardDetails.js
    .card-details-header.js-card-title-drag-handle(class='{{#if colorClass}}card-details-{{colorClass}}{{/if}}' style='{{colorStyle}}')
      +inlinedForm(classNames="js-card-details-title")
        +editCardTitleForm
      else
        unless isMiniScreen
          a.card-collapse-toggle.js-card-collapse-toggle(title="{{_ 'collapse-card'}}")
            if cardCollapsed
              i.fa.fa-caret-right
            else
              i.fa.fa-caret-down
          a.close-card-details.js-close-card-details(title="{{_ 'close-card'}}")
            i.fa.fa-times-thin
          if cardMaximized
            a.fa.fa-window-minimize.minimize-card-details.js-minimize-card-details(title="{{_ 'minimize-card'}}")
          else
            a.fa.fa-window-maximize.maximize-card-details.js-maximize-card-details(title="{{_ 'maximize-card'}}")
          a.card-details-menu.js-open-card-details-menu(title="{{_ 'cardDetailsActionsPopup-title'}}")
            i.fa.fa-bars
          //- The handle appears only when drag handles are ON, like the
            minicard's. With them off the window is dragged by its own title bar
            - the trailing half of the title - so a handle would be a second way
            to do what the bar already does; with them on it is the ONLY way, and
            the title is all edit target.
            client/components/cards/minicard.jade
          if canModifyCard
            if isTouchScreenOrShowDesktopDragHandles
              span.card-drag-handle.js-card-drag-handle(title="Drag card")
                i.fa.fa-arrows
        else
          a.close-card-details.js-close-card-details(title="{{_ 'close-card'}}")
            i.fa.fa-times-thin
          a.card-zoom-out.js-card-zoom-out(title="{{_ 'zoom-out'}}")
            i.fa.fa-search-minus
          a.card-zoom-in.js-card-zoom-in(title="{{_ 'zoom-in'}}")
            i.fa.fa-search-plus
          a.card-mobile-desktop-toggle.js-card-mobile-desktop-toggle(title="{{_ 'mobile-desktop-toggle'}}")
            if mobileMode
              i.fa.fa-desktop
            else
              i.fa.fa-mobile
          if cardMaximized
            a.fa.fa-window-minimize.minimize-card-details.js-minimize-card-details(title="{{_ 'minimize-card'}}")
          else
            a.fa.fa-window-maximize.maximize-card-details.js-maximize-card-details(title="{{_ 'maximize-card'}}")
          a.card-details-menu-mobile-web.js-open-card-details-menu(title="{{_ 'cardDetailsActionsPopup-title'}}")
            i.fa.fa-bars
        if canModifyCard
          if currentBoard.allowsDueComplete
            a.card-details-complete-toggle.js-toggle-due-complete(title="{{#if getDueComplete}}{{_ 'card-mark-incomplete'}}{{else}}{{_ 'card-mark-complete'}}{{/if}}")
              .materialCheckBox(class="{{#if getDueComplete}}is-checked{{/if}}")
        //- The title is BOTH: the leading half opens the editor and the
          trailing half drags the window, exactly as a minicard's title splits
          between editing and dragging the card. `js-card-title-drag-handle`
          stays on the whole heading - the drag handler is what steps aside for
          the edit zone - so a reader who may not write can still drag the
          window by any part of it, which is what that class was for.
        h2.card-details-title.js-card-title(
          class="{{#if canModifyCard}}is-editable{{/if}}")
            if canModifyCard
              a.card-details-title-edit-zone.js-open-inlined-form(title="{{_ 'edit'}}")
            +viewer
              if currentBoard.allowsCardNumber
                span.card-number
                  | ##{getCardNumber} &nbsp;
              = getTitle
            if isWatching
              i.card-details-watch
                i.fa.fa-eye
        .card-details-path
          each parentList
            | &nbsp; &gt; &nbsp;
            a.js-parent-card(href=linkForCard) {{title}}
          // else
            {{_ 'top-level-card'}}
        if isLinkedCard
          a.linked-card-location.js-go-to-linked-card
            +viewer
              | {{getBoardTitle}} > {{getTitle}}

    if getArchived
      if isLinkedBoard
        p.warning {{_ 'board-archived'}}
      else
        p.warning {{_ 'card-archived'}}

    // Upload progress indicator for drag-and-drop uploads
    if hasActiveUploads
      .card-details-upload-progress
        .upload-progress-header
          i.fa.fa-upload
          span {{_ 'uploading-files'}} ({{uploadCount}})
        each uploads
          .upload-progress-item(class="{{#if $eq status 'error'}}upload-error{{/if}}")
            .upload-progress-filename {{file.name}}
            .upload-progress-bar
              .upload-progress-fill(style="width: {{progress}}%")
            if $eq status 'error'
              .upload-progress-error
                i.fa.fa-exclamation-triangle
                span {{_ 'upload-failed'}}
            else if $eq status 'completed'
              .upload-progress-success
                i.fa.fa-check
                span {{_ 'upload-completed'}}

    //- #6431 follow-up: cover image on the opened card (opt-in, OFF by default).
    if currentBoard.allowsCoverAttachmentOnCard
      if cover
        .card-details-cover(style="background-image: url('{{cover.link 'original'}}');")

    .card-details-left

      .card-details-items
        .card-details-group.card-details-group-labels
          .card-details-group-body
            if currentBoard.allowsLabels
              .card-details-item.card-details-item-labels
                +cardSectionHeader(section="labels" icon="fa-tags" label="labels" noRule=true)
                if isSectionOpen "labels"
                  a(class="{{#if canModifyCard}}js-add-labels{{else}}is-disabled{{/if}}" title="{{_ 'card-labels-title'}}")
                    each labels
                      span.card-label(class="{{labelColorClass color}}" style="{{labelColorStyle color}}" title=name)
                        +viewer
                          = name
                  if canModifyCard
                    unless currentUser.isWorker
                      a.card-label.add-label.js-add-labels(title="{{_ 'card-labels-title'}}")
                        i.fa.fa-plus

            if isSectionOpen "labels"
              .card-details-item.card-details-item-stickers
                h3.card-details-item-title
                  i.fa.fa-sticky-note-o
                  | {{_ 'stickers'}}
                .card-details-item-content.card-stickers
                  each stickers
                    span.card-sticker(title="{{#if name}}{{name}}{{else}}{{icon}}{{/if}}")
                      i.fa(class="fa-{{icon}} {{#if highlight}}sticker-{{highlight}}{{/if}}")
                      if canModifyCard
                        a.card-sticker-remove.js-remove-sticker(data-index="{{@index}}" title="{{_ 'remove-sticker'}}")
                          i.fa.fa-times
                  if canModifyCard
                    unless currentUser.isWorker
                      a.card-label.add-label.js-add-stickers(title="{{_ 'add-sticker'}}")
                        i.fa.fa-plus

              .card-details-item.card-details-item-location
                h3.card-details-item-title
                  i.fa.fa-map-marker
                  | {{_ 'location'}}
                .card-details-item-content.card-locations
                  each getLocations
                    .card-location
                      .card-location-info(class="{{#if canModifyCard}}js-edit-location{{/if}}" data-location-id="{{_id}}")
                        if name
                          .card-location-name= name
                        if address
                          .card-location-address= address
                        if hasCoordinates
                          a.card-location-map(href=mapUrl target="_blank" rel="noopener noreferrer")
                            i.fa.fa-map-o
                            = ' '
                            | {{_ 'location-open-map'}}
                      if canModifyCard
                        a.card-location-remove.js-remove-location(data-location-id="{{_id}}" title="{{_ 'delete'}}")
                          i.fa.fa-times
                if canModifyCard
                  unless currentUser.isWorker
                    a.card-label.add-label.js-add-location(title="{{_ 'add-location'}}")
                      i.fa.fa-plus

        //- The card's button row - it sat here before the fields were grouped,
          between the Labels group and the dates, and belongs to the card rather
          than to any group.
        +cardButtons(_id=_id boardId=boardId)

        .card-details-group.card-details-group-date-format
          hr.card-details-section-rule
          .card-details-group-body
            if currentBoard.hasAnyAllowsDate
              .card-details-item.card-details-item-date-format
                +cardSectionHeader(section="date-format" icon="fa-calendar" label="date-format" noRule=true)
                if isSectionOpen "date-format"
                  .card-details-item-content
                    select.js-date-format-selector
                      option(value="YYYY-MM-DD" selected="{{#if isDateFormat 'YYYY-MM-DD'}}selected{{/if}}") {{_ 'date-format-yyyy-mm-dd'}}
                      option(value="DD-MM-YYYY" selected="{{#if isDateFormat 'DD-MM-YYYY'}}selected{{/if}}") {{_ 'date-format-dd-mm-yyyy'}}
                      option(value="MM-DD-YYYY" selected="{{#if isDateFormat 'MM-DD-YYYY'}}selected{{/if}}") {{_ 'date-format-mm-dd-yyyy'}}

            if isSectionOpen "date-format"
              if currentBoard.allowsReceivedDate
                .card-details-item.card-details-item-received
                  h3.card-details-item-title
                    i.fa.fa-sign-out
                    | {{_ 'card-received'}}
                  if getReceived
                    +cardReceivedDate(card=this canModifyCard=canModifyCard)
                  else
                    if canModifyCard
                      unless currentUser.isWorker
                        a.card-label.add-label.js-received-date
                          i.fa.fa-plus

              if currentBoard.allowsStartDate
                .card-details-item.card-details-item-start
                  h3.card-details-item-title
                    i.fa.fa-hourglass-start
                    | {{_ 'card-start'}}
                  if getStart
                    +cardStartDate(card=this canModifyCard=canModifyCard)
                  else
                    if canModifyCard
                      unless currentUser.isWorker
                        a.card-label.add-label.js-start-date
                          i.fa.fa-plus

              if currentBoard.allowsDueDate
                .card-details-item.card-details-item-due
                  h3.card-details-item-title
                    i.fa.fa-clock-o
                    | {{_ 'card-due'}}
                  if getDue
                    +cardDueDate(card=this canModifyCard=canModifyCard)
                  else
                    if canModifyCard
                      unless currentUser.isWorker
                        a.card-label.add-label.js-due-date
                          i.fa.fa-plus
                  if dueDateChangeCount
                    .card-details-due-date-changes(title="{{_ 'due-date-changes'}}")
                      | {{_ 'due-date-changed-times' dueDateChangeCount}}

              if currentBoard.allowsEndDate
                .card-details-item.card-details-item-end
                  h3.card-details-item-title
                    i.fa.fa-hourglass-end
                    | {{_ 'card-end'}}
                  if getEnd
                    +cardEndDate(card=this canModifyCard=canModifyCard)
                  else
                    if canModifyCard
                      unless currentUser.isWorker
                        a.card-label.add-label.js-end-date
                          i.fa.fa-plus

        .card-details-group.card-details-group-members
          hr.card-details-section-rule
          .card-details-group-body
            if currentBoard.allowsMembers
              .card-details-item.card-details-item-members
                +cardSectionHeader(section="members" icon="fa-users" label="members" noRule=true)
                if isSectionOpen "members"
                  each userId in getMembers
                    +userAvatar(userId=userId cardId=_id)
                    | {{! XXX Hack to hide syntaxic coloration /// }}
                  if canModifyCard
                    unless currentUser.isWorker
                      a.member.add-member.card-details-item-add-button.js-add-members(title="{{_ 'card-members-title'}}")
                        i.fa.fa-plus

            if isSectionOpen "members"
              if currentBoard.allowsAssignee
                .card-details-item.card-details-item-assignees
                  h3.card-details-item-title
                    i.fa.fa-user
                    | {{_ 'assignee'}}
                  each userId in getAssignees
                    +userAvatar(userId=userId cardId=_id assignee=true)
                    | {{! XXX Hack to hide syntaxic coloration /// }}
                  if canModifyCard
                    a.assignee.add-assignee.card-details-item-add-button.js-add-assignees(title="{{_ 'assignee'}}")
                      i.fa.fa-plus
                  if currentUser.isWorker
                    unless assigneeSelected
                      a.assignee.add-assignee.card-details-item-add-button.js-add-assignees(title="{{_ 'assignee'}}")
                        i.fa.fa-plus

              if currentBoard.allowsCreator
                .card-details-item.card-details-item-creator
                  h3.card-details-item-title
                    i.fa.fa-user
                    | {{_ 'creator'}}

                  +userAvatar(userId=userId noRemove=true)
                  | {{! XXX Hack to hide syntaxic coloration /// }}


              //.card-details-items
              //if assigneeSelected
              //.card-details-items
              if currentBoard.allowsRequestedBy
                .card-details-item.card-details-item-name
                  h3.card-details-item-title
                    i.fa.fa-shopping-cart
                    | {{_ 'requested-by'}}
                  if canModifyCard
                    unless currentUser.isWorker
                      +inlinedForm(classNames="js-card-details-requester")
                        +editCardRequesterForm
                      else
                        each userId in getRequesters
                          +userAvatar(userId=userId cardId=_id noRemove=true)
                        if getRequestedBy
                          +viewer
                            = getRequestedBy
                        .card-details-person-controls
                          a.member.add-member.card-details-item-add-button.js-select-requester(title="{{_ 'requested-by'}}")
                            i.fa.fa-plus
                          a.js-open-inlined-form(
                            title="{{#if getRequestedBy}}{{_ 'edit'}}{{else}}{{_ 'add'}}{{/if}}"
                            aria-label="{{#if getRequestedBy}}{{_ 'edit'}}{{else}}{{_ 'add'}}{{/if}}")
                            if getRequestedBy
                              i.fa.fa-pencil-square-o(aria-hidden="true")
                            else
                              i.fa.fa-plus(aria-hidden="true")
                  else
                    each userId in getRequesters
                      +userAvatar(userId=userId noRemove=true)
                    if getRequestedBy
                      +viewer
                        = getRequestedBy

              if currentBoard.allowsAssignedBy
                .card-details-item.card-details-item-name
                  h3.card-details-item-title
                    i.fa.fa-user-plus
                    | {{_ 'assigned-by'}}
                  if canModifyCard
                    unless currentUser.isWorker
                      +inlinedForm(classNames="js-card-details-assigner")
                        +editCardAssignerForm
                      else
                        each userId in getAssigners
                          +userAvatar(userId=userId cardId=_id noRemove=true)
                        if getAssignedBy
                          +viewer
                            = getAssignedBy
                        .card-details-person-controls
                          a.member.add-member.card-details-item-add-button.js-select-assigner(title="{{_ 'assigned-by'}}")
                            i.fa.fa-plus
                          a.js-open-inlined-form(
                            title="{{#if getAssignedBy}}{{_ 'edit'}}{{else}}{{_ 'add'}}{{/if}}"
                            aria-label="{{#if getAssignedBy}}{{_ 'edit'}}{{else}}{{_ 'add'}}{{/if}}")
                            if getAssignedBy
                              i.fa.fa-pencil-square-o(aria-hidden="true")
                            else
                              i.fa.fa-plus(aria-hidden="true")
                  else
                    each userId in getAssigners
                      +userAvatar(userId=userId noRemove=true)
                    if getAssignedBy
                      +viewer
                        = getAssignedBy

        .card-details-group.card-details-group-dependencies
          hr.card-details-section-rule
          .card-details-group-body
            .card-details-item.card-details-item-dependencies
              +cardSectionHeader(section="dependencies" icon="fa-link" label="card-dependencies" noRule=true)
              if isSectionOpen "dependencies"
                .card-details-dependencies-list
                  each getDependencyCards
                    .card-dependency(data-target-id="{{card._id}}")
                      i.fa(class="fa-{{icon}}" style="color:{{color}}")
                      a.card-dependency-link(href="{{linkUrl}}")
                        +viewer
                          = card.title
                      if canModifyCard
                        select.js-dependency-type(data-target-id="{{card._id}}")
                          each typeOption
                            if selected
                              option(value="{{id}}" selected="selected") {{_ label}}
                            else
                              option(value="{{id}}") {{_ label}}
                        input.js-dependency-color(type="color" value="{{color}}" data-target-id="{{card._id}}" title="{{_ 'dependency-color'}}")
                        a.js-dependency-icon(data-target-id="{{card._id}}" title="{{_ 'dependency-icon'}}")
                          i.fa.fa-pencil
                        a.card-dependency-remove.js-remove-dependency(data-target-id="{{card._id}}" title="{{_ 'remove-dependency'}}")
                          i.fa.fa-times
                      else
                        span.card-dependency-type {{_ typeLabel}}
                if canModifyCard
                  a.js-add-dependency(title="{{_ 'add-dependency'}}")
                    i.fa.fa-plus
                    | {{_ 'add-dependency'}}

        .card-details-group.card-details-group-sort
          hr.card-details-section-rule
          .card-details-group-body
            if currentBoard.allowsCardSortingByNumber
              .card-details-item.card-details-sort-order
                +cardSectionHeader(section="sort" icon="fa-sort-numeric-asc" label="sort" noRule=true)
                if isSectionOpen "sort"
                  if canModifyCard
                    +inlinedForm(classNames="js-card-details-sort")
                      +editCardSortOrderForm
                    else
                      a.js-open-inlined-form
                        +viewer
                          = sort

            if isSectionOpen "sort"
              if currentBoard.allowsShowLists
                .card-details-item.card-details-show-lists
                  h3.card-details-item-title
                    i.fa.fa-list
                    | {{_ 'list'}}
                  select.js-select-card-details-lists(disabled="{{#unless canModifyCard}}disabled{{/unless}}")
                    each currentSwimlaneListsSorted
                      option(value="{{_id}}" selected="{{#if isCurrentListId _id}}selected{{/if}}") {{title}}

              //.card-details-items
              if getSpentTime
                .card-details-item.card-details-item-spent
                  if getIsOvertime
                    h3.card-details-item-title
                      | {{_ 'overtime-hours'}}
                  else
                    h3.card-details-item-title
                      | {{_ 'spent-time-hours'}}
                  +cardSpentTime

              //.card-details-items
        //- The heading is here for EVERY card the reader may write to, not only
          for one that already has a custom field on it. The hamburger at the end
          of it is the single place custom fields live - the picker of which
          fields are on this card, a pencil each, and "Add custom field" - so
          gating the heading on `customFieldsWD`, the card's VALUES, meant a card
          with none had no way to get one, and a board that had never used them
          had no way anywhere: the card menu's entry and the Board Settings row
          were removed with the move, and the sidebar view is opened by nothing.
          The FIELDS below still come from `customFieldsWD`, so an empty section
          is an empty section, not a phantom row.
        if canShowCustomFieldsOnCard
          //- ONE header for the whole group, outside the loop: a card with six
            custom fields is one Custom Fields section, not six sections that
            happen to share a caret and draw six rules. A group like the others,
            so its rule spans the card and its fields share rows inside it.
          .card-details-group.card-details-group-custom-fields
            +cardSectionHeader(section="custom-fields" icon="fa-list-alt" label="custom-fields"
              menuClass="js-open-custom-fields-settings" menuTitle="custom-fields"
              layoutToggle=true layoutOnePerRow=customFieldsGrid)
            if isSectionOpen "custom-fields"
              .card-details-group-body(class="{{#if customFieldsGrid}}custom-fields-one-per-row{{else}}custom-fields-grid{{/if}}")
                each customFieldsWD
                  .card-details-item.card-details-item-customfield
                    +cardCustomField

      if getVoteQuestion
        hr
        .vote-title
          div.flex
            h3
              i.fa.fa-thumbs-up
              | {{_ 'vote-question'}}
            if getVoteEnd
              +voteEndDate
          .vote-result
            if votePublic
              a.card-label.card-label-green.js-show-positive-votes {{ voteCountPositive }}
              a.card-label.card-label-red.js-show-negative-votes {{ voteCountNegative }}
            else
              .card-label.card-label-green {{ voteCountPositive }}
              .card-label.card-label-red {{ voteCountNegative }}
            unless ($and currentBoard.isPublic voteAllowNonBoardMembers )
              .card-label.card-label-gray
                | {{ voteCount }} {{_ 'r-of' }} {{ currentBoard.activeMembers.length }}
        +viewer
          = getVoteQuestion
        if showVotingButtons
          button.card-details-green.js-vote.js-vote-positive(class="{{#if voteState}}voted{{/if}}")
            if voteState
              i.fa.fa-thumbs-up
            | {{_ 'vote-for-it'}}
          button.card-details-red.js-vote.js-vote-negative(class="{{#if $eq voteState false}}voted{{/if}}")
            if $eq voteState false
              i.fa.fa-thumbs-down
            | {{_ 'vote-against'}}

      if getPokerQuestion
        hr
        .poker-title
          div.flex
            h3
              i.fa.fa-thumbs-up
              | {{_ 'poker-question'}}
            if getPokerEnd
              +pokerEndDate
          div.flex
            .poker-result
              if expiredPoker
                unless ($and currentBoard.isPublic pokerAllowNonBoardMembers )
                  .card-label.card-label-gray
                    | {{ pokerCount }} {{_ 'r-of' }} {{ currentBoard.activeMembers.length }}
        if showPlanningPokerButtons
          .poker-result
            .poker-deck
              .poker-card
                span.inner.js-poker.js-poker-vote-one(class="{{#if $eq pokerState 'one'}}poker-voted{{/if}}") {{_ 'poker-one'}}
              if $eq pokerState "one"
                i.fa.fa-check
            .poker-deck
              .poker-card
                span.inner.js-poker.js-poker-vote-two(class="{{#if $eq pokerState 'two'}}poker-voted{{/if}}") {{_ 'poker-two'}}
              if $eq pokerState "two"
                i.fa.fa-check
            .poker-deck
              .poker-card
                span.inner.js-poker.js-poker-vote-three(class="{{#if $eq pokerState 'three'}}poker-voted{{/if}}") {{_ 'poker-three'}}
              if $eq pokerState "three"
                i.fa.fa-check
            .poker-deck
              .poker-card
                span.inner.js-poker.js-poker-vote-five(class="{{#if $eq pokerState 'five'}}poker-voted{{/if}}") {{_ 'poker-five'}}
              if $eq pokerState "five"
                i.fa.fa-check
            .poker-deck
              .poker-card
                span.inner.js-poker.js-poker-vote-eight(class="{{#if $eq pokerState 'eight'}}poker-voted{{/if}}") {{_ 'poker-eight'}}
              if $eq pokerState "eight"
                i.fa.fa-check
            .poker-deck
              .poker-card
                span.inner.js-poker.js-poker-vote-thirteen(class="{{#if $eq pokerState 'thirteen'}}poker-voted{{/if}}") {{_ 'poker-thirteen'}}
              if $eq pokerState "thirteen"
                i.fa.fa-check
            .poker-deck
              .poker-card
                span.inner.js-poker.js-poker-vote-twenty(class="{{#if $eq pokerState 'twenty'}}poker-voted{{/if}}") {{_ 'poker-twenty'}}
              if $eq pokerState "twenty"
                i.fa.fa-check
            .poker-deck
              .poker-card
                span.inner.js-poker.js-poker-vote-forty(class="{{#if $eq pokerState 'forty'}}poker-voted{{/if}}") {{_ 'poker-forty'}}
              if $eq pokerState "forty"
                i.fa.fa-check
            .poker-deck
              .poker-card
                span.inner.js-poker.js-poker-vote-one-hundred(class="{{#if $eq pokerState 'oneHundred'}}poker-voted{{/if}}") {{_ 'poker-oneHundred'}}
              if $eq pokerState "oneHundred"
                i.fa.fa-check
            .poker-deck
              .poker-card
                span.inner.js-poker.js-poker-vote-unsure(class="{{#if $eq pokerState 'unsure'}}poker-voted{{/if}}") {{_ 'poker-unsure'}}
