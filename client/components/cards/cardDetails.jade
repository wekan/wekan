template(name="cardDetailsActionsPopup")
  //- One list, in this order (the maintainer's, 2026-10-25): Move Card, Copy
    Card, Save as Template, Copy Template to Many Cards, Card recurrence, Move to
    Top, Move to Bottom, Watch, Star | Set color, Drawing | Copy link, Link to
    board, QR code, History, Export, Import, Move Card to Archive, More. Each
    item keeps the permission it had. Filter: Subtasks, Edit voting, Edit
    Planning Poker, Change spent time and Card kind are in the hamburger of
    their own section of the opened card, and in Card Settings' pane of that
    section (docs/Features/Cards/Card-Fields.md).
  if currentUser
    ul.pop-over-list
      if cardMenuWrites
        if currentUser.isBoardAdmin
          li
            a.js-move-card
              i.fa.fa-arrow-right
              | {{_ 'moveCardPopup-title'}}
        unless currentUser.isWorker
          li
            a.js-copy-card
              i.fa.fa-clipboard
              | {{_ 'copyCardPopup-title'}}
          li
            a.js-save-card-as-template
              i.fa.fa-clone
              | {{_ 'save-card-as-template'}}
          li
            a.js-copy-checklist-cards
              i.fa.fa-copy
              | {{_ 'copyManyCardsPopup-title'}}
          if canModifyCard
            li
              a.js-set-card-recurrence-interval.card-recurrence-interval
                i.fa.fa-refresh
                | {{_ 'card-recurrence-interval'}} ...
        li
          a.js-move-card-to-top
            i.fa.fa-arrow-up
            | {{_ 'moveCardToTop-title'}}
        li
          a.js-move-card-to-bottom
            i.fa.fa-arrow-down
            | {{_ 'moveCardToBottom-title'}}
      li
        a.js-toggle-watch-card
          if isWatching
            i.fa.fa-eye
            |  {{_ 'unwatch'}}
          else
            i.fa.fa-eye
            |  {{_ 'watch'}}
      //- #1172: star/unstar this card - same toggle pattern as the board star.
      li
        a.js-star-card-item
          if isCardItemStarred
            i.fa.fa-star
            |  {{_ 'unstar-item'}}
          else
            i.fa.fa-star-o
            |  {{_ 'star-item'}}
    if canModifyCard
      unless currentUser.isWorker
        hr
        ul.pop-over-list
          li
            a.js-set-card-color
              i.fa.fa-paint-brush
              | {{_ 'setCardColorPopup-title'}}
          //- #1178: draw or write by hand on the card.
          li
            a.js-card-drawing
              i.fa.fa-pencil
              | {{_ 'cardDrawingPopup-title'}}
          //- Action items of the description, Show on Card
            (docs/Features/Cards/Action-Items.md).
          if actionItemsOf this
            li
              a.js-description-action-items
                i.fa.fa-tasks
                |  {{_ 'action-items-create'}}
    hr
  ul.pop-over-list
    if currentUser
      //- Copy link, named - the card's header carried this as an icon with only
        a tooltip. docs/Features/General/Board-Item-Links.md
      li
        a.js-copy-card-link
          i.fa.fa-link
          |  {{_ 'copy-link-to-clipboard'}}
      if canModifyCard
        unless currentUser.isWorker
          li
            a.js-link-card-to-board
              i.fa.fa-link
              | {{_ 'linkCardToBoardPopup-title'}}
      //- #2015: the same link as a QR code, drawn in the browser
        (models/lib/qrCode.js), to open the card on a phone.
      li
        a.js-card-qr-code
          i.fa.fa-qrcode
          |  {{_ 'card-qr-code'}}
      //- History of the whole card (docs/Features/General/History/History.md
        §7a): the SAME historyTable every other scope opens, `scope: 'card'`.
      li
        a.js-card-history
          i.fa.fa-history
          |  {{_ 'history'}}
    //- #1173: "Export" and "Import", as every other menu has them. Import
      writes, so it is asked for with the same permission question the popup
      itself asks.
    li
      a.js-export-card
        i.fa.fa-upload
        | {{_ 'export'}}
    if canImportIntoBoard
      li
        a.js-import-card
          i.fa.fa-download
          | {{_ 'import'}}
    if currentUser
      if cardMenuWrites
        unless currentUser.isWorker
          if archived
            li
              a.js-restore-archived-card
                i.fa.fa-recycle
                | {{_ 'restore'}}
          else
            li
              a.js-archive
                i.fa.fa-archive
                | {{_ 'archive-card'}}
          li
            a.js-more
              span.emoji-icon
                i.fa.fa-link
              | {{_ 'cardMorePopup-title'}}
          unless canModifyCard
            li
              a.js-create-board-from-card
                i.fa.fa-external-link
                | {{_ 'linkCardToNewBoard'}}
  span.copied-tooltip {{_ 'copied'}}

//- #1173: the card export popup IS the shared export body - the same checkbox
  list and the same four formats every other menu offers, with the card as its
  scope. It used to be its own template with its own field list, which is how
  its checkboxes came to drive the Excel download and not the PDF.
template(name="exportCardPopup")
  +exportScopeBody(cardId=_id listId=listId title=title)

//- WHERE a card goes: the board, the swimlane, the list, which card to put it
  above or below, and Done. Four popups asked that same question and drew this
  same form to ask it - Move card, Copy card, Copy checklist to many cards, and
  Convert a checklist item to a card - differing only in the title field above
  it, which is why that stays with each of them.
//-
//- The JavaScript was already one piece: BoardSwimlaneListCardDialog holds the
  four selects' state and registerCardDialogTemplate wires each popup to it. The
  `dialog` is passed in and read from the template INSTANCE rather than from the
  data context, because inside `each boards` the context is a board - a helper
  that reached for it there would find nothing. The selects' own change handlers
  stay on the popups: an event from here bubbles to the one that includes it,
  which is the one holding the dialog. client/components/cards/cardDetails.js
template(name="cardDestinationPicker")
  unless currentUser.isWorker
    label(for="{{pickerFieldId 'boards'}}") {{_ 'boards'}}:
    select.js-select-boards(autofocus id="{{pickerFieldId 'boards'}}")
      each boards
        option(value="{{_id}}" selected="{{#if isSelectedBoardId _id}}selected{{/if}}") {{title}}

  label(for="{{pickerFieldId 'swimlanes'}}") {{_ 'swimlanes'}}:
  select.js-select-swimlanes(id="{{pickerFieldId 'swimlanes'}}")
    each swimlanes
      option(value="{{_id}}" selected="{{#if isSelectedSwimlaneId _id}}selected{{/if}}") {{isTitleDefault title}}

  label(for="{{pickerFieldId 'lists'}}") {{_ 'lists'}}:
  select.js-select-lists(id="{{pickerFieldId 'lists'}}")
    each lists
      option(value="{{_id}}" selected="{{#if isSelectedListId _id}}selected{{/if}}") {{title}}

  label(for="{{pickerFieldId 'cards'}}") {{_ 'cards'}}:
  select.js-select-cards(id="{{pickerFieldId 'cards'}}")
    each cards
      option(value="{{_id}}" selected="{{#if isDialogOptionCardId _id}}selected{{/if}}") {{title}}

  div
    input(type="radio" name="position" value="above" checked id="position-above" style="display: inline")
    label(for="position-above") {{_ 'above-selected-card'}}
  div
    input(type="radio" name="position" value="below" id="position-below" style="display: inline")
    label(for="position-below") {{_ 'below-selected-card'}}

  if destinationError
    .warning.js-destination-error(role="alert") {{destinationError}}

  .edit-controls.clearfix
    button.primary.confirm.js-done(type="button" disabled=destinationDisabled) {{_ 'done'}}

template(name="moveCardPopup")
  label(for='move-card-title') {{_ 'title'}}:
  textarea#move-card-title.full-line(data-editor-submit=".js-done" autofocus)= getTitle
  label(for="move-card-reason") {{_ "move-reason"}}
  textarea#move-card-reason.full-line(data-editor-submit=".js-done" maxlength="1000")
  +cardDestinationPicker(dialog=dialog)
  div
    input#js-leave-link-at-origin(type="checkbox")
    label(for='js-leave-link-at-origin') {{_ 'moveCardPopup-leave-link-at-origin'}}

template(name="copyCardPopup")
  label(for='copy-card-title') {{_ 'title'}}:
  textarea#copy-card-title.minicard-composer-textarea.js-card-title(data-editor-submit=".js-done" autofocus)
    = getTitle
  +cardDestinationPicker(dialog=dialog)

template(name="linkCardToBoardPopup")
  +cardDestinationPicker(dialog=dialog)

template(name="copyManyCardsPopup")
  label(for='copy-checklist-cards-title') {{_ 'copyManyCardsPopup-instructions'}}:
  textarea#copy-card-title.minicard-composer-textarea.js-card-title(data-editor-submit=".js-done" autofocus)
    | {{_ 'copyManyCardsPopup-format'}}
  +cardDestinationPicker(dialog=dialog)

template(name="convertChecklistItemToCardPopup")
  label(for='convert-checklist-item-to-card-title') {{_ 'title'}}:
  textarea#copy-card-title.minicard-composer-textarea.js-card-title(data-editor-submit=".js-done" autofocus)
    = item.title
  +cardDestinationPicker(dialog=dialog)

template(name="cardMembersPopup")
  input.card-members-filter(type="text" placeholder="{{_ 'search'}}")
  //- Suggested members, Show on Card (docs/Features/Cards/Suggested-Members.md).
  if suggestedMembers.length
    .card-members-suggested.js-suggested-members
      h4.card-members-suggested-title {{_ 'suggested-members'}}
      ul.pop-over-list
        each suggestedMembers
          li.item
            a.name.js-select-member(href="#")
              +userAvatar(userId=userId)
              span.full-name
                = userData.profile.fullname
                if userData.username
                  | (#{userData.username})
  ul.pop-over-list.js-card-member-list
    each members
      li.item(class="{{#if isCardMember}}active{{/if}}")
        a.name.js-select-member(href="#")
          +userAvatar(userId=userId)
          span.full-name
            = userData.profile.fullname
            if userData.username
              | (#{userData.username})
          if isCardMember
            i.fa.fa-check

template(name="cardRequestedByPopup")
  +cardIdentityPicker(field="requesters")

template(name="cardAssignedByPopup")
  +cardIdentityPicker(field="assigners")

//- Requested/Assigned By can contain an external free-text name, but their +
  button selects one of the board's members just like Members and Assignee.
template(name="cardIdentityPicker")
  input.card-identity-filter(type="text" placeholder="{{_ 'search'}}")
  ul.pop-over-list.js-card-identity-list
    each members
      li.item(class="{{#if isSelected}}active{{/if}}")
        a.name.js-select-card-identity(href="#")
          +userAvatar(userId=userId)
          span.full-name
            = userData.profile.fullname
            if userData.username
              | (#{userData.username})
          if isSelected
            i.fa.fa-check
template(name="cardAssigneesPopup")
  input.card-assignees-filter(type="text" placeholder="{{_ 'search'}}")
  unless currentUser.isWorker
    //- Suggested members, Show on Card (docs/Features/Cards/Suggested-Members.md).
    if suggestedMembers.length
      .card-members-suggested.js-suggested-members
        h4.card-members-suggested-title {{_ 'suggested-members'}}
        ul.pop-over-list
          each suggestedMembers
            li.item
              a.name.js-select-assignee(href="#")
                +userAvatar(userId=userId)
                span.full-name
                  = userData.profile.fullname
                  if userData.username
                    | (#{userData.username})
    ul.pop-over-list.js-card-assignee-list
      each members
        li.item(class="{{#if isCardAssignee}}active{{/if}}")
          a.name.js-select-assignee(href="#")
            +userAvatar(userId=userId)
            span.full-name
              = userData.profile.fullname
              if userData.username
                | (#{userData.username})
            if isCardAssignee
              i.fa.fa-check
  if currentUser.isWorker
    ul.pop-over-list.js-card-assignee-list
      li.item(class="{{#if currentUser.isCardAssignee}}active{{/if}}")
        a.name.js-select-assignee(href="#")
          +userAvatar(userId=currentUser._id)
          span.full-name
            = currentUser.profile.fullname
            if currentUser.username
              | (#{currentUser.username})
          if currentUser.isCardAssignee
            i.fa.fa-check
template(name="cardAssigneePopup")
  .board-assignee-menu
    .mini-profile-info
      +userAvatar(userId=user._id showEdit=true)
      .info
        h3= user.profile.fullname
        p.quiet @{{ user.username }}
    ul.pop-over-list
      if currentUser.isNotCommentOnly
        unless currentUser.isWorker
          li: a.js-remove-assignee {{_ 'remove-member-from-card'}}

      unless currentUser.isWorker
        if $eq currentUser._id user._id
          with currentUser
            li: a.js-edit-profile {{_ 'edit-profile'}}

//- Kanboard-style whole-card recurrence: pick this card's automatic-recurrence
  interval (or 'none' to turn it off). server/cardRecurrenceSchedule.js creates
  a fresh copy of the card in the same list once the chosen interval comes due.
  Mirrors client/components/cards/checklists.jade's checklistResetIntervalPopup.
template(name="cardRecurrenceIntervalPopup")
  ul.pop-over-list
    each recurrenceIntervals
      li
        a.js-set-card-recurrence(data-interval="{{this}}" class="{{#if isCurrentCardInterval}}is-checked{{/if}}")
          i.fa(class="{{#if isCurrentCardInterval}}fa-check-circle{{else}}fa-circle-o{{/if}}")
          | {{_ (concat 'card-recurrence-interval-' this)}}

template(name="cardMorePopup")
  p.quiet
    span.clearfix
      span {{_ 'link-card'}}
      = ' '
      i.fa(class="{{currentBoard.visibilityIcon}}")
      input.inline-input(type="text" id="cardURL" readonly value="{{ originRelativeUrl }}" autofocus="autofocus")
      //- `.primary` is the themed button - the board's accent with white text -
        and is named in forms.css beside the other buttons that wear it, so the
        accent and the hover and active states have one home. Without it this
        one fell back to the plain grey button, whose dark label is nearly
        invisible on a dark theme.
      button.primary.js-copy-card-link-to-clipboard(class="btn" id="clipboard") {{_ 'copy-card-link-to-clipboard'}}
      .copied-tooltip {{_ 'copied'}}
    span.clearfix
    br
    h2 {{_ 'change-card-parent'}}
    label {{_ 'source-board'}}:
      select.js-field-parent-board
        if isTopLevel
          option(value="none" selected) {{_ 'custom-field-dropdown-none'}}
        else
          option(value="none") {{_ 'custom-field-dropdown-none'}}
        each boards
          if isParentBoard
            option(value="{{_id}}" selected) {{title}}
          else
            option(value="{{_id}}") {{title}}

    label {{_ 'parent-card'}}:
      select.js-field-parent-card
        if isTopLevel
          option(value="none" selected) {{_ 'custom-field-dropdown-none'}}
        else
          option(value="none") {{_ 'custom-field-dropdown-none'}}
          each cards
            if isParentCard
              option(value="{{_id}}" selected) {{title}}
            else
              option(value="{{_id}}") {{title}}
    //- #3626: a card may be a subtask of several cards. The one above is the
      primary parent (the path shown above the title); these are the others.
    if otherParents.length
      .card-other-parents
        span {{_ 'other-parent-cards'}}:
        ul
          each otherParents
            li
              span {{title}}
              a.js-remove-other-parent(href="#" data-id="{{_id}}" title="{{_ 'remove-parent-card'}}") ×
    if cards.length
      label {{_ 'add-parent-card'}}:
        select.js-field-add-parent-card
          option(value="none" selected) {{_ 'custom-field-dropdown-none'}}
          each cards
            option(value="{{_id}}") {{title}}
    br
    | {{_ 'added'}}
    span.date(title=card.createdAt) {{ displayDate createdAt 'LLL' }}
    if currentUser.isBoardAdmin
      a.js-delete(title="{{_ 'card-delete-notice'}}") {{_ 'delete'}}

//- #4495: create a brand-new board from THIS existing card, and link the card
  to it, in one step - the user never leaves the card. Adjacent to, and does
  not touch, the existing "Link to board" flow
  (client/components/lists/listBody.js Template.linkCardPopup), which links a
  NEW card to an EXISTING board from the list's add-card composer.
template(name="createBoardFromCardPopup")
  form.js-create-board-from-card-form
    label {{_ 'name'}}
    textarea.js-create-board-from-card-title.inline-input(rows="2" autofocus="autofocus")= cardTitle
    button.primary.confirm.js-submit {{_ 'linkCardToNewBoard'}}

template(name="setCardColorPopup")
  form.edit-label
    .palette-colors
      each colors
        unless $eq color 'white'
          span.card-label.palette-color.js-palette-color(class="card-details-{{color}}")
            if(isSelected color)
              i.fa.fa-check
    +customCardColorSwatches(colors=customColors selected=selectedColor)
    // #5514: native color wheel for picking a custom RGB / hex color
    .color-wheel-wrap
      label(for="cardColorWheel") {{_ 'custom-color'}}
      input.js-card-color-wheel#cardColorWheel(type="color" value=currentColorHex title="{{_ 'custom-color'}}")
  button.primary.confirm.js-submit {{_ 'save'}}
  button.js-remove-color.negate.wide.right {{_ 'remove-btn'}}

//- The custom '#rrggbb' colors already used on this board's cards, offered
  beside the ready-made palette in both card color popups (one card, and
  Multi-Selection). Every value is a validated hex (customColorsInUse), and
  Blaze escapes the attributes it is written into.
template(name="customCardColorSwatches")
  if colors
    .custom-palette-colors(title="{{_ 'custom-color'}}" aria-label="{{_ 'custom-color'}}")
      each hex in colors
        span.card-label.palette-color.js-custom-palette-color(style="background-color:{{hex}}" data-color=hex title=hex)
          if $eq hex selected
            i.fa.fa-check(style="color:{{contrastTextFor hex}}")

template(name="cardDeletePopup")
  p {{_ "card-delete-pop"}}
  unless archived
    p {{_ "card-delete-suggest-archive"}}
  button.js-confirm.negate.full(type="submit") {{_ 'delete'}}

template(name="cardArchivePopup")
  p {{_ "card-archive-pop"}}
  unless archived
    p {{_ "card-archive-suggest-cancel"}}
  button.js-confirm.negate.full(type="submit") {{_ 'archive'}}

template(name="deleteVotePopup")
  p {{_ "vote-delete-pop"}}
  button.js-confirm.negate.full(type="submit") {{_ 'delete'}}

template(name="cardStartVotingPopup")
  form.edit-vote-question
    .fields
      label(for="vote") {{_ 'vote-question'}}
      textarea.js-vote-field#vote(rows="2" name="vote" autofocus disabled="{{#if getVoteQuestion}}disabled{{/if}}")= getVoteQuestion
      .check-div
        a.flex(class="{{#if getVoteQuestion}}is-disabled{{else}}js-toggle-vote-allow-non-members{{/if}}")
          .materialCheckBox#vote-allow-non-members(name="vote-allow-non-members" class="{{#if voteAllowNonBoardMembers}}is-checked{{/if}}")
          span {{_ 'allowNonBoardMembers'}}
      .check-div
        a.flex(class="{{#if getVoteQuestion}}is-disabled{{else}}js-toggle-vote-public{{/if}}")
          .materialCheckBox#vote-public(name="vote-public" class="{{#if votePublic}}is-checked{{/if}}")
          span {{_ 'vote-public'}}
      .check-div.flex
        i.fa.fa-clock-o
        a.js-end-date
          span
            | {{_ 'card-end'}}
            unless getVoteEnd
              i.fa.fa-plus
        if getVoteEnd
          +voteEndDate

    button.primary.js-submit {{_ 'save'}}
    if getVoteQuestion
      if currentUser.isBoardAdmin
        button.js-remove-vote.negate.wide.right {{_ 'delete'}}

template(name="positiveVoteMembersPopup")
  ul.pop-over-list.js-card-member-list
    each m in voteMemberPositive
      li.item
        a.name
          +userAvatar(userId=m._id)
          span.full-name
            = m.profile.fullname
            | (<span class="username">{{ m.username }}</span>)

template(name="negativeVoteMembersPopup")
  ul.pop-over-list.js-card-member-list
    each m in voteMemberNegative
      li.item
        a.name
          +userAvatar(userId=m._id)
          span.full-name
            = m.profile.fullname
            | (<span class="username">{{ m.username }}</span>)

template(name="deletePokerPopup")
  p {{_ "poker-delete-pop"}}
  button.js-confirm.negate.full(type="submit") {{_ 'delete'}}

template(name="cardStartPlanningPokerPopup")
  form.edit-poker-question
    .fields
      .check-div
        a.flex(class="{{#if getPokerQuestion}}is-disabled{{else}}js-toggle-poker-allow-non-members{{/if}}")
          .materialCheckBox#poker-allow-non-members(name="poker-allow-non-members" class="{{#if pokerAllowNonBoardMembers}}is-checked{{/if}}")
          span {{_ 'allowNonBoardMembers'}}
      .check-div.flex
        i.fa.fa-clock-o
        a.js-end-date
          span
            | {{_ 'card-end'}}
            unless getPokerEnd
              i.fa.fa-plus
        if getPokerEnd
          +pokerEndDate

    button.primary.js-submit {{_ 'save'}}
    if getPokerQuestion
      if currentUser.isBoardAdmin
        button.js-remove-poker.negate.wide.right {{_ 'delete'}}

template(name="cardLocationsPopup")
  form.js-card-location-form
    label
      | {{_ 'location-detect-from-map'}}
      input.js-location-map-link(type="text" placeholder="https://..." autofocus)
    button.primary.js-detect-location(type="button") {{_ 'location-detect'}}
    if detectMessage
      p.quiet.js-detect-message {{detectMessage}}
    hr
    label
      | {{_ 'location-name'}}
      textarea.js-location-name(rows="2")= location.name
    label
      | {{_ 'location-address'}}
      textarea.js-location-address(rows="2")= location.address
    label
      | {{_ 'location-latitude'}}
      input.js-location-latitude(type="number" step="any" value="{{location.latitude}}")
    label
      | {{_ 'location-longitude'}}
      input.js-location-longitude(type="number" step="any" value="{{location.longitude}}")
    button.primary.confirm.js-submit-location(type="submit") {{_ 'save'}}
    if location._id
      button.negate.wide.right.js-delete-location(type="button") {{_ 'delete'}}
    hr
    //- The same chooser Admin Panel / Problems / Offices opens on a location.
      One list of providers, in client/components/main/mapProvider.jade.
    +mapProviderSelect
    button.primary.js-save-map-provider(type="button") {{_ 'save'}}
    if mapSavedMessage
      p.quiet.js-map-saved {{mapSavedMessage}}

template(name="cardDependenciesPopup")
  .card-dependencies-popup
    label.dependency-field
      span {{_ 'dependency-type'}}
      select.js-new-dependency-type
        each typeOption
          if selected
            option(value="{{id}}" selected="selected") {{_ label}}
          else
            option(value="{{id}}") {{_ label}}
    label.dependency-field
      span {{_ 'dependency-color'}}
      input.js-new-dependency-color(type="color" value="{{defaultColor}}")
    input.js-dependency-search(type="text" placeholder="{{_ 'search'}}" autofocus)
    ul.pop-over-list
      each candidateCards
        li
          a.js-pick-dependency(data-target-id="{{_id}}")
            +viewer
              = title

template(name="cardDependencyIconPopup")
  .card-dependency-icon-popup
    ul.card-dependency-icons
      each dependencyIcons
        li
          a.js-pick-dependency-icon(data-icon="{{name}}" title="{{name}}")
            i.fa(class="fa-{{name}}")

//- #2015: the card's link as a QR code. An img of an SVG the browser drew
  from the link (models/lib/qrCode.js): nothing is sent to a QR service.
template(name="cardQrCodePopup")
  .card-qr-code
    if qrDataUri
      img.card-qr-code-image(src="{{qrDataUri}}" alt="{{_ 'card-qr-code'}}: {{cardUrl}}" width="264" height="264")
      p.quiet {{_ 'card-qr-code-desc'}}
      p.card-qr-code-url {{cardUrl}}
    else
      p.warning {{_ 'card-qr-code-too-long'}}

//- #2012: Story, Task or an ordinary card (models/lib/cardKinds.js).
template(name="cardKindPopup")
  //- The selected kind has a check mark at the end of its line (and
    aria-checked), in its popup and in Card Settings' Scrum settings pane.
  ul.pop-over-list.card-kind-list(role="radiogroup" aria-label="{{_ 'cardKindPopup-title'}}")
    li
      a.js-select-card-kind(data-kind="" role="radio" aria-checked="{{#if cardKind}}false{{else}}true{{/if}}" class="{{#unless cardKind}}is-active{{/unless}}")
        i.fa.fa-square-o
        |  {{_ 'card-kind-none'}}
        unless cardKind
          i.fa.fa-check.card-kind-selected(aria-hidden="true")
    li
      a.js-select-card-kind(data-kind="story" role="radio" aria-checked="{{#if $eq cardKind 'story'}}true{{else}}false{{/if}}" class="{{#if $eq cardKind 'story'}}is-active{{/if}}")
        i.fa.fa-book
        |  {{_ 'card-kind-story'}}
        if $eq cardKind 'story'
          i.fa.fa-check.card-kind-selected(aria-hidden="true")
    li
      a.js-select-card-kind(data-kind="task" role="radio" aria-checked="{{#if $eq cardKind 'task'}}true{{else}}false{{/if}}" class="{{#if $eq cardKind 'task'}}is-active{{/if}}")
        i.fa.fa-check-square-o
        |  {{_ 'card-kind-task'}}
        if $eq cardKind 'task'
          i.fa.fa-check.card-kind-selected(aria-hidden="true")

//- #1178: drawing on a card (models/lib/cardDrawing.js). The card's drawings
  open again for editing; saving keeps the strokes on the card and uploads a
  PNG attachment, and the SVG is downloaded from the strokes.
template(name="cardDrawingPopup")
  //- #6802: a NEW drawing (from Add Card, or Add attachment) opens maximized,
    without the card's earlier drawings, and is saved as an SVG attachment.
  .card-drawing(class="{{#if newFile}}card-drawing--new-file{{/if}}")
    if showDrawingList
      .card-drawing-list
        each drawings
          a.card-drawing-thumb.js-edit-drawing(data-id=_id class="{{#if isEditing}}is-active{{/if}}")
            != thumbSvg
          //- Whiteboard, Show on Card (docs/Features/Cards/Whiteboard.md).
          unless $eq currentBoard.allowsWhiteboardOnCard false
            a.card-drawing-whiteboard.js-open-whiteboard(data-id=_id title="{{_ 'whiteboard-open'}}" aria-label="{{_ 'whiteboard-open'}}")
              i.fa.fa-expand
        a.js-new-drawing
          i.fa.fa-plus
          |  {{_ 'card-drawing-new'}}
    .card-drawing-tools
      //- #6802: the palette, then the custom colors added to it. Clicking a
        color picks it and opens the color wheel and the HTML color code.
      each colors
        a.card-drawing-color.js-drawing-color(data-color=this style="background:{{this}}" class="{{#if isColor this}}is-active{{/if}}" title=this aria-label=this)
      each customColors
        a.card-drawing-color.card-drawing-color--custom.js-drawing-color(data-color=this style="background:{{this}}" class="{{#if isColor this}}is-active{{/if}}" title=this aria-label=this)
      a.card-drawing-add-custom.js-drawing-custom-color(title="{{_ 'card-drawing-custom-color'}}" aria-label="{{_ 'card-drawing-custom-color'}}")
        i.fa.fa-plus
      //- The eyedropper: a color from the screen, or from the drawing where the
        browser cannot pick from the screen.
      a.card-drawing-eyedropper.js-drawing-eyedropper(class="{{#if picking}}is-active{{/if}}" title="{{_ 'card-drawing-eyedropper'}}" aria-label="{{_ 'card-drawing-eyedropper'}}" aria-pressed="{{#if picking}}true{{else}}false{{/if}}")
        i.fa.fa-eyedropper
      each widths
        a.card-drawing-width.js-drawing-width(data-width=this class="{{#if isWidth this}}is-active{{/if}}") {{this}}
      a.js-drawing-undo(title="{{_ 'card-drawing-undo'}}")
        i.fa.fa-undo
      //- #6802: the eraser takes away the lines it touches.
      a.card-drawing-eraser.js-drawing-eraser(class="{{#if erasing}}is-active{{/if}}" title="{{_ 'card-drawing-eraser'}}" aria-label="{{_ 'card-drawing-eraser'}}" aria-pressed="{{#if erasing}}true{{else}}false{{/if}}")
        i.fa.fa-eraser
      a.js-drawing-clear(title="{{_ 'card-drawing-clear'}}")
        i.fa.fa-trash-o
      //- #6802: the lasso selects lines to move, resize, group and stack.
      a.card-drawing-lasso.js-drawing-lasso(class="{{#if lassoOn}}is-active{{/if}}" title="{{_ 'card-drawing-lasso'}}" aria-label="{{_ 'card-drawing-lasso'}}" aria-pressed="{{#if lassoOn}}true{{else}}false{{/if}}")
        i.fa.fa-draw-polygon
      //- The magnifier: the drawing area larger and smaller on the screen.
      a.js-drawing-zoom-out(title="{{_ 'zoom-out'}}" aria-label="{{_ 'zoom-out'}}")
        i.fa.fa-search-minus
      span.card-drawing-zoom.quiet {{zoomPercent}}%
      a.js-drawing-zoom-in(title="{{_ 'zoom-in'}}" aria-label="{{_ 'zoom-in'}}")
        i.fa.fa-search-plus
      //- Save above the drawing, at the end of the tools.
      .card-drawing-actions
        if message
          span.quiet= message
        unless newFile
          a.js-drawing-download-svg {{_ 'card-drawing-download-svg'}}
        button.primary.js-drawing-save(type="button" disabled=saving) {{_ 'save'}}
    if colorEditorOpen
      .card-drawing-color-editor
        canvas.card-drawing-wheel.js-drawing-wheel(width="160" height="160" aria-label="{{_ 'card-drawing-custom-color'}}")
        .card-drawing-color-fields
          label
            | {{_ 'card-drawing-brightness'}}
            input.js-drawing-brightness(type="range" min="0" max="100" value=brightnessPercent)
          label
            | {{_ 'card-drawing-color-code'}}
            input.js-drawing-hex(type="text" value=currentColor maxlength="7" spellcheck="false" dir="ltr")
          span.card-drawing-color-preview(style="background:{{currentColor}}")
          button.js-drawing-add-color(type="button") {{_ 'card-drawing-add-color'}}
          if isCustom currentColor
            button.js-drawing-remove-color(type="button") {{_ 'card-drawing-remove-color'}}
          a.js-drawing-close-colors(title="{{_ 'close'}}" aria-label="{{_ 'close'}}")
            i.fa.fa-times
    if hasSelection
      .card-drawing-selection-tools
        a.js-drawing-group(title="{{_ 'card-drawing-group'}}" aria-label="{{_ 'card-drawing-group'}}")
          i.fa.fa-object-group
          |  {{_ 'card-drawing-group'}}
        if selectionGrouped
          a.js-drawing-ungroup(title="{{_ 'card-drawing-ungroup'}}" aria-label="{{_ 'card-drawing-ungroup'}}")
            i.fa.fa-object-ungroup
            |  {{_ 'card-drawing-ungroup'}}
        a.js-drawing-layer(data-layer="front" title="{{_ 'card-drawing-bring-to-front'}}" aria-label="{{_ 'card-drawing-bring-to-front'}}")
          i.fa.fa-angle-double-up
        a.js-drawing-layer(data-layer="forward" title="{{_ 'card-drawing-bring-forward'}}" aria-label="{{_ 'card-drawing-bring-forward'}}")
          i.fa.fa-angle-up
        a.js-drawing-layer(data-layer="backward" title="{{_ 'card-drawing-send-backward'}}" aria-label="{{_ 'card-drawing-send-backward'}}")
          i.fa.fa-angle-down
        a.js-drawing-layer(data-layer="back" title="{{_ 'card-drawing-send-to-back'}}" aria-label="{{_ 'card-drawing-send-to-back'}}")
          i.fa.fa-angle-double-down
    //- The drawing area takes the room there is; it grows from its corner
      handle, and scrolls when zoomed past the window.
    .card-drawing-stage.js-drawing-stage
      .card-drawing-canvas(style="width:{{canvasWidth}}px;height:{{canvasHeight}}px")
        svg.card-drawing-surface.js-drawing-surface(viewBox="0 0 {{drawingWidth}} {{drawingHeight}}" width=canvasWidth height=canvasHeight preserveAspectRatio="none" class="{{#if erasing}}is-erasing{{/if}} {{#if lassoOn}}is-lasso{{/if}} {{#if picking}}is-picking{{/if}}")
          rect(width=drawingWidth height=drawingHeight fill="#ffffff")
          each strokes
            path(d=pathD stroke=color stroke-width=width fill="none" stroke-linecap="round" stroke-linejoin="round")
          if lassoPath
            path.card-drawing-lasso-loop(d=lassoPath)
          with selectionBox
            rect.card-drawing-selection(x=x y=y width=width height=height)
            rect.card-drawing-resize-handle.js-drawing-resize-handle(x=hx y=hy width=size height=size)
              title {{_ 'card-drawing-resize'}}
        span.card-drawing-canvas-resize.js-drawing-canvas-resize(role="separator" tabindex="0" title="{{_ 'card-drawing-resize-canvas'}}" aria-label="{{_ 'card-drawing-resize-canvas'}}")
