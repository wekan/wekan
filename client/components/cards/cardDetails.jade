template(name="cardFieldSectionScrum")
  +cardSectionHeader(section="scrum" icon="fa-repeat" label="scrum-settings" menuClass="js-section-card-kind" menuTitle="cardKindPopup-title")
  if isSectionOpen "scrum"
    each field in orderedScrumFields
      if $eq field "scrumSprint"
        +scrumMetadata(kind="card" record=this field="Sprint")
      if $eq field "scrumPastSprints"
        +scrumMetadata(kind="card" record=this field="PastSprints")
      if $eq field "scrumRelease"
        +scrumMetadata(kind="card" record=this field="Release")
      if $eq field "scrumIssueType"
        +scrumMetadata(kind="card" record=this field="IssueType")
      if $eq field "scrumAcceptanceCriteria"
        +scrumMetadata(kind="card" record=this field="AcceptanceCriteria")
      if $eq field "scrumBacklogRank"
        +scrumMetadata(kind="card" record=this field="BacklogRank")

template(name="cardFieldSectionDescription")
  .card-details-group.card-details-group-description
      if canModifyCard
        unless currentUser.isWorker
          if currentBoard.allowsDescriptionTitle
            +cardSectionHeader(section="description" icon="fa-file-text-o" label="description")
          if currentBoard.allowsDescriptionText
            if isSectionOpen "description"
              +inlinedCardDescription(classNames="card-description js-card-description")
                +descriptionForm
                .edit-controls.clearfix
                  button.primary(type="submit") {{_ 'save'}}
                  a.js-close-inlined-form
              else
                if currentBoard.allowsDescriptionText
                  a.js-open-inlined-form(title="{{_ 'edit'}}" aria-label="{{_ 'edit'}}" value=title)
                    i.fa.fa-pencil-square-o(aria-hidden="true")
                  a.js-open-inlined-form(title="{{_ 'edit'}}" value=title)
                    if getDescription
                      +viewer
                        = getDescription
                  if (hasUnsavedValue 'cardDescription' _id)
                    p.quiet
                      | {{_ 'unsaved-description'}}
                      a.js-open-inlined-form {{_ 'view-it'}}
                      = ' - '
                      a.js-close-inlined-form {{_ 'discard'}}
      else if getDescription
        if currentBoard.allowsDescriptionTitle
          +cardSectionHeader(section="description" icon="fa-file-text-o" label="description")
        if currentBoard.allowsDescriptionText
          if isSectionOpen "description"
            +viewer
              = getDescription

//- Checklists: the heading (its row "Checklists: Title" can turn it off, and
  then the section is always open), the count of finished items and the
  checklists, in the order of their rows.
template(name="cardFieldSectionChecklists")
  .card-checklist-attachmentGallery.card-checklists
    unless $eq currentBoard.allowsChecklistTitle false
      +cardSectionHeader(section="checklists" icon="fa-check" label="checklists")
    if checklistSectionOpen
      each field in orderedChecklistsFields
        //- Total checklist item count (finished/total) shown above all
          checklists. The board flag is a cheap boolean, so when it is off the
          checklist counting below is never evaluated.
        if $eq field "checklistCount"
          if currentBoard.allowsChecklistCountBadgeOnCard
            if checklists.length
              h4.card-details-item-subtitle
                |  {{checklistFinishedCount}}/{{checklistItemCount}}
        if $eq field "checklists"
          +checklists(cardId = _id card = this)

//- #4693: "Subtasks (1/3)", done/total (subtaskDoneCount in subtasks.js).
template(name="cardFieldSectionSubtasks")
  +cardSectionHeader(section="subtasks" icon="fa-sitemap" label="subtasks" count=subtaskDoneCount menuClass="js-open-subtasks-menu" menuTitle="subtasks")
  if isSectionOpen "subtasks"
    +subtasks(cardId = _id)

//- Attachments: the gallery and - GitHub issue #595 - the text notes, small
  editable markdown blocks of the card, edited in a popup with the
  description's editor. "Attachments (3)" when the board shows the count.
template(name="cardFieldSectionAttachments")
  +cardSectionHeader(section="attachments" icon="fa-paperclip" label="attachments" count=attachmentCount)
  if isSectionOpen "attachments"
    each field in orderedAttachmentsFields
      //- #6796: the upload rules are in the upload popup
        (attachments.jade cardAttachmentsPopup), not above every list.
      if $eq field "attachments"
        if currentBoard.allowsAttachments
          .card-checklist-attachmentGallery.card-attachmentGallery
            +attachmentGallery
      if $eq field "textNotes"
        if currentBoard.allowsTextNotes
          .card-details-item.card-details-item-text-notes
            h3.card-details-item-title
              i.fa.fa-file-text-o
              | {{_ 'text-notes'}}
            +cardTextNotes(_id = _id)

//- #1173-adjacent: ONE header for every collapsible section of a card - the
  rule above it, the caret that collapses it, its icon and its name. Written
  once, so eleven sections cannot end up with ten separators and nine carets.
  The caret points DOWN when the section is open and toward the reading
  direction's end when it is closed (right in English, left in Arabic), which
  is what `sectionCaret` works out.
//- The comments section, in the left column of the opened card or, when it is
  maximized, at the top of the right one.
template(name="cardCommentsSection")
  if currentBoard.allowsComments
    .card-details-comments
      .comment-title
        +cardSectionHeader(section="comments" icon="fa-comment-o" label="comments" count=cardCommentCountShown)
        //- Unread comments, Show on Card: the same marker as a minicard's.
        if currentBoard.allowsUnreadCommentsOnCard
          if cardHasUnreadComments
            span.card-details-unread-comments(title="{{_ 'card-has-unread-comments'}}")
              i.fa.fa-comment
      if isSectionOpen "comments"
        if canComment
          +commentForm
        +comments

//- The Spent time heading's hamburger: Change spent time.
template(name="cardSpentTimeMenu")
  if canModifyCard
    a.card-details-section-menu.js-section-spent-time(title="{{_ 'editCardSpentTimePopup-title'}}" aria-label="{{_ 'editCardSpentTimePopup-title'}}")
      i.fa.fa-navicon

//- The Subtasks heading's hamburger: Filter: Subtasks, and the subtask settings.
template(name="cardSubtasksMenuPopup")
  ul.pop-over-list
    li
      a.js-filter-subtasks
        i.fa.fa-filter
        | {{_ 'filter'}}: {{_ 'subtasks'}}
    li
      a.js-open-subtask-settings
        i.fa.fa-cog
        | {{_ 'subtask-settings'}}

template(name="cardSectionHeader")
  //- `noRule` for a section that must not have a separator above it: the FIRST
    one, which has nothing above it to be separated from, and one that already
    sits under a rule of the layout's own.
  unless noRule
    hr.card-details-section-rule
  h3.card-details-item-title.js-toggle-card-section(data-section="{{section}}" role="button" tabindex="0")
    i.fa(class="{{sectionCaret section}}")
    if icon
      i.fa(class="{{icon}}")
    | {{_ label}}
    //- An optional count after the name - "Attachments (3)" - for a section
      whose size is worth knowing before it is opened.
    if count
      |  ({{count}})
    //- Custom Fields puts its layout selector on the heading row, between the
      title and hamburger. A collapsed section hides actions for content that
      is not visible, so the selector only exists while this section is open.
    if layoutToggle
      if isSectionOpen section
        button.custom-fields-layout-toggle#toggleCustomFieldsGridButton(
          type="button"
          title="{{_ 'change'}} {{_ 'custom-fields'}} {{_ 'layout'}}"
          class="{{#if layoutOnePerRow}}list-active{{else}}grid-active{{/if}}")
          if layoutOnePerRow
            span.list-icon
              i.fa.fa-list
          else
            span.grid-icon
              i.fa.fa-th-large
    //- A section whose settings live somewhere gets a hamburger at the far end
      of its heading, like the card's own and the minicard's. `menuClass` is the
      handler that opens them; the click must not reach the heading, or opening
      the menu would fold the section under it.
    if menuClass
      a.card-details-section-menu(class="{{menuClass}}" title="{{_ menuTitle}}")
        i.fa.fa-navicon

template(name="editCardTitleForm")
  //- The X that closes the editor, where the card's own X is when the title is
    NOT being edited: opening the editor replaces the whole header, so the close
    button used to vanish and leave Save as the only way out. It reuses
    `.close-card-details`, so it is the same size in the same place and does not
    jump as the editor opens and closes - and that class floats to
    `inline-end`, which is the right in English and the left in Arabic without a
    second rule.
  a.close-card-details.js-close-inlined-form(title="{{_ 'close-card'}}")
    i.fa.fa-times-thin
  a(title="{{_ 'copy-text-to-clipboard'}}")
  span.copied-tooltip {{_ 'copied'}}
  textarea.js-edit-card-title(rows='1' autofocus dir="auto")
    = getTitle
  +titleDueHint(selector=".js-edit-card-title" field="allowsDueFromTitleOnCard")
  .edit-controls.clearfix
    button.primary.confirm.js-submit-edit-card-title-form(type="submit") {{_ 'save'}}

template(name="editCardRequesterForm")
