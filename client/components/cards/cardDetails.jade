template(name="cardDetailsActionsPopup")
  if currentUser
    //- What is shown on the thing you are looking at, first. This one menu is
      opened from two places, and the entry differs with the place: from the
      opened CARD it offers "Show on Card", from a MINICARD on the board it
      offers "Show on Minicard". Both open the board's existing Card Settings
      with that one column - it is the same list of settings, reached from
      where the setting is visible instead of from Board Settings four clicks
      away. client/lib/cardMenuSource.js
    if isMinicardMenu
      ul.pop-over-list
        li
          a.js-show-on-minicard
            i.fa.fa-id-card
            |  {{_ 'show-on-minicard'}}
      hr
    else if currentUser.isBoardAdmin
      ul.pop-over-list
        li
          a.js-show-on-card
            i.fa.fa-id-card
            |  {{_ 'show-on-card'}}
      hr
    //- Copy link, first, and named - the card's header carried this as an icon
      with only a tooltip, which is the one place a name cannot be read without
      hovering. It is here now, beside the swimlane's and the list's, so all
      three are copied the same way from the same kind of menu.
      docs/Features/Page/Board-Item-Links.md
    ul.pop-over-list
      li
        a.js-copy-card-link
          i.fa.fa-link
          |  {{_ 'copy-link-to-clipboard'}}
    span.copied-tooltip {{_ 'copied'}}
    hr
    ul.pop-over-list
      li
        a.js-toggle-watch-card
          if isWatching
            i.fa.fa-eye
            |  {{_ 'unwatch'}}
          else
            i.fa.fa-eye
            |  {{_ 'watch'}}
    hr
    //- The board's custom fields, and this card's. The first is Board Settings
      / Custom Fields - the list of fields the board HAS, which is where one is
      created, renamed or deleted; the second picks which of them are on THIS
      card. They are two halves of one subject and were three groups apart, so
      they are one group now, the board's list first because a field has to
      exist before a card can be given it. A board admin's, the same as in
      Board Settings. client/components/sidebar/sidebarCustomFields.jade
    //- "Custom Fields" was here. It is the hamburger at the end of the Custom
      Fields heading of the card itself now - which is where the fields are.
    if canModifyCard
      unless currentUser.isWorker
        ul.pop-over-list
          //li: a.js-members {{_ 'card-edit-members'}}
          //li: a.js-labels {{_ 'card-edit-labels'}}
          //li: a.js-attachments {{_ 'card-edit-attachments'}}
          li
            a.js-start-voting
              i.fa.fa-thumbs-up
              | {{_ 'card-edit-voting'}}
          li
            a.js-start-planning-poker
              i.fa.fa-thumbs-up
              | {{_ 'card-edit-planning-poker'}}
          //li: a.js-received-date {{_ 'editCardReceivedDatePopup-title'}}
          //li: a.js-start-date {{_ 'editCardStartDatePopup-title'}}
          //li: a.js-due-date {{_ 'editCardDueDatePopup-title'}}
          //li: a.js-end-date {{_ 'editCardEndDatePopup-title'}}
          li
            a.js-spent-time
              i.fa.fa-clock-o
              | {{_ 'editCardSpentTimePopup-title'}}
          li
            a.js-set-card-color
              i.fa.fa-paint-brush
              | {{_ 'setCardColorPopup-title'}}
    if canModifyCard
      hr
    else
      unless currentUser.isReadOnly
        unless currentUser.isReadAssignedOnly
          hr
  //- #1173: the same two rows every other menu has - the menu says what it is
    about, so they are "Export" and "Import". Import writes, so it is asked for
    with the same permission question the popup itself asks.
  ul.pop-over-list
    li
      a.js-export-card
        i.fa.fa-upload
        | {{_ 'export'}}
    if canImportIntoBoard
      li
        a.js-import-card
          i.fa.fa-download
          | {{_ 'import'}}
  if currentUser
    unless canModifyCard
      unless currentUser.isReadOnly
        unless currentUser.isReadAssignedOnly
          hr
          ul.pop-over-list
            li
              a.js-move-card-to-top
                i.fa.fa-arrow-up
                | {{_ 'moveCardToTop-title'}}
            li
              a.js-move-card-to-bottom
                i.fa.fa-arrow-down
                | {{_ 'moveCardToBottom-title'}}
          hr
          ul.pop-over-list
            if currentUser.isBoardAdmin
              li
                a.js-move-card
                  i.fa.fa-arrow-right
                  | {{_ 'moveCardPopup-title'}}
            unless currentUser.isWorker
              li
                a.js-copy-card
                  i.fa.fa-clipboard
                  | {{_ 'copyCardPopup-title'}}
          unless currentUser.isWorker
            ul.pop-over-list
              li
                a.js-copy-checklist-cards
                  i.fa.fa-copy
                  | {{_ 'copyManyCardsPopup-title'}}
            unless archived
              hr
              ul.pop-over-list
                li
                  a.js-archive
                    i.fa.fa-archive
                    | {{_ 'archive-card'}}
            hr
            ul.pop-over-list
              li
                a.js-more
                  span.emoji-icon
                  i.fa.fa-link
                  | {{_ 'cardMorePopup-title'}}
    if canModifyCard
      hr
      ul.pop-over-list
        li
          a.js-move-card-to-top
            i.fa.fa-arrow-up
            | {{_ 'moveCardToTop-title'}}
        li
          a.js-move-card-to-bottom
            i.fa.fa-arrow-down
            | {{_ 'moveCardToBottom-title'}}
      hr
      ul.pop-over-list
        if currentUser.isBoardAdmin
          li
            a.js-move-card
              i.fa.fa-arrow-right
              | {{_ 'moveCardPopup-title'}}
        unless currentUser.isWorker
          li
            a.js-copy-card
              i.fa.fa-clipboard
              | {{_ 'copyCardPopup-title'}}
      unless currentUser.isWorker
        ul.pop-over-list
          li
            a.js-copy-checklist-cards
              i.fa.fa-copy
              | {{_ 'copyManyCardsPopup-title'}}
        unless archived
          hr
          ul.pop-over-list
            li
              a.js-archive
                i.fa.fa-archive
                | {{_ 'archive-card'}}
        hr
        ul.pop-over-list
          li
            a.js-more
              span.emoji-icon
                i.fa.fa-link
              | {{_ 'cardMorePopup-title'}}

//- #1173: the card export popup IS the shared export body - the same checkbox
  list and the same four formats every other menu offers, with the card as its
  scope. It used to be its own template with its own field list, which is how
  its checkboxes came to drive the Excel download and not the PDF.
template(name="exportCardPopup")
  +exportScopeBody(cardId=_id listId=listId title=title)

//- WHERE a card goes: the board, the swimlane, the list, which card to put it
  above or below, and Done. Four popups asked that same question and drew this
  same form to ask it - Move card, Copy card, Copy checklist to many cards, and
  Convert a checklist item to a card - differing only in the title field above
  it, which is why that stays with each of them.
//-
//- The JavaScript was already one piece: BoardSwimlaneListCardDialog holds the
  four selects' state and registerCardDialogTemplate wires each popup to it. The
  `dialog` is passed in and read from the template INSTANCE rather than from the
  data context, because inside `each boards` the context is a board - a helper
  that reached for it there would find nothing. The selects' own change handlers
  stay on the popups: an event from here bubbles to the one that includes it,
  which is the one holding the dialog. client/components/cards/cardDetails.js
template(name="cardDestinationPicker")
  unless currentUser.isWorker
    label {{_ 'boards'}}:
    select.js-select-boards(autofocus)
      each boards
        option(value="{{_id}}" selected="{{#if isSelectedBoardId _id}}selected{{/if}}") {{title}}

  label {{_ 'swimlanes'}}:
  select.js-select-swimlanes
    each swimlanes
      option(value="{{_id}}" selected="{{#if isSelectedSwimlaneId _id}}selected{{/if}}") {{isTitleDefault title}}

  label {{_ 'lists'}}:
  select.js-select-lists
    each lists
      option(value="{{_id}}" selected="{{#if isSelectedListId _id}}selected{{/if}}") {{title}}

  label {{_ 'cards'}}:
  select.js-select-cards
    each cards
      option(value="{{_id}}" selected="{{#if isDialogOptionCardId _id}}selected{{/if}}") {{title}}

  div
    input(type="radio" name="position" value="above" checked id="position-above" style="display: inline")
    label(for="position-above") {{_ 'above-selected-card'}}
  div
    input(type="radio" name="position" value="below" id="position-below" style="display: inline")
    label(for="position-below") {{_ 'below-selected-card'}}

  .edit-controls.clearfix
    button.primary.confirm.js-done {{_ 'done'}}

