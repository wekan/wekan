template(name="cardDetailsPopup")
  +cardDetails(popupCard)

template(name="cardDetails")

  //- `card-details-with-handle` when drag handles are on, the same class the
    minicard carries for the same reason: with a handle, the title is all edit
    target; without one, half of it is what the window is dragged by.
    client/components/cards/cardDetails.css
  //- `card-details-position-pending` (unpainted until placed beside its
    minicard) is a reactive class, not a static one: Blaze writes a tag's
    static classes again on every change of its class attribute, so a static
    one came back when the window was maximized and minimized again (or
    collapsed) and left the card open but invisible. cardDetails.js
    positionSettled.
  section.card-details.js-card-details.nodragscroll(
    class='{{#unless positionSettled}}card-details-position-pending{{/unless}}'
    class='{{#if cardMaximized}}card-details-maximized{{/if}}'
    class='{{#if isPopup}}card-details-popup{{/if}}'
    class='{{#unless isVerticalScrollbars}}no-scrollbars{{/unless}}'
    class='{{#if cardCollapsed}}card-details-collapsed{{/if}}'
    class='{{#if isTouchScreenOrShowDesktopDragHandles}}card-details-with-handle{{/if}}'
    role="region" tabindex="0" aria-label="{{_ 'card'}}: {{title}}"): .card-details-canvas
    //- The whole header row is what the window is dragged by - not the heading
      inside it. A heading is only as wide as its own text, so with a short title
      "the right half of the title" was a few pixels, and the empty space beside
      it - which is what anybody would grab - belonged to the row and did nothing.
      The handler steps aside for the buttons (they are links), for the drag
      handle when there is one, and for the half of the title that edits.
      client/components/cards/cardDetails.js
    //- Card color, Show on Card (Board Settings / Card): the header's color.
    .card-details-header.js-card-title-drag-handle(class='{{#if showCardColorOnCard}}{{#if colorClass}}card-details-{{colorClass}}{{/if}}{{/if}}' style='{{#if showCardColorOnCard}}{{colorStyle}}{{/if}}')
      +inlinedForm(classNames="js-card-details-title")
        +editCardTitleForm
      else
        unless isMiniScreen
          if allowsCardCollapse
            a.card-collapse-toggle.js-card-collapse-toggle(title="{{_ 'collapse'}}")
              if cardCollapsed
                i.fa.fa-caret-right
              else
                i.fa.fa-caret-down
          a.close-card-details.js-close-card-details(title="{{_ 'close-card'}}")
            i.fa.fa-times-thin
          if cardMaximized
            a.fa.fa-window-minimize.minimize-card-details.js-minimize-card-details(title="{{_ 'minimize-card'}}")
          else
            a.fa.fa-window-maximize.maximize-card-details.js-maximize-card-details(title="{{_ 'maximize-card'}}")
          a.card-details-menu.js-open-card-details-menu(title="{{_ 'cardDetailsActionsPopup-title'}}")
            i.fa.fa-bars
          //- The handle appears only when drag handles are ON, like the
            minicard's. With them off the window is dragged by its own title bar
            - the trailing half of the title - so a handle would be a second way
            to do what the bar already does; with them on it is the ONLY way, and
            the title is all edit target.
            client/components/cards/minicard.jade
          if canModifyCard
            if isTouchScreenOrShowDesktopDragHandles
              span.card-drag-handle.js-card-drag-handle(title="Drag card")
                i.fa.fa-arrows
        else
          a.close-card-details.js-close-card-details(title="{{_ 'close-card'}}")
            i.fa.fa-times-thin
          a.card-zoom-out.js-card-zoom-out(title="{{_ 'zoom-out'}}")
            i.fa.fa-search-minus
          a.card-zoom-in.js-card-zoom-in(title="{{_ 'zoom-in'}}")
            i.fa.fa-search-plus
          a.card-mobile-desktop-toggle.js-card-mobile-desktop-toggle(title="{{_ 'mobile-desktop-toggle'}}")
            if mobileMode
              i.fa.fa-desktop
            else
              i.fa.fa-mobile
          if cardMaximized
            a.fa.fa-window-minimize.minimize-card-details.js-minimize-card-details(title="{{_ 'minimize-card'}}")
          else
            a.fa.fa-window-maximize.maximize-card-details.js-maximize-card-details(title="{{_ 'maximize-card'}}")
          a.card-details-menu-mobile-web.js-open-card-details-menu(title="{{_ 'cardDetailsActionsPopup-title'}}")
            i.fa.fa-bars
        if canModifyCard
          if currentBoard.allowsDueComplete
            a.card-details-complete-toggle.js-toggle-due-complete(title="{{#if getDueComplete}}{{_ 'card-mark-incomplete'}}{{else}}{{_ 'card-mark-complete'}}{{/if}}")
              .materialCheckBox(class="{{#if getDueComplete}}is-checked{{/if}}")
        //- The title is BOTH: the leading half opens the editor and the
          trailing half drags the window, exactly as a minicard's title splits
          between editing and dragging the card. `js-card-title-drag-handle`
          stays on the whole heading - the drag handler is what steps aside for
          the edit zone - so a reader who may not write can still drag the
          window by any part of it, which is what that class was for.
        if showLabelsAboveTitleOnCard
          .card-details-labels-above-title
            +minicardLabels(show=labelsShownAboveTitle labels=labels hideText=hiddenCardLabelText)
        h2.card-details-title.js-card-title(
          class="{{#if canModifyCard}}is-editable{{/if}}")
            if canModifyCard
              a.card-details-title-edit-zone.js-open-inlined-form(title="{{_ 'edit'}}")
            if currentBoard.allowsCardNumber
              span.card-number
                | #{getCardKey} &nbsp;
            +viewer
              = getTitle
            if isWatching
              i.card-details-watch
                i.fa.fa-eye
            //- Description badge, Show on Card: that the card has a description.
            if currentBoard.allowsDescriptionBadgeOnCard
              if getDescription
                i.fa.fa-file-text-o.card-details-description-badge(title="{{_ 'description'}}")
        //- List title, Show on Card: this card's own choice, like the minicard's.
        if showListOnCard
          if cardListTitle
            .card-details-list-title
              i.fa.fa-list
              | {{ cardListTitle }}
        //- Parent card and Linked card, Show on Card.
        .card-details-path
          unless $eq currentBoard.allowsParentCardOnCard false
            each parentList
              | &nbsp; &gt; &nbsp;
              a.js-parent-card(href=linkForCard) {{title}}
          // else
            {{_ 'card'}}
        if isLinkedCard
          unless $eq currentBoard.allowsLinkedCardOnCard false
            a.linked-card-location.js-go-to-linked-card
              +viewer
                | {{getBoardTitle}} > {{getTitle}}

    if getArchived
      if isLinkedBoard
        p.warning {{_ 'board-archived'}}
      else
        p.warning {{_ 'card-archived'}}

    // Upload progress indicator for drag-and-drop uploads
    if hasActiveUploads
      .card-details-upload-progress
        .upload-progress-header
          i.fa.fa-upload
          span {{_ 'uploading-files'}} ({{uploadCount}})
        each uploads
          .upload-progress-item(class="{{#if $eq status 'error'}}upload-error{{/if}}")
            .upload-progress-filename {{cleanFilename file.name}}
            .upload-progress-bar
              .upload-progress-fill(style="width: {{progress}}%")
            if $eq status 'error'
              .upload-progress-error
                i.fa.fa-exclamation-triangle
                span {{_ 'upload-failed'}}
            else if $eq status 'completed'
              .upload-progress-success
                i.fa.fa-check
                span {{_ 'upload-completed'}}

    //- #6431 follow-up: cover image on the opened card (opt-in, OFF by default).
    if currentBoard.allowsCoverAttachmentOnCard
      if cover
        //- The thumbnail, like the board cover; the viewer shows the original.
        if attachmentPreviewUrl cover
          .card-details-cover
            img.card-details-cover-image(alt="" src="{{attachmentPreviewUrl cover}}?dummyReloadAfterSessionEstablished={{sess}}" width="512" height="180" decoding="async")

    //- Every field the board shows on cards, empty or not
      (docs/Features/Cards/Card-Fields.md). Which ones is Board Settings / Card
      (docs/Features/Cards/Card-Settings.md) - the opened card has no Card
      Settings of its own.
    .card-details-left

      .card-details-items
        //- ONE SECTION MODEL (2026-10-28): the opened card draws Card Settings'
          sections (models/lib/cardSettingsSections.js) in the board's
          `cardSettingsSectionOrder` - the order Card Settings' Card pane shows
          and drags - each headed with that section's icon and title, and each
          section's fields in the order of its rows there (board.cardFieldOrder,
          models/lib/cardFieldOrder.js, through the ordered*Fields helpers). Only
          the sections this card has something to show for are listed
          (cardDetails.js orderedSectionsOf). The title bar above is fixed; the
          comments are the right column's on a maximized card, the activities
          always are. docs/Features/Cards/Card-Fields.md
        //- `each section in ...`, not `each ...`: the plain form makes the
          section NAME the data context, so every section template - and every
          popup opened from one, e.g. the Labels popup - saw a string where it
          expected the card. Clicking a label then silently did nothing
          (`card.toggleLabel` was undefined). The `in` form keeps `this` as the
          card.
        each section in orderedCardFieldSections
          .card-details-section(data-card-section="{{section}}" class="card-details-section-{{section}}")
            if $eq section "labels"
              +cardFieldSectionLabels
            if $eq section "date"
              +cardFieldSectionDate
            if $eq section "members"
              +cardFieldSectionMembers
            if $eq section "card"
              +cardFieldSectionCard
            if $eq section "time"
              +cardFieldSectionTime
            if $eq section "customFields"
              +cardFieldSectionCustomFields
            if $eq section "vote"
              +cardFieldSectionVote
            if $eq section "poker"
              +cardFieldSectionPoker
            if $eq section "description"
              +cardFieldSectionDescription
            if $eq section "scrum"
              +cardFieldSectionScrum
            if $eq section "checklists"
              +cardFieldSectionChecklists
            if $eq section "subtasks"
              +cardFieldSectionSubtasks
            if $eq section "attachments"
              +cardFieldSectionAttachments
            //- The comments: here, or - on a maximized card - at the top of the
              right column (below), where orderedSectionsOf leaves them out.
            if $eq section "comments"
              +cardCommentsSection

    .card-details-right

      //- A maximized card has its comments here, beside the card's fields.
      if cardMaximized
        +cardCommentsSection

      //- #6688: `allowsActivities` existed in the schema (default true) but
        gated nothing; Board Settings / Card now has its row and this is what
        the row hides.
      if currentBoard.allowsActivities
        if currentUser.isBoardAdmin
          //- OUTSIDE .activity-title, which is `display: flex`: a rule inside it
            becomes a flex item and renders as a short line beside the heading
            instead of a separator above it.
            The eye that used to sit here showed and hid exactly what the caret
            shows and hides, so there were two controls for one thing and they
            could disagree. The caret is the one that stayed, and this section is
            the one that starts CLOSED - a card is opened to read the card, not
            its history.
          +cardSectionHeader(section="activities" icon="fa-history" label="activities")

        if currentUser.isBoardAdmin
          if isSectionOpen "activities"
            if isLoaded.get
              if isLinkedCard
                +activities(card=this mode="linkedcard")
              else if isLinkedBoard
                +activities(card=this mode="linkedboard")
              else
                +activities(card=this mode="card")

template(name="cardFieldSectionLabels")
  +cardSectionHeader(section="labels" icon="fa-tag" label="labels")
  if isSectionOpen "labels"
    .card-details-group-body
      //- #6688: Stickers and Location each have their own Board Settings /
        Card toggle (allowsStickers, allowsLocation).
      each field in orderedLabelsFields
        if $eq field "labels"
          if currentBoard.allowsLabels
            .card-details-item.card-details-item-labels
              a(class="{{#if canModifyCard}}js-add-labels{{else}}is-disabled{{/if}}" title="{{_ 'card-labels-title'}}")
                each labels
                  //- Labels text, Show on Card: the words, or coloured chips without them.
                  span.card-label(class="{{labelColorClass color}}" class="{{#if hiddenCardLabelText}}card-label-no-text{{/if}}" style="{{labelColorStyle color}}" title=name)
                    unless hiddenCardLabelText
                      +viewer
                        = name
              if canModifyCard
                unless currentUser.isWorker
                  a.card-label.add-label.js-add-labels(title="{{_ 'card-labels-title'}}")
                    i.fa.fa-plus
        if $eq field "stickers"
          if currentBoard.allowsStickers
            .card-details-item.card-details-item-stickers
              h3.card-details-item-title
                i.fa.fa-sticky-note-o
                | {{_ 'stickers'}}
              .card-details-item-content.card-stickers
                each stickers
                  span.card-sticker(title="{{#if name}}{{name}}{{else}}{{icon}}{{/if}}")
                    i.fa(class="fa-{{icon}} {{#if highlight}}sticker-{{highlight}}{{/if}}")
                    if canModifyCard
                      a.card-sticker-remove.js-remove-sticker(data-index="{{@index}}" title="{{_ 'remove-sticker'}}")
                        i.fa.fa-times
                if canModifyCard
                  unless currentUser.isWorker
                    a.card-label.add-label.js-add-stickers(title="{{_ 'add-sticker'}}")
                      i.fa.fa-plus

        if $eq field "location"
          if currentBoard.allowsLocation
            .card-details-item.card-details-item-location
              h3.card-details-item-title
                i.fa.fa-map-marker
                | {{_ 'location'}}
              .card-details-item-content.card-locations
                each getLocations
                  .card-location
                    .card-location-info(class="{{#if canModifyCard}}js-edit-location{{/if}}" data-location-id="{{_id}}")
                      if name
                        .card-location-name= name
                      if address
                        .card-location-address= address
                      if hasCoordinates
                        a.card-location-map(href=mapUrl target="_blank" rel="noopener noreferrer")
                          i.fa.fa-map-o
                          = ' '
                          | {{_ 'location-open-map'}}
                    if canModifyCard
                      a.card-location-remove.js-remove-location(data-location-id="{{_id}}" title="{{_ 'delete'}}")
                        i.fa.fa-times
              if canModifyCard
                unless currentUser.isWorker
                  a.card-label.add-label.js-add-location(title="{{_ 'add-location'}}")
                    i.fa.fa-plus

template(name="cardFieldSectionDate")
  +cardSectionHeader(section="date" icon="fa-calendar" label="date")
  if isSectionOpen "date"
    .card-details-group-body
      each field in orderedDateFields
        if $eq field "receivedDate"
          if currentBoard.allowsReceivedDate
            .card-details-item.card-details-item-received
              h3.card-details-item-title
                i.fa.fa-sign-out
                | {{_ 'card-received'}}
              if getReceived
                +cardReceivedDate(card=this canModifyCard=canModifyCard)
              else
                if canModifyCard
                  unless currentUser.isWorker
                    a.card-label.add-label.js-received-date(title="{{_ 'card-received'}}")
                      i.fa.fa-plus

        if $eq field "startDate"
          if currentBoard.allowsStartDate
            .card-details-item.card-details-item-start
              h3.card-details-item-title
                i.fa.fa-hourglass-start
                | {{_ 'card-start'}}
              if getStart
                +cardStartDate(card=this canModifyCard=canModifyCard)
              else
                if canModifyCard
                  unless currentUser.isWorker
                    a.card-label.add-label.js-start-date(title="{{_ 'card-start'}}")
                      i.fa.fa-plus

        if $eq field "dueDate"
          if currentBoard.allowsDueDate
            .card-details-item.card-details-item-due
              h3.card-details-item-title
                i.fa.fa-clock-o
                | {{_ 'card-due'}}
              if getDue
                +cardDueDate(card=this canModifyCard=canModifyCard)
              else
                if canModifyCard
                  unless currentUser.isWorker
                    a.card-label.add-label.js-due-date(title="{{_ 'card-due'}}")
                      i.fa.fa-plus
              if dueDateChangeCount
                .card-details-due-date-changes(title="{{_ 'due-date-changes'}}")
                  | {{_ 'due-date-changed-times' dueDateChangeCount}}

        if $eq field "endDate"
          if currentBoard.allowsEndDate
            .card-details-item.card-details-item-end
              h3.card-details-item-title
                i.fa.fa-hourglass-end
                | {{_ 'card-end'}}
              if getEnd
                +cardEndDate(card=this canModifyCard=canModifyCard)
              else
                if canModifyCard
                  unless currentUser.isWorker
                    a.card-label.add-label.js-end-date(title="{{_ 'card-end'}}")
                      i.fa.fa-plus
        //- At risk, Show on Card (docs/Features/Cards/At-Risk.md): every reason
          that applied, the moves back included - under its row, Due.
        if $eq field "atRisk"
          unless $eq currentBoard.allowsAtRiskOnCard false
            with cardAtRisk
              .card-details-at-risk.js-card-at-risk
                i.fa.fa-exclamation-triangle
                |  {{_ 'at-risk'}}: {{text}}
        //- Forecast, Show on Card (docs/Features/Cards/Dates/Forecast.md).
        if $eq field "forecast"
          unless $eq currentBoard.allowsForecastOnCard false
            with cardForecastOf this
              .card-details-item.card-details-forecast.js-card-forecast
                h3.card-details-item-title
                  i.fa.fa-line-chart
                  | {{_ 'forecast'}}
                if enough
                  span.card-details-forecast-text {{_ 'forecast-done' p50=(forecastDate p50) p85=(forecastDate p85)}}
                else
                  span.card-details-forecast-text.quiet {{_ 'forecast-not-enough'}}

template(name="cardFieldSectionMembers")
  +cardSectionHeader(section="members" icon="fa-users" label="members")
  if isSectionOpen "members"
    .card-details-group-body
      each field in orderedMembersFields
        if $eq field "members"
          if currentBoard.allowsMembers
            .card-details-item.card-details-item-members
              each userId in getMembers
                +userAvatar(userId=userId cardId=_id)
                | {{! XXX Hack to hide syntaxic coloration /// }}
              if canModifyCard
                unless currentUser.isWorker
                  a.member.add-member.card-details-item-add-button.js-add-members(title="{{_ 'card-members-title'}}")
                    i.fa.fa-plus
        if $eq field "assignee"
          if currentBoard.allowsAssignee
            .card-details-item.card-details-item-assignees
              h3.card-details-item-title
                i.fa.fa-user
                | {{_ 'assignee'}}
              each userId in getAssignees
                +userAvatar(userId=userId cardId=_id assignee=true)
                | {{! XXX Hack to hide syntaxic coloration /// }}
              if canModifyCard
                a.assignee.add-assignee.card-details-item-add-button.js-add-assignees(title="{{_ 'assignee'}}")
                  i.fa.fa-plus
              if currentUser.isWorker
                unless assigneeSelected
                  a.assignee.add-assignee.card-details-item-add-button.js-add-assignees(title="{{_ 'assignee'}}")
                    i.fa.fa-plus

        if $eq field "creator"
          if currentBoard.allowsCreator
            .card-details-item.card-details-item-creator
              h3.card-details-item-title
                i.fa.fa-user
                | {{_ 'creator'}}

              +userAvatar(userId=userId noRemove=true)
              | {{! XXX Hack to hide syntaxic coloration /// }}


          //.card-details-items
          //if assigneeSelected
          //.card-details-items
        if $eq field "requestedBy"
          if currentBoard.allowsRequestedBy
            .card-details-item.card-details-item-name
              h3.card-details-item-title
                i.fa.fa-shopping-cart
                | {{_ 'requested-by'}}
              if canModifyCard
                unless currentUser.isWorker
                  +inlinedForm(classNames="js-card-details-requester")
                    +editCardRequesterForm
                  else
                    each userId in getRequesters
                      +userAvatar(userId=userId cardId=_id noRemove=true)
                    if getRequestedBy
                      +viewer
                        = getRequestedBy
                    .card-details-person-controls
                      a.member.add-member.card-details-item-add-button.js-select-requester(title="{{_ 'requested-by'}}")
                        i.fa.fa-plus
                      a.js-open-inlined-form(
                        title="{{#if getRequestedBy}}{{_ 'edit'}}{{else}}{{_ 'add'}}{{/if}}"
                        aria-label="{{#if getRequestedBy}}{{_ 'edit'}}{{else}}{{_ 'add'}}{{/if}}")
                        if getRequestedBy
                          i.fa.fa-pencil-square-o(aria-hidden="true")
                        else
                          i.fa.fa-plus(aria-hidden="true")
              else
                each userId in getRequesters
                  +userAvatar(userId=userId noRemove=true)
                if getRequestedBy
                  +viewer
                    = getRequestedBy

        if $eq field "assignedBy"
          if currentBoard.allowsAssignedBy
            .card-details-item.card-details-item-name
              h3.card-details-item-title
                i.fa.fa-user-plus
                | {{_ 'assigned-by'}}
              if canModifyCard
                unless currentUser.isWorker
                  +inlinedForm(classNames="js-card-details-assigner")
                    +editCardAssignerForm
                  else
                    each userId in getAssigners
                      +userAvatar(userId=userId cardId=_id noRemove=true)
                    if getAssignedBy
                      +viewer
                        = getAssignedBy
                    .card-details-person-controls
                      a.member.add-member.card-details-item-add-button.js-select-assigner(title="{{_ 'assigned-by'}}")
                        i.fa.fa-plus
                      a.js-open-inlined-form(
                        title="{{#if getAssignedBy}}{{_ 'edit'}}{{else}}{{_ 'add'}}{{/if}}"
                        aria-label="{{#if getAssignedBy}}{{_ 'edit'}}{{else}}{{_ 'add'}}{{/if}}")
                        if getAssignedBy
                          i.fa.fa-pencil-square-o(aria-hidden="true")
                        else
                          i.fa.fa-plus(aria-hidden="true")
              else
                each userId in getAssigners
                  +userAvatar(userId=userId noRemove=true)
                if getAssignedBy
                  +viewer
                    = getAssignedBy

//- Card: the card's own rows - the dependencies, the sorting number and the
  list (the old Dependencies and Sort groups), the card buttons and the
  similar cards. Its title-bar rows (the number, Collapse, Parent and Linked
  card) are drawn in the title bar, where they always were.
template(name="cardFieldSectionCard")
  +cardSectionHeader(section="card" icon="fa-id-card-o" label="card")
  if isSectionOpen "card"
    .card-details-group-body
      each field in orderedCardFields
        //- #6732: editable by roles that may edit OR move cards (dependencyLayers.js).
        if $eq field "dependencies"
          if currentBoard.allowsDependencies
            .card-details-item.card-details-item-dependencies
              h3.card-details-item-title
                i.fa.fa-link
                | {{_ 'card-dependencies'}}
              .card-details-dependencies-list
                each getDependencyCards
                  .card-dependency(data-target-id="{{card._id}}")
                    i.fa(class="fa-{{icon}}" style="color:{{color}}")
                    a.card-dependency-link(href="{{linkUrl}}")
                      +viewer
                        = card.title
                    if canEditBoardDependencies
                      select.js-dependency-type(data-target-id="{{card._id}}")
                        each typeOption
                          if selected
                            option(value="{{id}}" selected="selected") {{_ label}}
                          else
                            option(value="{{id}}") {{_ label}}
                      input.js-dependency-color(type="color" value="{{color}}" data-target-id="{{card._id}}" title="{{_ 'dependency-color'}}")
                      a.js-dependency-icon(data-target-id="{{card._id}}" title="{{_ 'dependency-icon'}}")
                        i.fa.fa-pencil
                      a.card-dependency-remove.js-remove-dependency(data-target-id="{{card._id}}" title="{{_ 'remove-dependency'}}")
                        i.fa.fa-times
                    else
                      span.card-dependency-type {{_ typeLabel}}
              if canEditBoardDependencies
                a.js-add-dependency(title="{{_ 'add-dependency'}}")
                  i.fa.fa-plus
                  | {{_ 'add-dependency'}}
        if $eq field "cardSortingByNumber"
          if currentBoard.allowsCardSortingByNumber
            .card-details-item.card-details-sort-order
              h3.card-details-item-title
                i.fa.fa-sort-numeric-asc
                | {{_ 'sort'}}
              if canModifyCard
                +inlinedForm(classNames="js-card-details-sort")
                  +editCardSortOrderForm
                else
                  a.js-open-inlined-form
                    +viewer
                      = sort
        if $eq field "showLists"
          if currentBoard.allowsShowLists
            .card-details-item.card-details-show-lists
              h3.card-details-item-title
                i.fa.fa-list
                | {{_ 'list'}}
              if canModifyCard
                details.card-details-list-picker
                  summary
                    each currentSwimlaneListsSorted
                      if isCurrentListId _id
                        +viewer
                          = title
                  div.card-details-list-options(role="listbox" aria-label="{{_ 'list'}}")
                    each currentSwimlaneListsSorted
                      div.js-select-card-details-list-option(role="option" tabindex="0" data-list-id="{{_id}}" aria-selected="{{#if isCurrentListId _id}}true{{else}}false{{/if}}")
                        +viewer
                          = title
              else
                each currentSwimlaneListsSorted
                  if isCurrentListId _id
                    +viewer
                      = title
          //- Swimlane, Show on Card: the swimlane this card is in.
          if currentBoard.allowsSwimlaneNameOnCard
            if cardSwimlaneTitle
              .card-details-item.card-details-swimlane-name
                h3.card-details-item-title
                  i.fa.fa-list-alt
                  | {{_ 'swimlane'}}
                +viewer
                  = cardSwimlaneTitle
        //- Card buttons, Show on Card: the board's rule buttons.
        if $eq field "cardButtons"
          unless $eq currentBoard.allowsCardButtonsOnCard false
            +cardButtons(_id=_id boardId=boardId)
        //- Similar cards, Show on Card: the cards of this board like this one
          (docs/Features/Cards/Similar-Cards.md), asked when the card opens and
          drawn only when there are some.
        if $eq field "similarCards"
          unless $eq currentBoard.allowsSimilarCardsOnCard false
            .card-details-item.card-details-item-similar-cards
              +cardSimilarCardsSection(cardId=_id)

//- Time: Spent time and the two timers (the second half of the old Sort group).
template(name="cardFieldSectionTime")
  +cardSectionHeader(section="time" icon="fa-clock-o" label="time")
  if isSectionOpen "time"
    .card-details-group-body
      each field in orderedTimeFields
        if $eq field "spentTime"
          if currentBoard.allowsSpentTime
            //- Shown when it has hours, or ticked "On this card" - the
              card's own view of the board decides (cardAddFields.js).
            .card-details-item.card-details-item-spent
              if getIsOvertime
                h3.card-details-item-title
                  | {{_ 'overtime-hours'}}
                  +cardSpentTimeMenu
              else
                h3.card-details-item-title
                  | {{_ 'spent-time-hours'}}
                  +cardSpentTimeMenu
              if getSpentTime
                +cardSpentTime

          //- #6688: the two timers each have a Board Settings / Card toggle,
            like Spent time above; before they rendered on every card.
        if $eq field "flowtime"
          if currentBoard.allowsFlowtime
            .card-details-item.card-details-item-flow
              h3.card-details-item-title
                i.fa.fa-bolt
                | {{_ 'flowtime'}}
              +cardFlowtime

        if $eq field "pomodoro"
          if currentBoard.allowsPomodoro
            .card-details-item.card-details-item-pomodoro
              h3.card-details-item-title
                i.fa.fa-clock-o
                | {{_ 'pomodoro'}}
              +cardPomodoro

template(name="cardFieldSectionCustomFields")
    //- The heading is on EVERY card the reader may write to whose board shows
      Custom Fields on cards (docs/Features/Cards/Card-Fields.md), empty or not:
      the hamburger at its end is the single place custom fields live - the
      picker of which fields are on this card, a pencil each, and "Add custom
      field". The FIELDS below still come from `customFieldsWD`.
    if canShowCustomFieldsOnCard
      //- ONE header for the whole group, outside the loop: a card with six
        custom fields is one Custom Fields section, not six sections that
        happen to share a caret and draw six rules. A group like the others,
        so its rule spans the card and its fields share rows inside it.
      .card-details-group.card-details-group-custom-fields
        +cardSectionHeader(section="customFields" icon="fa-list-alt" label="custom-fields"
          menuClass="js-open-custom-fields-settings" menuTitle="custom-fields"
          layoutToggle=true layoutOnePerRow=customFieldsGrid)
        if isSectionOpen "customFields"
          .card-details-group-body(class="{{#if customFieldsGrid}}custom-fields-one-per-row{{else}}custom-fields-grid{{/if}}")
            each customFieldsWD
              .card-details-item.card-details-item-customfield
                +cardCustomField

//- Vote and Planning Poker are a section each, as in Card Settings. Each keeps
  its own heading - the section's icon and title with Edit voting / Edit
  Planning Poker as its hamburger - and its rule. #6688: Board Settings / Card
  can hide either (allowsVote, allowsPoker); both default on.
template(name="cardFieldSectionVote")
  //- A section like the others, with Card Settings' heading: its caret folds
    it, Edit voting is its hamburger (docs/Features/Cards/Card-Fields.md).
  .card-details-group.card-details-group-vote-poker.card-details-group-vote
    if currentBoard.allowsVote
      if canModifyCard
        +cardSectionHeader(section="vote" icon="fa-thumbs-up" label="vote-question" menuClass="js-section-edit-voting" menuTitle="card-edit-voting")
      else
        +cardSectionHeader(section="vote" icon="fa-thumbs-up" label="vote-question")
      if isSectionOpen "vote"
        if getVoteQuestion
          if getVoteEnd
            +voteEndDate
          .vote-result
            if votePublic
              a.card-label.card-label-green.js-show-positive-votes {{ voteCountPositive }}
              a.card-label.card-label-red.js-show-negative-votes {{ voteCountNegative }}
            else
              .card-label.card-label-green {{ voteCountPositive }}
              .card-label.card-label-red {{ voteCountNegative }}
            unless ($and currentBoard.isPublic voteAllowNonBoardMembers )
              .card-label.card-label-gray
                | {{ voteCount }} {{_ 'r-of' }} {{ currentBoard.activeMembers.length }}
          +viewer
            = getVoteQuestion
          if showVotingButtons
            button.card-details-green.js-vote.js-vote-positive(class="{{#if voteState}}voted{{/if}}")
              if voteState
                i.fa.fa-thumbs-up
              | {{_ 'vote-for-it'}}
            button.card-details-red.js-vote.js-vote-negative(class="{{#if $eq voteState false}}voted{{/if}}")
              if $eq voteState false
                i.fa.fa-thumbs-down
              | {{_ 'vote-against'}}

template(name="cardFieldSectionPoker")
  //- A section like the others, with Card Settings' heading: its caret folds
    it, Edit Planning Poker is its hamburger.
  .card-details-group.card-details-group-vote-poker.card-details-group-poker
    if currentBoard.allowsPoker
      if canModifyCard
        +cardSectionHeader(section="poker" icon="fa-check-square" label="poker-question" menuClass="js-section-edit-poker" menuTitle="card-edit-planning-poker")
