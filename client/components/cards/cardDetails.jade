    .card-details-right

      if currentUser.isBoardAdmin
        //- OUTSIDE .activity-title, which is `display: flex`: a rule inside it
          becomes a flex item and renders as a short line beside the heading
          instead of a separator above it.
          The eye that used to sit here showed and hid exactly what the caret
          shows and hides, so there were two controls for one thing and they
          could disagree. The caret is the one that stayed, and this section is
          the one that starts CLOSED - a card is opened to read the card, not
          its history.
        +cardSectionHeader(section="activities" icon="fa-history" label="activities")

      if currentUser.isBoardAdmin
        if isSectionOpen "activities"
          if isLoaded.get
            if isLinkedCard
              +activities(card=this mode="linkedcard")
            else if isLinkedBoard
              +activities(card=this mode="linkedboard")
            else
              +activities(card=this mode="card")

//- #1173-adjacent: ONE header for every collapsible section of a card - the
  rule above it, the caret that collapses it, its icon and its name. Written
  once, so eleven sections cannot end up with ten separators and nine carets.
  The caret points DOWN when the section is open and toward the reading
  direction's end when it is closed (right in English, left in Arabic), which
  is what `sectionCaret` works out.
template(name="cardSectionHeader")
  //- `noRule` for a section that must not have a separator above it: the FIRST
    one, which has nothing above it to be separated from, and one that already
    sits under a rule of the layout's own.
  unless noRule
    hr.card-details-section-rule
  h3.card-details-item-title.js-toggle-card-section(data-section="{{section}}" role="button" tabindex="0")
    i.fa(class="{{sectionCaret section}}")
    if icon
      i.fa(class="{{icon}}")
    | {{_ label}}
    //- An optional count after the name - "Attachments (3)" - for a section
      whose size is worth knowing before it is opened.
    if count
      |  ({{count}})
    //- Custom Fields puts its layout selector on the heading row, between the
      title and hamburger. A collapsed section hides actions for content that
      is not visible, so the selector only exists while this section is open.
    if layoutToggle
      if isSectionOpen section
        button.custom-fields-layout-toggle#toggleCustomFieldsGridButton(
          type="button"
          title="{{_ 'change'}} {{_ 'custom-fields'}} {{_ 'layout'}}"
          class="{{#if layoutOnePerRow}}list-active{{else}}grid-active{{/if}}")
          span.grid-icon(class="{{#unless layoutOnePerRow}}active{{/unless}}")
            i.fa.fa-th-large
          span.list-icon(class="{{#if layoutOnePerRow}}active{{/if}}")
            i.fa.fa-list
    //- A section whose settings live somewhere gets a hamburger at the far end
      of its heading, like the card's own and the minicard's. `menuClass` is the
      handler that opens them; the click must not reach the heading, or opening
      the menu would fold the section under it.
    if menuClass
      a.card-details-section-menu(class="{{menuClass}}" title="{{_ menuTitle}}")
        i.fa.fa-navicon

