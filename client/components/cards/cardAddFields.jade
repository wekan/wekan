//- "+ Add" on the opened card (docs/Features/Cards/Card-Fields.md): which
  fields this card shows. The Admin Panel's own left menu and pane title
  (client/components/settings/leftMenu.jade) inside the Admin Panel's
  .setting-content / .content-body / .main-body, so it looks and works like
  an Admin Panel page: the sections on the left, the open section's fields
  on the right, each with a checkbox - ticked when the card shows it.
  models/lib/cardShownFields.js
template(name="cardAddFieldsPopup")
  .card-add-fields
    .setting-content
      .content-body
        +leftMenu(menuItems)
        .main-body
          +paneTitle(paneTitleData)
          ul.card-add-fields-list
            each rows
              li
                a.flex.card-add-field.js-card-add-field(data-key=key role="checkbox" aria-checked="{{#if shown}}true{{else}}false{{/if}}")
                  .materialCheckBox(class="{{#if shown}}is-checked{{/if}}")
                  span.card-add-field-icons
                    each icons
                      i.fa(class=this aria-hidden="true")
                  span.card-add-field-label {{rowLabel}}
