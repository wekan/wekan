//- One date badge: the coloured date on a card or a minicard. Twelve templates
  drew this, letter for letter - Received, Start, Due and End on the card and
  again on the minicard, a vote's end, a poker's end and a custom field's date -
  and each of them still has its own helpers and its own click, which is the
  part that differs. The markup did not.
//-
//- It takes what it draws as ARGUMENTS: a helper is looked up on the template
  it is written in, not on the one including it, so passing the values is what
  lets one piece of markup serve twelve templates without moving any of their
  state.
//-
//- `baseClass` is the class the caller's own markup carried - `card-date`, plus
  `due-date` and friends on a minicard. A custom field's date passes NONE: it
  was never a `.card-date` and must not become one now.
//- `canModifyCard` decides whether the badge is a link that opens the date
  editor; a custom field's date is never one, and passes nothing.
template(name="dateBadgeBody")
  if canModifyCard
    a.js-edit-date(title="{{showTitle}} {{_ 'predicate-week'}} {{#if showWeekOfYear}}{{showWeek}}{{/if}}" class="{{baseClass}} {{classes}}")
      time(datetime="{{showISODate}}")
        | {{showDate}}
        if showWeekOfYear
          b
            | {{showWeek}}
  else
    a(title="{{showTitle}} {{_ 'predicate-week'}} {{#if showWeekOfYear}}{{showWeek}}{{/if}}" class="{{baseClass}} {{classes}}")
      time(datetime="{{showISODate}}")
        | {{showDate}}
        if showWeekOfYear
          b
            | {{showWeek}}

template(name="dateBadge")
  +dateBadgeBody(canModifyCard=canModifyCard baseClass="card-date" showTitle=showTitle classes=classes showISODate=showISODate showDate=showDate showWeekOfYear=showWeekOfYear showWeek=showWeek)

template(name="cardReceivedDate")
