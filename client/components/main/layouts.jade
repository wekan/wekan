template(name="main")
  html(lang="{{htmlLang}}" dir="{{htmlDir}}")
    head
      title
      meta(name="viewport" content="width=device-width, initial-scale=1, maximum-scale=5, user-scalable=yes, viewport-fit=cover")
      meta(http-equiv="X-UA-Compatible" content="IE=edge")
      meta(name="apple-mobile-web-app-capable" content="yes")
      meta(name="apple-mobile-web-app-status-bar-style" content="black-translucent")
      //- XXX We should use pathFor in the following `href` to support the case
        where the application is deployed with a path prefix, but it seems to be
        difficult to do that cleanly with Blaze -- at least without adding extra
        packages.
      link(rel="shortcut icon" type="image/x-icon" href="/favicon.ico")
      link(rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png")
      link(rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png")
      link(rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png")
      link(rel="manifest" crossOrigin="use-credentials" href="/site.webmanifest")
      link(rel="icon" type="image/svg+xml" href="/jalor-mark.svg")
      link(rel="mask-icon" href="/jalor-pinned-tab.svg" color="#000091")
      meta(name="apple-mobile-web-app-title" content="Jalor")
      meta(name="application-name" content="Jalor")
      //- Bleu France (#000091), the DSFR's primary. It is what a browser paints
        its address bar and a phone its task switcher with, so it is the first
        piece of Jalor identity anybody sees, before the page has loaded.
      meta(name="msapplication-TileColor" content="#000091")
      meta(name="theme-color" content="#000091")
      //link(rel="stylesheet" type="text/css" class="__meteor-css__" href="css/html5-default-theme.css")

template(name="userFormsLayout")
  +recoveryMaintenance
  section.auth-layout
    if currentSetting.hideLogo
      h1.at-form-landing-logo
        br
        br
    unless currentSetting.hideLogo
      h1.at-form-landing-logo
      if currentSetting.customLoginLogoImageUrl
        if currentSetting.customLoginLogoLinkUrl
          a(href="{{currentSetting.customLoginLogoLinkUrl}}")
            img(src="{{currentSetting.customLoginLogoImageUrl}}" alt="{{currentSetting.productName}}" width="300" height="auto")
          br
        unless currentSetting.customLoginLogoLinkUrl
          img(src="{{currentSetting.customLoginLogoImageUrl}}" alt="{{currentSetting.productName}}" width="300" height="auto")
          br
      else
        //- The Jalor masthead, when the instance has not been given a logo of
          its own. The mark, the product name as the page's ONE h1, and the
          tagline under it - which is what the sign-in page of a public service
          is expected to say before it asks for anything.
          The mark is `alt=""` and `aria-hidden`: it is decoration beside the
          name, and a screen reader reading "Jalor" twice is worse than not
          describing it at all (RGAA 1.2).
        .jalor-auth-brand
          img.jalor-auth-logo(src="{{pathFor '/jalor-mark.svg'}}" alt="" aria-hidden="true" width="88" height="88")
          h1.jalor-auth-name {{productName}}
          p.jalor-auth-tagline {{_ 'jalor-tagline'}}
  if currentSetting.textBelowCustomLoginLogo
    hr
    section.textBelowCustomLoginLogo
      +viewer
        | {{currentSetting.textBelowCustomLoginLogo}}
    hr
  section.auth-layout
    section.auth-dialog
      if isLoading
        +loader
      else
        // ARIA live region for error messages
        //- The live region the sign-in code writes failures into. The colour
          and the spacing used to be an inline `style`, which is the one place
          a stylesheet cannot reach: the DSFR error treatment in
          client/jalor/jalor-auth.css draws it now - a red leading rule, a
          tinted ground and red text - and it only draws when the region has
          something in it, so an empty alert is not an empty red box.
        div#login-error-message(role="alert" aria-live="assertive")
        +Template.dynamic(template=content)
        if currentSetting.displayAuthenticationMethod
          +connectionMethod(authenticationMethod=currentSetting.defaultAuthenticationMethod)
        if isLegalNoticeLinkExist
          div#legalNoticeDiv
            span#legalNoticeSpan {{_ 'acceptance_of_our_legalNotice'}}
            a#legalNoticeAtLink.at-link(href="{{currentSetting.legalNotice}}", target="_blank", rel="noopener noreferrer")
              | {{_ 'legalNotice'}}
          if getLegalNoticeWithWritTraduction
            div
        div.at-form-lang
          label(for="userform-set-language-select") {{_ 'changeLanguagePopup-title'}}
          select.select-lang.js-userform-set-language#userform-set-language-select(aria-label="{{_ 'changeLanguagePopup-title'}}")
            each languages
              if isCurrentLanguage
                if rtl
                  option(value="{{tag}}" selected="selected") {{name}} (RTL)
                else
                  option(value="{{tag}}" selected="selected") {{name}}
              else
                if rtl
                  option(value="{{tag}}") {{name}} (RTL)
                else
                  option(value="{{tag}}") {{name}}
    //- Extra space below the login / register dialog so its bottom scrolls
    //- fully into view and scrolling continues a little past the form.
    //- A real element, not <br>: body is display:flex, so a <br> becomes a
    //- flex item, gets blockified and collapses to zero height - which is why
    //- the two <br> that used to be here added no space at all.
    .auth-bottom-space

template(name="defaultLayout")
  +recoveryMaintenance
  //- Shared migration / board-repair progress dashboard. Mounted app-wide so it
  //- shows for both a board-open repair AND an Admin Panel database migration.
  +migrationProgress
  a.skip-link(href="#content") {{_ 'skip-to-content'}}
  +header
  #content(role="main" tabindex="-1")
    | {{{afterBodyStart}}}
    +Template.dynamic(template=content)
    | {{{beforeBodyEnd}}}
    //- The right sidebar of a page that has no sidebar of its own. It draws
      nothing on a board or on All Boards, which have theirs, and nothing on a
      page with no controls to put in one. docs/Features/Page/Header.md
    +pageSidebar
  +boardConversionProgress
  if (Modal.isOpen)
    #modal(role="dialog" aria-modal="true" aria-label="{{_ 'modal-title'}}")
      .overlay
      if (Modal.isWide)
        .modal-content-wide.modal-container
          a.modal-close-btn.js-close-modal(aria-label="{{_ 'close-dialog'}}")
            i.fa.fa-times-thin(aria-hidden="true")
          +Template.dynamic(template=Modal.getHeaderName)
          +Template.dynamic(template=Modal.getTemplateName)
      else
        .modal-content.modal-container
          a.modal-close-btn.js-close-modal(aria-label="{{_ 'close-dialog'}}")
            i.fa.fa-times-thin(aria-hidden="true")
          +Template.dynamic(template=Modal.getHeaderName)
          +Template.dynamic(template=Modal.getTemplateName)

template(name="notFound")
  +message(label='page-not-found')

//- "Not found", "this board is private", and every other page that has one
  thing to say. A real DSFR callout - `fr-callout` with its title and text -
  rather than WeKan's `.big-message`, which was a centred grey paragraph with
  no shape of its own. The class it replaced was used here and nowhere else,
  so its rules went from layouts.css with it.
template(name="message")
  .jalor-page
    .fr-callout(class=color)
      h1.fr-callout__title {{_ label}}
      unless currentUser
        p.fr-callout__text {{{_ 'page-maybe-private' '/sign-in'}}}

template(name="loader")
  h1.loadingText {{_ 'loading'}}
  .lds-roller
    div
    div
    div
    div
    div
    div
    div
