template(name="uiComponentLibrary")
  .wrapper
    h1 Legacy HTML4 component library
    p
      | These controls share their meaning with the server-rendered HTML4 view.
      |  Modern browsers receive icon decoration; HTML4 uses printable ASCII.
    table
      thead
        tr
          th Component
          th HTML5 control
          th Meaning
      tbody
        tr
          th(scope="row") Expanded section
          td
            button(type="button" aria-label="Collapse section")
              i(class="{{uiIconClass 'caret-down'}}" aria-hidden="true")
              |  Section
          td Collapse an expanded section
        tr
          th(scope="row") Collapsed section
          td
            button(type="button" aria-label="Expand section")
              i(class="{{uiIconClass 'caret-right'}}" aria-hidden="true")
              |  Section
          td Expand a collapsed section
        tr
          th(scope="row") Add
          td
            button.primary(type="button")
              i(class="{{uiIconClass 'add'}}" aria-hidden="true")
              |  Add
          td Add an item
        tr
          th(scope="row") Menu
          td
            button(type="button")
              i(class="{{uiIconClass 'menu'}}" aria-hidden="true")
              |  Menu
          td Open actions
