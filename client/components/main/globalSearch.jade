template(name="globalSearchControls")
  //- The controls of this page. They were a group in its second header bar,
    beside a title the first bar now carries; they are a view of the shared
    page sidebar. models/lib/pageSidebar.js, docs/Design/Page/Header.md
  a.board-header-btn.js-global-search-view-change(title="{{_ 'globalSearchViewChange-title'}}")
    i.fa.fa-caret-down
    if $eq globalSearchView 'me'
      i.fa.fa-user
      | {{_ 'globalSearchViewChange-choice-me'}}
    if $eq globalSearchView 'all'
      i.fa.fa-users
      | {{_ 'globalSearchViewChange-choice-all'}}

template(name="globalSearchViewChangePopup")
  if currentUser
    ul.pop-over-list
      li
        a.js-global-search-view-me
          i.fa.fa-user
          | {{_ 'globalSearchViewChange-choice-me'}}
          if $eq Utils.globalSearchView "me"
            i.fa.fa-check
      hr
      li
        a.js-global-search-view-all
          i.fa.fa-users
          | {{_ 'globalSearchViewChange-choice-all'}}
          span.sub-name
            +viewer
              | {{_ 'globalSearchViewChange-choice-all-description' }}
          if $eq Utils.globalSearchView "all"
            i.fa.fa-check

template(name="globalSearchModalTitle")
  if currentUser
    h2
      i.fa.fa-keyboard-o
      | {{_ 'globalSearch-title'}}

template(name="resultsPaged")
  if resultsHeading
    h1= resultsHeading
  each card in results
    +resultCard(card)
  table.global-search-footer
    tr
      td.global-search-previous-page
        if hasPreviousPage
          button.js-previous-page
            | {{_ 'previous-page' }}
      td.global-search-next-page(align="right")
        if hasNextPage
          button.js-next-page
            | {{_ 'next-page' }}

template(name="globalSearch")
  if currentUser
    //- `global-search-wrapper` gives this page a scoped hook so its CSS can undo
      the `height: 100vh; overflow: hidden` that the All Boards stylesheet pins on
      the GLOBAL `.wrapper` at phone widths - that clip is what hid this page's
      lower content. With the clip gone the page's existing scroller (#content)
      scrolls it, natively on touch, so no per-element dragscroll is needed.
    .wrapper.global-search-wrapper(class=boardColorClass)
      form.global-search-page.js-search-query-form(role="search" onsubmit="return false;")
        label.sr-only(for="global-search-input") {{_ 'globalSearch-title'}}
        input.global-search-query-input(
          style="display: inline-block;"
          id="global-search-input"
          type="text"
          name="searchQuery"
          placeholder="{{_ 'search-example'}}"
          value="{{ queryValue }}"
          aria-label="{{_ 'globalSearch-title'}}"
          autofocus dir="auto"
        )
        button.primary.js-new-search(type="submit" aria-label="{{_ 'trello-clear-job'}}")
          | {{_ 'trello-clear-job'}}
      .saved-searches-panel
        form.js-save-search
          label(for="saved-search-name") {{_ 'saved-search-name'}}
          input.js-saved-search-name(
            id="saved-search-name"
            type="text"
            maxlength="80"
            required
            placeholder="{{_ 'saved-search-name-placeholder'}}")
          button.primary(type="submit")
            i.fa.fa-bookmark
            | {{_ 'saved-search-save'}}
        if hasSavedSearches
          ul.saved-search-list
            each saved in savedSearches
              li
                button.js-run-saved-search(type="button" data-query=saved.query)
                  strong= saved.name
                  small= saved.query
                button.js-remove-saved-search(
                  type="button"
                  data-saved-search-id=saved._id
                  title="{{_ 'delete'}}")
                  i.fa.fa-times
        if savedSearchStatus
          p.saved-search-status(role="status")= savedSearchStatus
      if searching
        +spinner
      else if hasResults
        .global-search-results-list-wrapper.global-search-results-list
          if hasQueryErrors
            ul
              each msg in errorMessages
                li.global-search-error-messages
                  = msg
          +resultsPaged getSearchData
      else if serverError
        .global-search-page
          .global-search-help
            h1 {{_ 'server-error' }}
            +viewer
              | {{_ 'server-error-troubleshooting' }}
      else
        .global-search-page
          .global-search-help
            h2 {{_ 'boards' }}
            .lists-wrapper
              each title in myBoardNames
                span.card-label.list-title.js-board-title
                  = title
            h2 {{_ 'lists' }}
            .lists-wrapper
              each title in myLists
                span.card-label.list-title.js-list-title
                  = title
            h2 {{_ 'label-colors' }}
            .palette-colors: each label in labelColors
              span.card-label.palette-color.js-label-color(class="card-label-{{label.color}}")
                = label.name
            if myLabelNames
              h2 {{_ 'label-names' }}
              .lists-wrapper
                each name in myLabelNames
                  span.card-label.list-title.js-label-name
                    = name
          .global-search-instructions
            +viewer
              = searchInstructions
