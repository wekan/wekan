//- The "Open map links at" chooser, in ONE place.
//-
//- Two things need it and they are not near each other: a card's location popup,
//- where a location is entered, and Admin Panel / Problems / Offices, where a
//- location arrived in a CDN header and is only being looked at. Both offer the
//- same eleven providers in the same three regions, and both save to the same
//- `profile.mapProvider`, so a second copy of this list would be eleven options
//- to add a provider to instead of one - and the two would disagree the first
//- time only one was edited.
//-
//- The chooser is the SELECT alone. Saving is left to whoever included it,
//- because the two differ there: the card's popup saves it with the location it
//- is editing, and the Admin Panel one saves it on its own.
template(name="mapProviderSelect")
  .map-provider-row
    span.map-provider-label {{_ 'location-open-map-at'}}
    select.js-map-provider
      optgroup(label="{{_ 'map-region-usa'}}")
        option(value="google" selected="{{#if isMapProvider 'google'}}selected{{/if}}") Google Maps
        option(value="bing" selected="{{#if isMapProvider 'bing'}}selected{{/if}}") Bing Maps
        option(value="apple" selected="{{#if isMapProvider 'apple'}}selected{{/if}}") Apple Maps
        option(value="waze" selected="{{#if isMapProvider 'waze'}}selected{{/if}}") Waze
      optgroup(label="{{_ 'map-region-europe'}}")
        option(value="openstreetmap" selected="{{#if isMapProvider 'openstreetmap'}}selected{{/if}}") OpenStreetMap
        option(value="here" selected="{{#if isMapProvider 'here'}}selected{{/if}}") HERE WeGo
        option(value="yandex" selected="{{#if isMapProvider 'yandex'}}selected{{/if}}") Yandex Maps
        option(value="mapy" selected="{{#if isMapProvider 'mapy'}}selected{{/if}}") Mapy.cz
        option(value="2gis" selected="{{#if isMapProvider '2gis'}}selected{{/if}}") 2GIS
      optgroup(label="{{_ 'map-region-asia'}}")
        option(value="baidu" selected="{{#if isMapProvider 'baidu'}}selected{{/if}}") Baidu Maps
        option(value="amap" selected="{{#if isMapProvider 'amap'}}selected{{/if}}") Amap (Gaode)
