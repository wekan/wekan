//- #2026 / #1377: what happened on all my boards, newest first
  (server/activityFeed.js).
template(name="activityFeed")
  .wrapper.activity-feed
    h2
      i.fa.fa-history
      | {{_ 'activity-feed-title'}}
    ul.activity-feed-list
      each entries
        li.activity-feed-entry
          span.activity-feed-time= timeText
          strong.activity-feed-user= username
          | 
          //- What it names can be Markdown - a card title with a link or an
            emoji - and renders as such (inlineViewer), with the Admin Panel's
            settings. A rendered link cannot sit inside a link, so the card
            opens from a span.
          +inlineViewer
            = description
          if cardId
            | 
            span.activity-feed-card.js-activity-feed-card(role="link" tabindex="0" data-url=cardUrl)
              +inlineViewer
                = cardTitle
          span.quiet
            |  · 
            +inlineViewer
              = boardTitle
      else
        li.quiet {{_ 'activity-feed-empty'}}
    if hasMore
      button.js-activity-feed-more(type="button") {{_ 'activity-feed-more'}}
