template(name="myCardsControls")
  //- The controls of this page. They were a group in its second header bar,
    beside a title the first bar now carries; they are a view of the shared
    page sidebar. models/lib/pageSidebar.js, docs/Design/Page/Header.md
  a.board-header-btn.js-my-cards-view-change(title="{{_ 'myCardsViewChange-title'}}")
    i.fa.fa-caret-down
    if $eq myCardsView 'boards'
      i.fa.fa-list
      | {{_ 'myCardsViewChange-choice-boards'}}
    if $eq myCardsView 'table'
      i.fa.fa-bar-chart
      | {{_ 'myCardsViewChange-choice-table'}}

template(name="myCardsModalTitle")
  if currentUser
    h2
      i.fa.fa-briefcase
      | {{_ 'my-work'}}

template(name="myCards")
  if currentUser
    if searching.get
      +spinner
    else
      section.wrapper.my-work-page(aria-labelledby="my-work-title")
        .my-work-heading
          h2#my-work-title
            i.fa.fa-briefcase
            | {{_ 'my-work'}}
          p {{_ 'my-work-description'}}
        nav.my-work-filters(aria-label="{{_ 'my-work-filters'}}")
          each filter in myWorkFilters
            button.js-my-work-filter(
              type="button"
              data-filter=filter.key
              class="{{#if filter.active}}is-active{{/if}}"
              aria-pressed="{{#if filter.active}}true{{else}}false{{/if}}")
              | {{_ filter.labelKey}}
              span.my-work-filter-count= filter.count
        if hasMyWorkEntries
          .my-work-entry-list
            each entry in myWorkEntries
              article.my-work-entry(class=entry.dueClass)
                .my-work-entry-main
                  span.my-work-entry-type {{_ entry.typeLabelKey}}
                  a.my-work-entry-title(href=entry.url)= entry.title
                  if entry.parentTitle
                    p.my-work-entry-parent
                      i.fa.fa-list-ul
                      = entry.parentTitle
                  p.my-work-entry-location
                    i.fa.fa-columns
                    | #{entry.boardTitle} · #{entry.listTitle}
                .my-work-entry-dates
                  if entry.dueLabel
                    span.my-work-entry-due
                      i.fa.fa-clock-o
                      | {{_ 'my-work-due'}}: #{entry.dueLabel}
                  if entry.reminderLabel
                    span.my-work-entry-reminder
                      i.fa.fa-bell
                      | {{_ 'my-work-reminder'}}: #{entry.reminderLabel}
        else
          .my-work-empty
            i.fa.fa-check-circle
            h3 {{_ 'my-work-empty-title'}}
            p {{_ 'my-work-empty-description'}}

      h3.my-work-board-groups-title {{_ 'my-work-board-groups'}}
      if $eq myCardsView 'boards'
        .wrapper
          each board in myCardsList
            .my-cards-board-wrapper
              .my-cards-board-title(class=board.colorClass)
                a(href=board.originRelativeUrl)
                  +viewer
                    = board.title
              each swimlane in board.mySwimlanes
                .my-cards-swimlane-title(class="{{#if swimlane.colorClass}}{{ swimlane.colorClass }}{{else}}swimlane-default-color{{/if}}")
                  +viewer
                    = swimlane.title
                each list in swimlane.myLists
                  .my-cards-list-wrapper
                    .my-cards-list-title(class=list.colorClass)
                      +viewer
                        = list.title
                    each card in list.myCards
                      .my-cards-card-wrapper
                        a.minicard-wrapper(href=card.originRelativeUrl)
                          +minicard(card)
      if $eq myCardsView 'table'
        .wrapper
          table.my-cards-board-table
            caption.sr-only {{_ 'my-cards'}}
            thead
              tr
                th(scope="col") {{_ "Card"}}
                th(scope="col") {{_ "List"}}
                th(scope="col") {{_ "Board"}}
                th(scope="col") {{_ "Swimlane"}}
                unless isMiniScreen
                  th(scope="col") {{_ "Members"}}
                  th(scope="col") {{_ "Labels"}}
                  th(scope="col") {{_ "Due Date"}}
            tbody
                each board in myCardsList
                    each swimlane in board.mySwimlanes
                      each list in swimlane.myLists
                        each card in list.myCards
                            tr
                              td
                                unless isMiniScreen
                                  .my-cards-board-badge(class=board.colorClass)
                                .my-cards-card-title-table
                                  | {{card.title}}
                                  //a.minicard-wrapper(href=card.originRelativeUrl)
                                  //
                                    | {{card.title}}
                              td
                                | {{list.title}}
                              td
                                | {{board.title}}
                                //a(href=board.originRelativeUrl)
                              td
                                | {{swimlane.title}}

                              unless isMiniScreen
                                td
                                  .div
                                    each member in card.members
                                      a.name
                                        +userAvatar(userId=member noRemove=true)
                                td
                                  .div
                                    each label in card.labelIds
                                      span.card-label(class="{{labelColorClass (labelColor board label)}}" style="{{labelColorStyle (labelColor board label)}}" title=name)
                                        | {{labelName board label}}
                                td
                                  if card.dueAt
                                    | {{ displayDate card.dueAt 'LLL' }}

template(name="myCardsViewChangePopup")
  if currentUser
    ul.pop-over-list
      li
        with "myCardsViewChange-choice-boards"
          a.js-my-cards-view-boards
            i.fa.fa-list
            | {{_ 'myCardsViewChange-choice-boards'}}
            if $eq Utils.myCardsView "boards"
              i.fa.fa-check
      hr
      li
        with "myCardsViewChange-choice-table"
          a.js-my-cards-view-table
            i.fa.fa-bar-chart
            | {{_ 'myCardsViewChange-choice-table'}}
            if $eq Utils.myCardsView "table"
              i.fa.fa-check
