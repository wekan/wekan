template(name="support")
  //- Same shape as the accessibility page: one block of administrator-written
    text, in a DSFR callout. The three branches below are WeKan's own visibility
    rules (public page / signed in / neither) and are unchanged.
  .support-page.jalor-page
    .fr-callout
      if isSupportPublic
        if isSupportEnabled
          .fr-callout__text
            +viewer
              | {{supportContent}}
        else
          p.fr-callout__text {{_ 'support-info-not-added-yet'}}
      else
        if currentUser
          if isSupportEnabled
            .fr-callout__text
              +viewer
                | {{supportContent}}
          else
            p.fr-callout__text {{_ 'support-info-not-added-yet'}}
        else
          p.fr-callout__text {{_ 'support-info-only-for-logged-in-users'}}
