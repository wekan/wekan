template(name="passwordChangeRequired")
  //- PASSWORD_MIN_LENGTH (server/passwordChangeRequired.js): an account whose
  //- password is shorter than the minimum signed in, and sees only this until
  //- it has a longer one. The form is the same Change Password Member
  //- Settings opens; changing it signs every session out, this one too.
  .password-change-required(role="dialog" aria-modal="true" aria-labelledby="password-change-required-title")
    .password-change-required-box
      h2#password-change-required-title {{_ 'password-change-required-title'}}
      p {{_ 'password-change-required-text' min=min}}
      +atForm(state='changePwd')
      .buttonsContainer
        button.js-password-change-required-logout(type="button") {{_ 'log-out'}}
