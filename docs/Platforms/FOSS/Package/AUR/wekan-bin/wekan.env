# WeKan settings. Every setting is listed, with comments, in
# https://github.com/wekan/wekan/blob/main/docker-compose.yml
# Restart after editing: systemctl restart wekan

# The address users open WeKan at. WeKan builds its links from it and its
# live updates connect to it, so it must match the address in the browser.
ROOT_URL=http://localhost:8080
PORT=8080

# Database, attachments and avatars: /var/lib/wekan/files/{db,attachments,avatars}
WRITABLE_PATH=/var/lib/wekan

#MAIL_URL=smtp://user:password@mailserver.example.com:25/
#MAIL_FROM=WeKan <wekan@example.com>
