+  const staticFile = path.join(dir, 'app.js');
+  fs.writeFileSync(staticFile, 'console.log("static-client-file");');
+
+  // Allocate an ephemeral port for Bun.serve (avoid port 3000 collision!)
+  // We find an unused port first
