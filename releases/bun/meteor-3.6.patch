+      if (isWebSocketPath(url.pathname)) {
+        return srv.upgrade(req) ? undefined : new Response('WS upgrade failed', { status: 400 });
+      }
+    }
+
+    const url = new URL(req.url);
+    const staticInfo = getStaticFile(url.pathname);
