--- /dev/null
+++ b/tools/tests/apps/esm-bun-smoke/packages/scoped-npm-dep/server.js
@@ -0,0 +1,4 @@
+import leftPad from 'left-pad';
+
+// Evaluated at package load: a broken npm resolution fails the boot, not just the method.
+export const scopedNpmDep = { padded: leftPad('7', 3, '0') };
diff --git a/tools/tests/apps/esm-bun-smoke/server/main.js b/tools/tests/apps/esm-bun-smoke/server/main.js
