#!/bin/bash

exec >> $SNAP_DATA/hook.log 2>&1
echo "$(date '+%Y-%m-%d %H:%M:%S') $0: Entering hook"

set -x

# read wekan config
. $SNAP/bin/config

# settings were altered by user, safest way to get them applied is to restart service
# first check if caddy service is enabled
value=$(snapctl get caddy-enabled)
if [ "$value" = "true" ]; then
    # update caddy file
    bind_port=$(snapctl get caddy-bind-port)
    port=$(snapctl get port)
    [ "x" != "x${bind_port}" ] && sed -i 's|proxy / localhost:.* {|proxy / localhost:'"${bind_port}"' {|g' $SNAP_COMMON/Caddyfile
    [ "x" != "x$port" ] && sed -i 's|http://:.*|http://:'"${port}"'|g' $SNAP_COMMON/Caddyfile
    snapctl start --enable ${SNAP_NAME}.caddy 2>&1 || true
    snapctl restart ${SNAP_NAME}.caddy 2>&1 || true
else
    snapctl stop --disable ${SNAP_NAME}.caddy 2>&1 || true
fi

# Which database service runs. There is no `database` setting to read any more:
# WeKan runs on FerretDB, MongoDB is here to be READ while a migration is owed,
# and bin/database-role answers which of those is true from the data on disk.
# Only one runs at a time; both bind the same port, so WeKan's MONGO_URL is
# unchanged either way.
#
# An old install may still have `database` set from before it was removed. Say
# that it is ignored rather than silently doing something else - somebody who set
# it to mongodb meant it, and deserves to know their site is migrating.
legacy_database=$(snapctl get database 2>/dev/null || true)
if [ -n "$legacy_database" ]; then
    echo "The 'database' setting has been removed (it was '$legacy_database'). WeKan runs on"
    echo "FerretDB, and everything in MongoDB - text data, and CollectionFS and Meteor-Files"
    echo "attachments - is migrated to it automatically. Nothing to do."
    snapctl unset database 2>&1 || true
fi
disable_mongodb=$(snapctl get disable-mongodb)
if [ "$(bash $SNAP/bin/database-role)" = "ferretdb" ]; then
    snapctl stop --disable ${SNAP_NAME}.mongodb 2>&1 || true
    snapctl start --enable ${SNAP_NAME}.ferretdb 2>&1 || true
    snapctl restart ${SNAP_NAME}.ferretdb 2>&1 || true
else
    # A migration is still owed: mongod holds the data and the port until it is
    # done. disable-mongodb is for an EXTERNAL database, where there is nothing
    # of ours to migrate, so it still wins.
    snapctl stop --disable ${SNAP_NAME}.ferretdb 2>&1 || true
    if [ "$disable_mongodb" = "true" ]; then
        snapctl stop --disable ${SNAP_NAME}.mongodb 2>&1 || true
    else
        snapctl start --enable ${SNAP_NAME}.mongodb 2>&1 || true
        snapctl restart ${SNAP_NAME}.mongodb 2>&1 || true
    fi
fi

# restart all services
snapctl restart ${SNAP_NAME}.wekan 2>&1 || true
